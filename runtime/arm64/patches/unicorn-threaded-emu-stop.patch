+    uc->x64_boundary_ec_bitmap_word_count = ec_bitmap_word_count;
+    uc->x64_boundary_highest_user_address = highest_user_address;
+    uc->x64_boundary_page_shift = page_shift;
+    uc->x64_boundary_suspend_doorbell = suspend_doorbell;
+    uc->x64_boundary_pause_requested = pause_requested;
+    uc->x64_boundary_stop_reason = UC_X64_BOUNDARY_STOP_NONE;
+    uc->x64_boundary_stop_address = 0;
