+
+UNICORN_EXPORT
+uc_err uc_update_x64_boundary_suspend_doorbell(
+    uc_engine *uc, const volatile uint32_t *suspend_doorbell)
+{
+    bool jit_state_saved;
+    uc_err err;
+
+    if ((err = init_state_neutral_api(uc, &jit_state_saved)) != UC_ERR_OK)
+        return err;
+    if (uc->arch != UC_ARCH_X86 || uc->mode != UC_MODE_64 ||
+        uc->nested_level || !uc->x64_boundary_suspend_doorbell ||
+        !suspend_doorbell ||
+        ((uintptr_t)suspend_doorbell & (sizeof(*suspend_doorbell) - 1))) {
+        finish_state_neutral_api(uc, jit_state_saved);
+        return UC_ERR_ARG;
+    }
+    /* Enabled TBs load this host-owned slot through AREG0, so changing one
+     * non-NULL doorbell for another does not require translation invalidation. */
+    uc->x64_boundary_suspend_doorbell = suspend_doorbell;
+    uc->set_x64_boundary_suspend_doorbell(uc, suspend_doorbell);
+    finish_state_neutral_api(uc, jit_state_saved);
+    return UC_ERR_OK;
+}
+
+UNICORN_EXPORT
+uc_err uc_query_x64_boundary_stop(uc_engine *uc,
+                                  uc_x64_boundary_stop_reason *reason,
+                                  uint64_t *address)
+{
+    bool jit_state_saved;
+    uc_err err;
+
+    if (!reason || !address) return UC_ERR_ARG;
+    if ((err = init_state_neutral_api(uc, &jit_state_saved)) != UC_ERR_OK)
+        return err;
+    if (uc->arch != UC_ARCH_X86 || uc->mode != UC_MODE_64 ||
+        uc->nested_level) {
+        finish_state_neutral_api(uc, jit_state_saved);
+        return UC_ERR_ARG;
+    }
+    *reason = uc->x64_boundary_stop_reason;
+    *address = uc->x64_boundary_stop_address;
+    finish_state_neutral_api(uc, jit_state_saved);
+    return UC_ERR_OK;
+}
+
+UNICORN_EXPORT
+uc_err uc_configure_identity_memory_fastpath(uc_engine *uc,
+                                             uint8_t *page_flags,
+                                             uint32_t address_bits)
+{
+    if (!uc || !page_flags || address_bits <= UC_SWITCHYARD_IDENTITY_PAGE_SHIFT ||
+        address_bits >= 64) {
+        return UC_ERR_ARG;
+    }
+    /* This is deliberately a pre-initialization contract.  TCG reserves and
+     * initializes one callee-saved host register while building its prologue;
+     * enabling the mode afterward would leave existing code with no table
+     * base and would make pointer replacement race translated execution. */
+    if (uc->init_done || uc->identity_memory_page_flags) {
+        return UC_ERR_RESOURCE;
+    }
+    uc->identity_memory_page_flags = page_flags;
+    uc->identity_memory_address_bits = address_bits;
+    return UC_ERR_OK;
+}
+
+UNICORN_EXPORT
+uc_err uc_enable_shared_memory_atomics(uc_engine *uc)
+{
+    UC_INIT(uc);
+    register_shared_atomic_engine(uc);
+    atomic_set(&parallel_cpus, true);
+    restore_jit_state(uc);
+    return UC_ERR_OK;
+}
+
+UNICORN_EXPORT
+uc_err uc_set_shared_memory_atomic_callback(
+    uc_engine *uc, uc_cb_shared_memory_atomic_t callback, void *user_data)
+{
+    UC_INIT(uc);
+    if (atomic_read(&uc->shared_memory_atomics)) {
+        restore_jit_state(uc);
+        return UC_ERR_RESOURCE;
+    }
+    if (!callback && user_data) {
+        restore_jit_state(uc);
+        return UC_ERR_ARG;
+    }
+    uc->shared_memory_atomic_callback = callback;
+    uc->shared_memory_atomic_user_data = user_data;
+    restore_jit_state(uc);
+    return UC_ERR_OK;
 }
 
