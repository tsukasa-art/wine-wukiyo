diff --git a/tests/regress/shared_memory_atomics.c b/tests/regress/shared_memory_atomics.c
new file mode 100644
index 0000000000000000000000000000000000000000..9b5e82c616e62c74779db4f30757fd834dccc39c
--- /dev/null
+++ b/tests/regress/shared_memory_atomics.c
@@ -0,0 +1,572 @@
+/* Test x86 guest atomic instructions shared by independent Unicorn engines. */
+
+#define _POSIX_C_SOURCE 200809L
+
+#include <pthread.h>
+#include <signal.h>
+#include <stdint.h>
+#include <stdio.h>
+#include <stdlib.h>
+#include <string.h>
+#include <unistd.h>
+
+#include <unicorn/unicorn.h>
+#include <unicorn/x86.h>
+
+#ifndef UC_SWITCHYARD_SHARED_MEMORY_ATOMICS
+#error UC_SWITCHYARD_SHARED_MEMORY_ATOMICS is required
+#endif
+#ifndef UC_SWITCHYARD_SHARED_MEMORY_ATOMIC_TRACE
+#error UC_SWITCHYARD_SHARED_MEMORY_ATOMIC_TRACE is required
+#endif
+
+#define CODE_ADDRESS 0x10000u
+#define DATA_ADDRESS 0x20000u
+#define PAGE_SIZE 0x1000u
+#define ITERATIONS 100
+#define ZF (1u << 6)
+
+struct barrier
+{
+    pthread_mutex_t mutex;
+    pthread_cond_t cond;
+    unsigned int starters;
+    unsigned int readers;
+};
+
+struct worker
+{
+    uc_engine *uc;
+    struct barrier *barrier;
+    uc_hook read_hook;
+    uc_err result;
+    uint32_t eax;
+    uint32_t eflags;
+};
+
+struct xchg_worker
+{
+    uc_engine *uc;
+    struct barrier *barrier;
+    uc_err result;
+    uint16_t value;
+    uint16_t previous;
+    unsigned int atomic_exit_count;
+    unsigned int atomic_reentry_count;
+    int atomic_phase_open;
+    int atomic_order_error;
+};
+
+static uc_err enable_shared_memory_atomics(uc_engine *uc)
+{
+#ifdef SWITCHYARD_SHARED_ATOMICS_NEGATIVE_CONTROL
+    (void)uc;
+    return UC_ERR_OK;
+#else
+    return uc_enable_shared_memory_atomics(uc);
+#endif
+}
+
+static void shared_memory_atomic_trace(
+    uc_engine *uc, uc_shared_memory_atomic_phase phase, void *user_data)
+{
+    struct xchg_worker *worker = user_data;
+
+    (void)uc;
+    if (phase == UC_SHARED_MEMORY_ATOMIC_EXIT)
+    {
+        if (worker->atomic_phase_open) worker->atomic_order_error = 1;
+        worker->atomic_phase_open = 1;
+        ++worker->atomic_exit_count;
+    }
+    else if (phase == UC_SHARED_MEMORY_ATOMIC_REENTRY)
+    {
+        if (!worker->atomic_phase_open) worker->atomic_order_error = 1;
+        worker->atomic_phase_open = 0;
+        ++worker->atomic_reentry_count;
+    }
+    else worker->atomic_order_error = 1;
+}
+
+static int test_atomic_trace_registration(void)
+{
+#ifdef SWITCHYARD_SHARED_ATOMICS_NEGATIVE_CONTROL
+    return 0;
+#else
+    struct xchg_worker worker = {0};
+    uc_engine *uc = NULL;
+    uc_err err;
+    int ret = 1;
+
+    if ((err = uc_open(UC_ARCH_X86, UC_MODE_64, &uc)))
+    {
+        fprintf(stderr, "atomic trace contract open failed: %s\n",
+                uc_strerror(err));
+        return 1;
+    }
+    if (uc_set_shared_memory_atomic_callback(uc, NULL, &worker) != UC_ERR_ARG)
+    {
+        fprintf(stderr, "atomic trace accepted user data without callback\n");
+        goto done;
+    }
+    if ((err = uc_set_shared_memory_atomic_callback(
+             uc, shared_memory_atomic_trace, &worker)) ||
+        (err = uc_set_shared_memory_atomic_callback(uc, NULL, NULL)) ||
+        (err = uc_set_shared_memory_atomic_callback(
+             uc, shared_memory_atomic_trace, &worker)) ||
+        (err = uc_enable_shared_memory_atomics(uc)))
+    {
+        fprintf(stderr, "atomic trace registration failed: %s\n",
+                uc_strerror(err));
+        goto done;
+    }
+    if (uc_set_shared_memory_atomic_callback(uc, NULL, NULL) != UC_ERR_RESOURCE)
+    {
+        fprintf(stderr, "atomic trace changed after atomics were enabled\n");
+        goto done;
+    }
+    ret = 0;
+
+done:
+    uc_close(uc);
+    return ret;
+#endif
+}
+
+static void read_after_hook(uc_engine *uc, uc_mem_type type, uint64_t address,
+                            int size, int64_t value, void *user_data)
+{
+    struct barrier *barrier = user_data;
+
+    (void)uc;
+    (void)type;
+    (void)address;
+    (void)size;
+    (void)value;
+
+    /* In a non-parallel translation this forces both engines to complete the
+     * ordinary load before either can store.  Parallel atomic helpers may
+     * bypass valid-memory hooks; either behavior must still produce one
+     * successful compare-exchange. */
+    pthread_mutex_lock(&barrier->mutex);
+    ++barrier->readers;
+    pthread_cond_broadcast(&barrier->cond);
+    while (barrier->readers < 2)
+        pthread_cond_wait(&barrier->cond, &barrier->mutex);
+    pthread_mutex_unlock(&barrier->mutex);
+}
+
+static void *run_worker(void *opaque)
+{
+    struct worker *worker = opaque;
+
+    pthread_mutex_lock(&worker->barrier->mutex);
+    ++worker->barrier->starters;
+    pthread_cond_broadcast(&worker->barrier->cond);
+    while (worker->barrier->starters < 2)
+        pthread_cond_wait(&worker->barrier->cond, &worker->barrier->mutex);
+    pthread_mutex_unlock(&worker->barrier->mutex);
+
+    worker->result = uc_emu_start(worker->uc, CODE_ADDRESS,
+                                  CODE_ADDRESS + 16, 0, 0);
+    if (!worker->result)
+        worker->result = uc_reg_read(worker->uc, UC_X86_REG_EAX,
+                                     &worker->eax);
+    if (!worker->result)
+        worker->result = uc_reg_read(worker->uc, UC_X86_REG_EFLAGS,
+                                     &worker->eflags);
+    return NULL;
+}
+
+static int setup_worker(struct worker *worker, struct barrier *barrier,
+                        uint32_t *shared)
+{
+    static const unsigned char code[] =
+    {
+        0xb9, 0x00, 0x00, 0x02, 0x00,       /* mov $DATA_ADDRESS,%ecx */
+        0x31, 0xc0,                         /* xor %eax,%eax */
+        0xba, 0x01, 0x00, 0x00, 0x00,       /* mov $1,%edx */
+        0xf0, 0x0f, 0xb1, 0x11,             /* lock cmpxchg %edx,(%ecx) */
+    };
+    uc_err err;
+
+    memset(worker, 0, sizeof(*worker));
+    worker->barrier = barrier;
+    if ((err = uc_open(UC_ARCH_X86, UC_MODE_32, &worker->uc)) ||
+        (err = enable_shared_memory_atomics(worker->uc)) ||
+        (err = uc_mem_map(worker->uc, CODE_ADDRESS, PAGE_SIZE, UC_PROT_ALL)) ||
+        (err = uc_mem_write(worker->uc, CODE_ADDRESS, code, sizeof(code))) ||
+        (err = uc_mem_map_ptr(worker->uc, DATA_ADDRESS, PAGE_SIZE,
+                              UC_PROT_ALL, shared)) ||
+        (err = uc_hook_add(worker->uc, &worker->read_hook,
+                           UC_HOOK_MEM_READ_AFTER, read_after_hook, barrier,
+                           DATA_ADDRESS, DATA_ADDRESS + sizeof(*shared) - 1)))
+    {
+        fprintf(stderr, "worker setup failed: %s\n", uc_strerror(err));
+        return 1;
+    }
+    return 0;
+}
+
+static int test_cross_engine_cmpxchg(uint32_t *shared)
+{
+    struct barrier barrier;
+    struct worker workers[2];
+    pthread_t threads[2];
+    unsigned int i, iteration;
+    int err;
+    int ret = 1;
+
+    memset(&barrier, 0, sizeof(barrier));
+    if ((err = pthread_mutex_init(&barrier.mutex, NULL)))
+    {
+        fprintf(stderr, "barrier mutex initialization failed: %d\n", err);
+        return 1;
+    }
+    if ((err = pthread_cond_init(&barrier.cond, NULL)))
+    {
+        fprintf(stderr, "barrier condition initialization failed: %d\n", err);
+        pthread_mutex_destroy(&barrier.mutex);
+        return 1;
+    }
+    memset(workers, 0, sizeof(workers));
+    if (setup_worker(&workers[0], &barrier, shared) ||
+        setup_worker(&workers[1], &barrier, shared))
+        goto done;
+
+    for (iteration = 0; iteration < ITERATIONS; ++iteration)
+    {
+        unsigned int created = 0;
+        unsigned int successes = 0;
+
+        *shared = 0;
+        barrier.starters = 0;
+        barrier.readers = 0;
+        memset(&threads, 0, sizeof(threads));
+        for (i = 0; i < 2; ++i)
+        {
+            workers[i].result = UC_ERR_OK;
+            workers[i].eax = UINT32_MAX;
+            workers[i].eflags = 0;
+            if ((err = pthread_create(&threads[i], NULL, run_worker,
+                                      &workers[i])))
+            {
+                fprintf(stderr, "pthread_create failed at iteration %u: %d\n",
+                        iteration, err);
+                pthread_mutex_lock(&barrier.mutex);
+                barrier.starters = 2;
+                pthread_cond_broadcast(&barrier.cond);
+                pthread_mutex_unlock(&barrier.mutex);
+                while (created) pthread_join(threads[--created], NULL);
+                goto done;
+            }
+            ++created;
+        }
+        for (i = 0; i < 2; ++i) pthread_join(threads[i], NULL);
+        for (i = 0; i < 2; ++i)
+        {
+            if (workers[i].result)
+            {
+                fprintf(stderr, "worker %u failed at iteration %u: %s\n", i,
+                        iteration, uc_strerror(workers[i].result));
+                goto done;
+            }
+            if (workers[i].eflags & ZF)
+            {
+                ++successes;
+                if (workers[i].eax != 0)
+                {
+                    fprintf(stderr, "winner EAX is %#x at iteration %u\n",
+                            workers[i].eax, iteration);
+                    goto done;
+                }
+            }
+            else if (workers[i].eax != 1)
+            {
+                fprintf(stderr, "loser EAX is %#x at iteration %u\n",
+                        workers[i].eax, iteration);
+                goto done;
+            }
+        }
+        if (*shared != 1 || successes != 1)
+        {
+            fprintf(stderr, "cross-engine LOCK violation at iteration %u: "
+                    "memory %#x, successes %u, read hooks %u\n", iteration,
+                    *shared, successes, barrier.readers);
+            goto done;
+        }
+    }
+    ret = 0;
+
+done:
+    for (i = 0; i < 2; ++i)
+        if (workers[i].uc) uc_close(workers[i].uc);
+    pthread_cond_destroy(&barrier.cond);
+    pthread_mutex_destroy(&barrier.mutex);
+    return ret;
+}
+
+static void *run_xchg_worker(void *opaque)
+{
+    struct xchg_worker *worker = opaque;
+    uint64_t rax;
+
+    pthread_mutex_lock(&worker->barrier->mutex);
+    ++worker->barrier->starters;
+    pthread_cond_broadcast(&worker->barrier->cond);
+    while (worker->barrier->starters < 2)
+        pthread_cond_wait(&worker->barrier->cond, &worker->barrier->mutex);
+    pthread_mutex_unlock(&worker->barrier->mutex);
+
+    worker->result = uc_emu_start(worker->uc, CODE_ADDRESS,
+                                  CODE_ADDRESS + 13, 0, 0);
+    if (!worker->result)
+        worker->result = uc_reg_read(worker->uc, UC_X86_REG_RAX, &rax);
+    if (!worker->result) worker->previous = (uint16_t)rax;
+    return NULL;
+}
+
+static int setup_xchg_worker(struct xchg_worker *worker,
+                             struct barrier *barrier, void *shared,
+                             uint16_t value)
+{
+    static const unsigned char code[] =
+    {
+        0xbf, 0x01, 0x00, 0x02, 0x00,       /* mov $DATA_ADDRESS+1,%edi */
+        0xb8, 0x00, 0x00, 0x00, 0x00,       /* mov value,%eax */
+        0x66, 0x87, 0x07,                   /* xchg %ax,(%rdi) */
+    };
+    unsigned char worker_code[sizeof(code)];
+    uc_err err;
+
+    memset(worker, 0, sizeof(*worker));
+    worker->barrier = barrier;
+    worker->value = value;
+    memcpy(worker_code, code, sizeof(worker_code));
+    memcpy(worker_code + 6, &value, sizeof(value));
+    if ((err = uc_open(UC_ARCH_X86, UC_MODE_64, &worker->uc)) ||
+        (err = uc_set_shared_memory_atomic_callback(
+            worker->uc, shared_memory_atomic_trace, worker)) ||
+        (err = enable_shared_memory_atomics(worker->uc)) ||
+        (err = uc_mem_map(worker->uc, CODE_ADDRESS, PAGE_SIZE, UC_PROT_ALL)) ||
+        (err = uc_mem_write(worker->uc, CODE_ADDRESS, worker_code,
+                            sizeof(worker_code))) ||
+        (err = uc_mem_map_ptr(worker->uc, DATA_ADDRESS, PAGE_SIZE,
+                              UC_PROT_ALL, shared)))
+    {
+        fprintf(stderr, "XCHGW worker setup failed: %s\n", uc_strerror(err));
+        return 1;
+    }
+    return 0;
+}
+
+static int test_cross_engine_unaligned_xchgw(void *shared)
+{
+    static const uint16_t initial = 0x100;
+    struct barrier barrier;
+    struct xchg_worker workers[2];
+    pthread_t threads[2];
+    uint16_t final;
+    unsigned int i, iteration;
+    int err;
+    int ret = 1;
+
+    memset(&barrier, 0, sizeof(barrier));
+    memset(workers, 0, sizeof(workers));
+    if ((err = pthread_mutex_init(&barrier.mutex, NULL)))
+    {
+        fprintf(stderr, "XCHGW barrier mutex initialization failed: %d\n",
+                err);
+        return 1;
+    }
+    if ((err = pthread_cond_init(&barrier.cond, NULL)))
+    {
+        fprintf(stderr, "XCHGW barrier condition initialization failed: "
+                "%d\n", err);
+        pthread_mutex_destroy(&barrier.mutex);
+        return 1;
+    }
+    if (setup_xchg_worker(&workers[0], &barrier, shared, 0x201) ||
+        setup_xchg_worker(&workers[1], &barrier, shared, 0x302))
+        goto done;
+
+    for (iteration = 0; iteration < ITERATIONS; ++iteration)
+    {
+        unsigned int created = 0;
+
+        memcpy((unsigned char *)shared + 1, &initial, sizeof(initial));
+        barrier.starters = 0;
+        memset(&threads, 0, sizeof(threads));
+        for (i = 0; i < 2; ++i)
+        {
+            workers[i].result = UC_ERR_OK;
+            workers[i].previous = 0;
+            if ((err = pthread_create(&threads[i], NULL, run_xchg_worker,
+                                      &workers[i])))
+            {
+                fprintf(stderr, "XCHGW pthread_create failed at iteration "
+                        "%u: %d\n", iteration, err);
+                pthread_mutex_lock(&barrier.mutex);
+                barrier.starters = 2;
+                pthread_cond_broadcast(&barrier.cond);
+                pthread_mutex_unlock(&barrier.mutex);
+                while (created) pthread_join(threads[--created], NULL);
+                goto done;
+            }
+            ++created;
+        }
+        for (i = 0; i < 2; ++i) pthread_join(threads[i], NULL);
+        for (i = 0; i < 2; ++i)
+        {
+            if (!workers[i].result) continue;
+            fprintf(stderr, "XCHGW worker %u failed at iteration %u: %s\n",
+                    i, iteration, uc_strerror(workers[i].result));
+            goto done;
+        }
+        memcpy(&final, (unsigned char *)shared + 1, sizeof(final));
+        if (!((final == workers[0].value &&
+               workers[0].previous == workers[1].value &&
+               workers[1].previous == initial) ||
+              (final == workers[1].value &&
+               workers[1].previous == workers[0].value &&
+               workers[0].previous == initial)))
+        {
+            fprintf(stderr, "unaligned XCHGW was not serialized at iteration "
+                    "%u: final %#x, previous %#x/%#x\n", iteration, final,
+                    workers[0].previous, workers[1].previous);
+            goto done;
+        }
+    }
+#ifndef SWITCHYARD_SHARED_ATOMICS_NEGATIVE_CONTROL
+    for (i = 0; i < 2; ++i)
+    {
+        if (workers[i].atomic_order_error || workers[i].atomic_phase_open ||
+            !workers[i].atomic_exit_count ||
+            workers[i].atomic_exit_count != workers[i].atomic_reentry_count)
+        {
+            fprintf(stderr, "serial atomic trace mismatch for worker %u: "
+                    "exit %u reentry %u open %d order %d\n", i,
+                    workers[i].atomic_exit_count,
+                    workers[i].atomic_reentry_count,
+                    workers[i].atomic_phase_open,
+                    workers[i].atomic_order_error);
+            goto done;
+        }
+    }
+#endif
+    ret = 0;
+
+done:
+    for (i = 0; i < 2; ++i)
+        if (workers[i].uc) uc_close(workers[i].uc);
+    pthread_cond_destroy(&barrier.cond);
+    pthread_mutex_destroy(&barrier.mutex);
+    return ret;
+}
+
+static int run_cmpxchg8b_case(uc_engine *uc, uint64_t *shared,
+                              uint64_t initial, uint64_t expected,
+                              uint64_t replacement, int should_succeed)
+{
+    static const unsigned char code[] =
+    {
+        0xbe, 0x00, 0x00, 0x02, 0x00,       /* mov $DATA_ADDRESS,%esi */
+        0xf0, 0x0f, 0xc7, 0x0e,             /* lock cmpxchg8b (%esi) */
+    };
+    uint32_t eax = (uint32_t)expected;
+    uint32_t edx = (uint32_t)(expected >> 32);
+    uint32_t ebx = (uint32_t)replacement;
+    uint32_t ecx = (uint32_t)(replacement >> 32);
+    uint32_t eflags = 2;
+    uc_err err;
+
+    *shared = initial;
+    if ((err = uc_mem_write(uc, CODE_ADDRESS, code, sizeof(code))) ||
+        (err = uc_reg_write(uc, UC_X86_REG_EAX, &eax)) ||
+        (err = uc_reg_write(uc, UC_X86_REG_EDX, &edx)) ||
+        (err = uc_reg_write(uc, UC_X86_REG_EBX, &ebx)) ||
+        (err = uc_reg_write(uc, UC_X86_REG_ECX, &ecx)) ||
+        (err = uc_reg_write(uc, UC_X86_REG_EFLAGS, &eflags)) ||
+        (err = uc_emu_start(uc, CODE_ADDRESS,
+                            CODE_ADDRESS + sizeof(code), 0, 0)) ||
+        (err = uc_reg_read(uc, UC_X86_REG_EAX, &eax)) ||
+        (err = uc_reg_read(uc, UC_X86_REG_EDX, &edx)) ||
+        (err = uc_reg_read(uc, UC_X86_REG_EFLAGS, &eflags)))
+    {
+        fprintf(stderr, "CMPXCHG8B execution failed: %s\n", uc_strerror(err));
+        return 1;
+    }
+
+    if (should_succeed)
+    {
+        if (!(eflags & ZF) || *shared != replacement)
+        {
+            fprintf(stderr, "CMPXCHG8B success mismatch: flags %#x, memory "
+                    "%#llx\n", eflags, (unsigned long long)*shared);
+            return 1;
+        }
+    }
+    else if ((eflags & ZF) || *shared != initial ||
+             eax != (uint32_t)initial || edx != (uint32_t)(initial >> 32))
+    {
+        fprintf(stderr, "CMPXCHG8B failure mismatch: EAX %#x, EDX %#x, "
+                "flags %#x, memory %#llx\n", eax, edx, eflags,
+                (unsigned long long)*shared);
+        return 1;
+    }
+    return 0;
+}
+
+static int test_cmpxchg8b(uint64_t *shared)
+{
+    uc_engine *uc = NULL;
+    uc_err err;
+    int ret = 1;
+
+    if ((err = uc_open(UC_ARCH_X86, UC_MODE_32, &uc)) ||
+        (err = enable_shared_memory_atomics(uc)) ||
+        (err = uc_mem_map(uc, CODE_ADDRESS, PAGE_SIZE, UC_PROT_ALL)) ||
+        (err = uc_mem_map_ptr(uc, DATA_ADDRESS, PAGE_SIZE,
+                              UC_PROT_ALL, shared)))
+    {
+        fprintf(stderr, "CMPXCHG8B setup failed: %s\n", uc_strerror(err));
+        goto done;
+    }
+    if (run_cmpxchg8b_case(uc, shared, UINT64_C(0x1122334455667788),
+                           UINT64_C(0x1122334455667788),
+                           UINT64_C(0x0123456789abcdef), 1) ||
+        run_cmpxchg8b_case(uc, shared, UINT64_C(0xfedcba9876543210),
+                           UINT64_C(0x1122334455667788),
+                           UINT64_C(0x0123456789abcdef), 0))
+        goto done;
+    ret = 0;
+
+done:
+    if (uc) uc_close(uc);
+    return ret;
+}
+
+int main(void)
+{
+    void *shared = NULL;
+    int ret = 1;
+
+    alarm(20);
+    if (posix_memalign(&shared, PAGE_SIZE, PAGE_SIZE))
+    {
+        fprintf(stderr, "shared allocation failed\n");
+        return 2;
+    }
+    memset(shared, 0, PAGE_SIZE);
+    if (test_atomic_trace_registration() ||
+        test_cross_engine_cmpxchg(shared) ||
+        test_cross_engine_unaligned_xchgw(shared) || test_cmpxchg8b(shared))
+        goto done;
+    puts("shared-memory LOCK, unaligned XCHGW, and CMPXCHG8B atomics passed");
+    ret = 0;
+
+done:
+    free(shared);
+    alarm(0);
+    return ret;
+}
diff --git a/tests/regress/switchyard_state_neutral_jit_state.c b/tests/regress/switchyard_state_neutral_jit_state.c
new file mode 100644
index 0000000000000000000000000000000000000000..57ba00ef7f83ea0be9353fef64d794a152f80ca2
--- /dev/null
+++ b/tests/regress/switchyard_state_neutral_jit_state.c
@@ -0,0 +1,224 @@
+/* Verify Switchyard state-only APIs preserve the Apple JIT permission owned by
+ * their calling thread, including lazy initialization and validation errors. */
+
+#define _DARWIN_C_SOURCE
+
+#include <inttypes.h>
+#include <pthread.h>
+#include <stdbool.h>
+#include <stdint.h>
+#include <stdio.h>
+#include <string.h>
+
+#include <unicorn/unicorn.h>
+
+#define CODE_ADDRESS 0x10000u
+#define PAGE_SIZE    0x1000u
+
+#if defined(__APPLE__) && defined(__aarch64__)
+extern __thread bool jit_thread_executable_cache;
+extern __thread bool jit_thread_executable_valid;
+
+static uint64_t read_sprr_permission(void)
+{
+    uint64_t value;
+
+    __asm__ __volatile__("isb sy\n"
+                         "mrs %0, S3_6_c15_c1_5\n"
+                         : "=r"(value)::"memory");
+    return value;
+}
+
+static bool caller_is_executable(void)
+{
+    return ((read_sprr_permission() >> 20) & 3) == 1;
+}
+
+static int select_caller_mode(bool executable)
+{
+    pthread_jit_write_protect_np(executable);
+    return caller_is_executable() == executable ? 0 : 1;
+}
+#endif
+
+int main(void)
+{
+#if defined(__APPLE__) && defined(__aarch64__)
+    uc_switchyard_x86_64_transition_context input;
+    uc_switchyard_x86_64_transition_context output;
+    volatile uint32_t doorbell_a = 0;
+    volatile uint32_t doorbell_b = 0;
+    uint64_t ec_bitmap[1] = {0};
+    uc_x64_boundary_stop_reason reason;
+    uint64_t address;
+    uc_engine *uc = NULL;
+    uc_engine *cold = NULL;
+    uc_engine *wrong_mode = NULL;
+    uc_err err = UC_ERR_OK;
+    bool entry_executable;
+    bool executable;
+    static const uint8_t code[] = {0x90, 0x90};
+    unsigned int i;
+    unsigned int j;
+    int failed = 0;
+
+    if (!pthread_jit_write_protect_supported_np() || !read_sprr_permission()) {
+        puts("SWITCHYARD_STATE_NEUTRAL_JIT_STATE_SKIP");
+        return 0;
+    }
+
+    entry_executable = caller_is_executable();
+    memset(&input, 0, sizeof(input));
+    input.eflags = 2;
+    input.mxcsr = 0x1f80;
+
+#define RUN_API(label, requested_mode, expected_error, expression)             \
+    do {                                                                       \
+        executable = (requested_mode);                                         \
+        if (select_caller_mode(executable)) {                                  \
+            fprintf(stderr, "%s: could not select caller mode %u\n",           \
+                    (label), executable);                                      \
+            failed = 1;                                                        \
+            goto cleanup;                                                      \
+        }                                                                      \
+        err = (expression);                                                    \
+        if (err != (expected_error) || caller_is_executable() != executable || \
+            !jit_thread_executable_valid ||                                    \
+            jit_thread_executable_cache != executable) {                       \
+            fprintf(stderr,                                                    \
+                    "%s: error=%u expected=%u mode=%u expected-mode=%u "       \
+                    "jit-valid=%u jit-cache=%u\n",                             \
+                    (label), (unsigned int)err,                                \
+                    (unsigned int)(expected_error), caller_is_executable(),    \
+                    executable, jit_thread_executable_valid,                   \
+                    jit_thread_executable_cache);                              \
+            failed = 1;                                                        \
+            goto cleanup;                                                      \
+        }                                                                      \
+    } while (0)
+
+#define RUN_STATE_NEUTRAL_API(label, requested_mode, expected_error,           \
+                              expression)                                      \
+    do {                                                                       \
+        executable = (requested_mode);                                         \
+        if (select_caller_mode(executable)) {                                  \
+            fprintf(stderr, "%s: could not select caller mode %u\n",           \
+                    (label), executable);                                      \
+            failed = 1;                                                        \
+            goto cleanup;                                                      \
+        }                                                                      \
+        /* A deliberately invalid shadow makes any authentication observable.  \
+         * Initialized state-only APIs must leave the TLS fields untouched. */ \
+        jit_thread_executable_cache = !executable;                             \
+        jit_thread_executable_valid = false;                                   \
+        err = (expression);                                                    \
+        if (err != (expected_error) || caller_is_executable() != executable || \
+            jit_thread_executable_valid ||                                     \
+            jit_thread_executable_cache != !executable) {                      \
+            fprintf(stderr,                                                    \
+                    "%s: error=%u expected=%u mode=%u expected-mode=%u "       \
+                    "jit-valid=%u jit-cache=%u\n",                             \
+                    (label), (unsigned int)err,                                \
+                    (unsigned int)(expected_error), caller_is_executable(),    \
+                    executable, jit_thread_executable_valid,                   \
+                    jit_thread_executable_cache);                              \
+            failed = 1;                                                        \
+            goto cleanup;                                                      \
+        }                                                                      \
+    } while (0)
+
+    /* Exercise lazy initialization on both possible caller modes. */
+    for (i = 0; i < 2; ++i) {
+        if ((err = uc_open(UC_ARCH_X86, UC_MODE_64, &cold)) != UC_ERR_OK) {
+            fprintf(stderr, "cold uc_open failed: %u\n", (unsigned int)err);
+            failed = 1;
+            goto cleanup;
+        }
+        RUN_API("cold import", i != 0, UC_ERR_OK,
+                uc_switchyard_x86_64_import_transition_context(
+                    cold, &input, 0,
+                    UC_SWITCHYARD_X86_64_TRANSITION_CONTEXT_VERSION,
+                    sizeof(input)));
+        pthread_jit_write_protect_np(entry_executable);
+        uc_close(cold);
+        cold = NULL;
+    }
+
+    /* A lazy initialization followed by mode validation must also restore the
+     * caller mode before returning the error. */
+    if ((err = uc_open(UC_ARCH_X86, UC_MODE_32, &wrong_mode)) != UC_ERR_OK) {
+        fprintf(stderr, "wrong-mode uc_open failed: %u\n", (unsigned int)err);
+        failed = 1;
+        goto cleanup;
+    }
+    RUN_API("cold wrong-mode import", false, UC_ERR_ARG,
+            uc_switchyard_x86_64_import_transition_context(
+                wrong_mode, &input, 0,
+                UC_SWITCHYARD_X86_64_TRANSITION_CONTEXT_VERSION,
+                sizeof(input)));
+    RUN_STATE_NEUTRAL_API("initialized wrong-mode import", true, UC_ERR_ARG,
+                          uc_switchyard_x86_64_import_transition_context(
+                              wrong_mode, &input, 0,
+                              UC_SWITCHYARD_X86_64_TRANSITION_CONTEXT_VERSION,
+                              sizeof(input)));
+
+    if ((err = uc_open(UC_ARCH_X86, UC_MODE_64, &uc)) != UC_ERR_OK ||
+        (err = uc_mem_map(uc, CODE_ADDRESS, PAGE_SIZE, UC_PROT_ALL)) !=
+            UC_ERR_OK ||
+        (err = uc_mem_write(uc, CODE_ADDRESS, code, sizeof(code))) !=
+            UC_ERR_OK ||
+        (err = uc_configure_x64_boundary_guard(
+             uc, ec_bitmap, 1, 0xfff, 12, &doorbell_a, NULL)) != UC_ERR_OK) {
+        fprintf(stderr, "initialized engine setup failed: %u\n",
+                (unsigned int)err);
+        failed = 1;
+        goto cleanup;
+    }
+
+    for (i = 0; i < 2; ++i) {
+        /* The first run may translate code and change the thread permission;
+         * the second reuses the TB and exercises the already-matching path. */
+        for (j = 0; j < 2; ++j) {
+            RUN_API("initialized emulation", i != 0, UC_ERR_OK,
+                    uc_emu_start(uc, CODE_ADDRESS, CODE_ADDRESS + 1, 0, 0));
+        }
+        RUN_STATE_NEUTRAL_API("initialized import", i != 0, UC_ERR_OK,
+                              uc_switchyard_x86_64_import_transition_context(
+                                  uc, &input, 0,
+                                  UC_SWITCHYARD_X86_64_TRANSITION_CONTEXT_VERSION,
+                                  sizeof(input)));
+        RUN_STATE_NEUTRAL_API("initialized export", i != 0, UC_ERR_OK,
+                              uc_switchyard_x86_64_export_transition_context(
+                                  uc, &output,
+                                  UC_SWITCHYARD_X86_64_TRANSITION_CONTEXT_VERSION,
+                                  sizeof(output)));
+        RUN_STATE_NEUTRAL_API("initialized doorbell update", i != 0,
+                              UC_ERR_OK,
+                              uc_update_x64_boundary_suspend_doorbell(
+                                  uc, i ? &doorbell_a : &doorbell_b));
+        RUN_STATE_NEUTRAL_API("initialized stop query", i != 0, UC_ERR_OK,
+                              uc_query_x64_boundary_stop(uc, &reason,
+                                                         &address));
+        RUN_STATE_NEUTRAL_API("initialized invalid doorbell", i != 0,
+                              UC_ERR_ARG,
+                              uc_update_x64_boundary_suspend_doorbell(uc,
+                                                                     NULL));
+    }
+
+cleanup:
+    pthread_jit_write_protect_np(entry_executable);
+    if (uc) uc_close(uc);
+    if (wrong_mode) uc_close(wrong_mode);
+    if (cold) uc_close(cold);
+    pthread_jit_write_protect_np(entry_executable);
+#undef RUN_API
+#undef RUN_STATE_NEUTRAL_API
+
+    if (failed) return 1;
+    puts("SWITCHYARD_STATE_NEUTRAL_JIT_STATE_PASS");
+    return 0;
+#else
+    puts("SWITCHYARD_STATE_NEUTRAL_JIT_STATE_SKIP");
+    return 0;
+#endif
+}
diff --git a/tests/regress/tb_page_addr_iotlb.c b/tests/regress/tb_page_addr_iotlb.c
new file mode 100644
index 0000000000000000000000000000000000000000..290f294a1646a1910ebbb0cdd5539480005e5006
--- /dev/null
+++ b/tests/regress/tb_page_addr_iotlb.c
@@ -0,0 +1,86 @@
+/* Verify that translated blocks use the physical identity owned by the TLB.
+ *
+ * Mapping the same host page at two guest addresses makes host-pointer reverse
+ * lookup ambiguous.  A write through the second mapping must invalidate the
+ * translation created for that mapping, rather than whichever RAMBlock happens
+ * to appear first in the engine's global list.
+ */
+
+#include <inttypes.h>
+#include <stdint.h>
+#include <stdio.h>
+#include <string.h>
+#include <sys/mman.h>
+#include <unicorn/unicorn.h>
+
+#define PAGE_SIZE 0x1000
+#define FIRST_ADDR 0x01000000ull
+#define SECOND_ADDR 0x02000000ull
+#define WRITER_ADDR 0x03000000ull
+
+static int check(uc_err err, const char *operation)
+{
+    if (err == UC_ERR_OK) return 1;
+    fprintf(stderr, "%s failed: %s\n", operation, uc_strerror(err));
+    return 0;
+}
+
+static int run_return_value(uc_engine *uc, uint64_t address, uint32_t expected)
+{
+    uint32_t eax = 0;
+
+    if (!check(uc_reg_write(uc, UC_X86_REG_EAX, &eax), "clear EAX") ||
+        !check(uc_emu_start(uc, address, address + 5, 0, 0), "run return block") ||
+        !check(uc_reg_read(uc, UC_X86_REG_EAX, &eax), "read EAX"))
+        return 0;
+    if (eax == expected) return 1;
+    fprintf(stderr, "return block at 0x%" PRIx64 " produced %u, expected %u\n",
+            address, eax, expected);
+    return 0;
+}
+
+int main(void)
+{
+    static const uint8_t initial_code[] = {0xb8, 1, 0, 0, 0};
+    uint8_t writer_code[] = {
+        0x48, 0xb8,                         /* movabs SECOND_ADDR + 1, %rax */
+        0, 0, 0, 0, 0, 0, 0, 0,
+        0xc7, 0x00, 2, 0, 0, 0             /* movl $2, (%rax) */
+    };
+    const uint64_t target = SECOND_ADDR + 1;
+    uc_engine *uc = NULL;
+    uint8_t *shared;
+    int result = 1;
+
+    memcpy(writer_code + 2, &target, sizeof(target));
+    shared = mmap(NULL, PAGE_SIZE, PROT_READ | PROT_WRITE,
+                  MAP_PRIVATE | MAP_ANON, -1, 0);
+    if (shared == MAP_FAILED)
+    {
+        perror("mmap");
+        return 1;
+    }
+    memcpy(shared, initial_code, sizeof(initial_code));
+
+    if (!check(uc_open(UC_ARCH_X86, UC_MODE_64, &uc), "uc_open") ||
+        !check(uc_mem_map_ptr(uc, FIRST_ADDR, PAGE_SIZE, UC_PROT_ALL, shared),
+               "map first alias") ||
+        !check(uc_mem_map_ptr(uc, SECOND_ADDR, PAGE_SIZE, UC_PROT_ALL, shared),
+               "map second alias") ||
+        !check(uc_mem_map(uc, WRITER_ADDR, PAGE_SIZE, UC_PROT_ALL),
+               "map writer") ||
+        !check(uc_mem_write(uc, WRITER_ADDR, writer_code, sizeof(writer_code)),
+               "write writer") ||
+        !run_return_value(uc, SECOND_ADDR, 1) ||
+        !check(uc_emu_start(uc, WRITER_ADDR,
+                            WRITER_ADDR + sizeof(writer_code), 0, 0),
+               "run guest writer") ||
+        !run_return_value(uc, SECOND_ADDR, 2))
+        result = 1;
+    else
+        result = 0;
+
+    if (uc) uc_close(uc);
+    munmap(shared, PAGE_SIZE);
+    return result;
+}
diff --git a/tests/regress/threaded_emu_stop.c b/tests/regress/threaded_emu_stop.c
new file mode 100644
index 0000000000000000000000000000000000000000..e4cc03fedcfd6d06c35b65854caa6df9c8592cce
--- /dev/null
+++ b/tests/regress/threaded_emu_stop.c
@@ -0,0 +1,145 @@
+/* Test cross-thread uc_emu_stop() without racing the emulation thread state. */
+
+#define _POSIX_C_SOURCE 200809L
+
+#include <pthread.h>
+#include <sched.h>
+#include <stdatomic.h>
+#include <stdbool.h>
+#include <stdint.h>
+#include <stdio.h>
+#include <time.h>
+#include <unistd.h>
+
+#include <unicorn/unicorn.h>
+
+#define ADDRESS 0x100000
+#define ITERATIONS 100
+#define TIMEOUT_SECONDS 5
+
+struct test_state
+{
+    uc_engine *uc;
+    atomic_uint entered;
+    atomic_uint released;
+    atomic_uint finished;
+    uc_err result;
+};
+
+static bool wait_for_value(atomic_uint *value, unsigned int expected)
+{
+    struct timespec start, now;
+
+    clock_gettime(CLOCK_MONOTONIC, &start);
+    do
+    {
+        /* Keep this coordination relaxed: an acquire/release pair would hide
+         * unrelated engine-state races from ThreadSanitizer. */
+        if (atomic_load_explicit(value, memory_order_relaxed) >= expected)
+            return true;
+        sched_yield();
+        clock_gettime(CLOCK_MONOTONIC, &now);
+    } while (now.tv_sec - start.tv_sec < TIMEOUT_SECONDS);
+    return false;
+}
+
+static void code_hook(uc_engine *uc, uint64_t address, uint32_t size,
+                      void *user_data)
+{
+    struct test_state *state = user_data;
+    unsigned int generation;
+
+    (void)uc;
+    (void)address;
+    (void)size;
+
+    generation = atomic_fetch_add_explicit(&state->entered, 1,
+                                           memory_order_relaxed) + 1;
+    while (atomic_load_explicit(&state->released, memory_order_relaxed) <
+           generation)
+        sched_yield();
+}
+
+static void *emulation_thread(void *arg)
+{
+    struct test_state *state = arg;
+
+    state->result = uc_emu_start(state->uc, ADDRESS, UINT64_MAX, 0, 0);
+    atomic_fetch_add_explicit(&state->finished, 1, memory_order_relaxed);
+    return NULL;
+}
+
+int main(void)
+{
+    static const unsigned char code[] = {0xeb, 0xfe}; /* jmp $ */
+    struct test_state state = {0};
+    pthread_t thread;
+    uc_hook hook;
+    uc_err err;
+    unsigned int i;
+    int ret;
+
+    alarm(TIMEOUT_SECONDS * 3);
+    if ((err = uc_open(UC_ARCH_X86, UC_MODE_32, &state.uc)))
+    {
+        fprintf(stderr, "open failed: %s\n", uc_strerror(err));
+        return 1;
+    }
+
+    /* Stopping must not initialize an otherwise idle engine. */
+    if ((err = uc_emu_stop(state.uc)) ||
+        (err = uc_mem_map(state.uc, ADDRESS, 0x1000, UC_PROT_ALL)) ||
+        (err = uc_mem_write(state.uc, ADDRESS, code, sizeof(code))) ||
+        (err = uc_hook_add(state.uc, &hook, UC_HOOK_CODE, code_hook, &state,
+                           ADDRESS, ADDRESS + sizeof(code) - 1)))
+    {
+        fprintf(stderr, "setup failed: %s\n", uc_strerror(err));
+        return 1;
+    }
+
+    /* A stop made after initialization must not prevent the next start. */
+    if ((err = uc_emu_stop(state.uc)))
+    {
+        fprintf(stderr, "idle stop failed: %s\n", uc_strerror(err));
+        return 1;
+    }
+
+    for (i = 1; i <= ITERATIONS; i++)
+    {
+        if ((ret = pthread_create(&thread, NULL, emulation_thread, &state)))
+        {
+            fprintf(stderr, "pthread_create failed: %d\n", ret);
+            return 1;
+        }
+        if (!wait_for_value(&state.entered, i))
+        {
+            fputs("emulation did not enter\n", stderr);
+            return 1;
+        }
+
+        /* The emulation owner is inside the hook while this runs. */
+        if ((err = uc_emu_stop(state.uc)))
+        {
+            fprintf(stderr, "cross-thread stop failed: %s\n", uc_strerror(err));
+            return 1;
+        }
+
+        atomic_store_explicit(&state.released, i, memory_order_relaxed);
+        if (!wait_for_value(&state.finished, i))
+        {
+            fputs("emulation did not stop\n", stderr);
+            return 1;
+        }
+        pthread_join(thread, NULL);
+        if (state.result != UC_ERR_OK)
+        {
+            fprintf(stderr, "emulation failed: %s\n", uc_strerror(state.result));
+            return 1;
+        }
+    }
+
+    uc_close(state.uc);
+    alarm(0);
+    puts("cross-thread stop passed");
+    return 0;
+}
diff --git a/tests/regress/threaded_emu_stop_atomic.c b/tests/regress/threaded_emu_stop_atomic.c
new file mode 100644
index 0000000000000000000000000000000000000000..4998286a9c844083ee36df4281f92837d4683b1e
--- /dev/null
+++ b/tests/regress/threaded_emu_stop_atomic.c
@@ -0,0 +1,236 @@
+/* Test a cross-thread stop without restarting a side-effecting instruction. */
+
+#define _POSIX_C_SOURCE 200809L
+
+#include <pthread.h>
+#include <sched.h>
+#include <stdatomic.h>
+#include <stdbool.h>
+#include <stdint.h>
+#include <stdio.h>
+#include <string.h>
+#include <time.h>
+#include <unistd.h>
+
+#include <unicorn/unicorn.h>
+#include <unicorn/x86.h>
+
+#define ADDRESS 0x100000
+#define DATA_ADDRESS 0x101000
+#define RESULT_ADDRESS (DATA_ADDRESS + 4)
+#define TIMEOUT_SECONDS 5
+
+struct test_state
+{
+    uc_engine *uc;
+    uint64_t begin;
+    uint64_t write_address;
+    atomic_bool write_entered;
+    atomic_bool write_released;
+    uc_err result;
+};
+
+static bool wait_for_bool(atomic_bool *value)
+{
+    struct timespec start, now;
+
+    clock_gettime(CLOCK_MONOTONIC, &start);
+    do
+    {
+        if (atomic_load_explicit(value, memory_order_acquire)) return true;
+        sched_yield();
+        clock_gettime(CLOCK_MONOTONIC, &now);
+    } while (now.tv_sec - start.tv_sec < TIMEOUT_SECONDS);
+    return false;
+}
+
+static void write_hook(uc_engine *uc, uc_mem_type type, uint64_t address,
+                       int size, int64_t value, void *user_data)
+{
+    struct test_state *state = user_data;
+
+    (void)uc;
+    (void)type;
+    (void)size;
+    (void)value;
+    if (address != state->write_address ||
+        atomic_exchange_explicit(&state->write_entered, true,
+                                 memory_order_acq_rel))
+        return;
+    while (!atomic_load_explicit(&state->write_released, memory_order_acquire))
+        sched_yield();
+}
+
+static void *emulation_thread(void *arg)
+{
+    struct test_state *state = arg;
+
+    state->result = uc_emu_start(state->uc, state->begin, UINT64_MAX, 0, 0);
+    return NULL;
+}
+
+static int stop_at_first_write(struct test_state *state, const char *name)
+{
+    pthread_t thread;
+    uc_err err;
+    int ret;
+
+    if ((ret = pthread_create(&thread, NULL, emulation_thread, state)))
+    {
+        fprintf(stderr, "%s pthread_create failed: %d\n", name, ret);
+        return 1;
+    }
+    if (!wait_for_bool(&state->write_entered))
+    {
+        fprintf(stderr, "%s write hook was not reached\n", name);
+        return 1;
+    }
+    if ((err = uc_emu_stop_at_instruction_boundary(state->uc)))
+    {
+        fprintf(stderr, "%s instruction-boundary stop failed: %s\n",
+                name, uc_strerror(err));
+        return 1;
+    }
+    atomic_store_explicit(&state->write_released, true, memory_order_release);
+    pthread_join(thread, NULL);
+    if (state->result)
+    {
+        fprintf(stderr, "%s first slice failed: %s\n", name,
+                uc_strerror(state->result));
+        return 1;
+    }
+    return 0;
+}
+
+static int test_atomic_boundary(void)
+{
+    static const unsigned char code[] =
+    {
+        0xb9, 0x00, 0x10, 0x10, 0x00,       /* mov $DATA_ADDRESS,%ecx */
+        0x31, 0xc0,                         /* xor %eax,%eax */
+        0xba, 0xff, 0xff, 0xff, 0xff,       /* mov $-1,%edx */
+        0xf0, 0x0f, 0xb1, 0x11,             /* lock cmpxchg %edx,(%ecx) */
+        0x75, 0x0c,                         /* jne failure */
+        0xc7, 0x05, 0x04, 0x10, 0x10, 0x00,
+        0x01, 0x00, 0x00, 0x00,             /* movl $1,RESULT_ADDRESS */
+        0xeb, 0xfe,                         /* success: jmp success */
+        0xc7, 0x05, 0x04, 0x10, 0x10, 0x00,
+        0xad, 0xde, 0x00, 0x00,             /* failure: movl $0xdead,RESULT_ADDRESS */
+        0xeb, 0xfe,                         /* jmp failure */
+    };
+    struct test_state state = {.begin = ADDRESS, .write_address = DATA_ADDRESS};
+    uint32_t data = 0, result = 0, eip = 0;
+    uc_hook hook;
+    uc_err err;
+
+    if ((err = uc_open(UC_ARCH_X86, UC_MODE_32, &state.uc)) ||
+        (err = uc_mem_map(state.uc, ADDRESS, 0x2000, UC_PROT_ALL)) ||
+        (err = uc_mem_write(state.uc, ADDRESS, code, sizeof(code))) ||
+        (err = uc_hook_add(state.uc, &hook, UC_HOOK_MEM_WRITE, write_hook,
+                           &state, DATA_ADDRESS, DATA_ADDRESS)))
+    {
+        fprintf(stderr, "setup failed: %s\n", uc_strerror(err));
+        return 1;
+    }
+    if (stop_at_first_write(&state, "atomic") ||
+        (err = uc_mem_read(state.uc, DATA_ADDRESS, &data, sizeof(data))) ||
+        (err = uc_reg_read(state.uc, UC_X86_REG_EIP, &eip)))
+    {
+        fprintf(stderr, "first slice failed: %s\n",
+                uc_strerror(err));
+        return 1;
+    }
+    if (data != UINT32_MAX || eip == ADDRESS + 12)
+    {
+        fprintf(stderr, "boundary stop split atomic instruction: data %#x eip %#x\n",
+                data, eip);
+        return 1;
+    }
+
+    if ((err = uc_emu_start(state.uc, eip, UINT64_MAX, 10000, 0)) ||
+        (err = uc_mem_read(state.uc, RESULT_ADDRESS, &result, sizeof(result))))
+    {
+        fprintf(stderr, "resume failed: %s\n", uc_strerror(err));
+        return 1;
+    }
+    if (result != 1)
+    {
+        fprintf(stderr, "atomic instruction restarted after its write: %#x\n", result);
+        return 1;
+    }
+
+    uc_close(state.uc);
+    return 0;
+}
+
+static int test_rep_boundary(void)
+{
+    static const unsigned char code[] =
+    {
+        0xbf, 0x00, 0x10, 0x10, 0x00,       /* mov $DATA_ADDRESS,%edi */
+        0xb9, 0x04, 0x00, 0x00, 0x00,       /* mov $4,%ecx */
+        0xb0, 0x11,                         /* mov $0x11,%al */
+        0xf3, 0xaa,                         /* rep stosb */
+        0xeb, 0xfe,                         /* done: jmp done */
+    };
+    struct test_state state = {.begin = ADDRESS, .write_address = DATA_ADDRESS};
+    const unsigned char expected[] = {0x22, 0x11, 0x11, 0x11};
+    unsigned char data[sizeof(expected)] = {0};
+    uint32_t eip = 0, edi = 0, ecx = 0;
+    unsigned char replacement = expected[0];
+    uc_hook hook;
+    uc_err err;
+
+    if ((err = uc_open(UC_ARCH_X86, UC_MODE_32, &state.uc)) ||
+        (err = uc_mem_map(state.uc, ADDRESS, 0x2000, UC_PROT_ALL)) ||
+        (err = uc_mem_write(state.uc, ADDRESS, code, sizeof(code))) ||
+        (err = uc_hook_add(state.uc, &hook, UC_HOOK_MEM_WRITE, write_hook,
+                           &state, DATA_ADDRESS, DATA_ADDRESS)))
+    {
+        fprintf(stderr, "REP setup failed: %s\n", uc_strerror(err));
+        return 1;
+    }
+    if (stop_at_first_write(&state, "REP") ||
+        (err = uc_reg_read(state.uc, UC_X86_REG_EIP, &eip)) ||
+        (err = uc_reg_read(state.uc, UC_X86_REG_EDI, &edi)) ||
+        (err = uc_reg_read(state.uc, UC_X86_REG_ECX, &ecx)) ||
+        (err = uc_mem_read(state.uc, DATA_ADDRESS, data, 1)))
+    {
+        fprintf(stderr, "REP first-slice inspection failed: %s\n",
+                uc_strerror(err));
+        return 1;
+    }
+    if (eip != ADDRESS + 12 || edi != DATA_ADDRESS + 1 || ecx != 3 ||
+        data[0] != 0x11)
+    {
+        fprintf(stderr, "REP stop split an iteration: eip %#x edi %#x "
+                "ecx %#x data %#x\n", eip, edi, ecx, data[0]);
+        return 1;
+    }
+    if ((err = uc_mem_write(state.uc, DATA_ADDRESS, &replacement,
+                            sizeof(replacement))) ||
+        (err = uc_emu_start(state.uc, eip, UINT64_MAX, 10000, 0)) ||
+        (err = uc_mem_read(state.uc, DATA_ADDRESS, data, sizeof(data))))
+    {
+        fprintf(stderr, "REP resume failed: %s\n", uc_strerror(err));
+        return 1;
+    }
+    if (memcmp(data, expected, sizeof(data)))
+    {
+        fprintf(stderr, "REP iteration restarted after its write: "
+                "%#x %#x %#x %#x\n", data[0], data[1], data[2], data[3]);
+        return 1;
+    }
+
+    uc_close(state.uc);
+    return 0;
+}
+
+int main(void)
+{
+    alarm(TIMEOUT_SECONDS * 3);
+    if (test_atomic_boundary() || test_rep_boundary()) return 1;
+    alarm(0);
+    puts("instruction-boundary stop preserved atomic and REP instructions");
+    return 0;
+}
diff --git a/tests/regress/x86_64_boundary_guard.c b/tests/regress/x86_64_boundary_guard.c
new file mode 100644
index 0000000000000000000000000000000000000000..4288a4f8bf583a62d5e3ca19b0f3ad782ec7fad5
--- /dev/null
+++ b/tests/regress/x86_64_boundary_guard.c
@@ -0,0 +1,347 @@
+#include <inttypes.h>
+#include <pthread.h>
+#include <stdint.h>
+#include <stdio.h>
+#include <stdlib.h>
+#include <string.h>
+#include <unistd.h>
+
+#include <unicorn/unicorn.h>
+
+#define CODE_BASE UINT64_C(0x01000000)
+#define PAGE_SIZE UINT64_C(0x1000)
+#define MAP_SIZE (2 * PAGE_SIZE)
+#define PAGE_SHIFT 12
+#define ADDRESS_BITS 28
+#define HIGHEST_ADDRESS (CODE_BASE + MAP_SIZE - 1)
+#define BITMAP_WORDS (((HIGHEST_ADDRESS >> PAGE_SHIFT) / 64) + 1)
+
+static uint8_t identity_page_flags[
+    UINT64_C(1) << (ADDRESS_BITS - PAGE_SHIFT)];
+
+static int failures;
+
+#define CHECK(condition, ...)                                                  \
+    do {                                                                       \
+        if (!(condition)) {                                                    \
+            fprintf(stderr, __VA_ARGS__);                                      \
+            ++failures;                                                        \
+        }                                                                      \
+    } while (0)
+
+static void set_ec_page(uint64_t *bitmap, uint64_t address, int enabled)
+{
+    uint64_t page = address >> PAGE_SHIFT;
+    uint64_t mask = UINT64_C(1) << (page & 63);
+
+    if (enabled)
+        __atomic_fetch_or(bitmap + page / 64, mask, __ATOMIC_RELEASE);
+    else
+        __atomic_fetch_and(bitmap + page / 64, ~mask, __ATOMIC_RELEASE);
+}
+
+static uc_engine *create_engine(uint64_t *bitmap,
+                                const volatile uint32_t *doorbell)
+{
+    static const uint8_t code[] = {
+        0x48, 0xff, 0xc0, /* inc rax */
+        0x90,             /* nop */
+    };
+    uc_engine *uc = NULL;
+    uc_err err = uc_open(UC_ARCH_X86, UC_MODE_64, &uc);
+
+    if (err == UC_ERR_OK)
+        err = uc_configure_identity_memory_fastpath(
+            uc, identity_page_flags, ADDRESS_BITS);
+    if (err == UC_ERR_OK) err = uc_enable_shared_memory_atomics(uc);
+    if (err == UC_ERR_OK)
+        err = uc_mem_map(uc, CODE_BASE, MAP_SIZE, UC_PROT_ALL);
+    if (err == UC_ERR_OK)
+        err = uc_mem_write(uc, CODE_BASE, code, sizeof(code));
+    if (err == UC_ERR_OK)
+        err = uc_configure_x64_boundary_guard(
+            uc, bitmap, BITMAP_WORDS, HIGHEST_ADDRESS, PAGE_SHIFT,
+            doorbell, NULL);
+    if (err != UC_ERR_OK) {
+        fprintf(stderr, "engine creation failed: %s\n", uc_strerror(err));
+        if (uc) uc_close(uc);
+        return NULL;
+    }
+    return uc;
+}
+
+static uc_x64_boundary_stop_reason run_increment(uc_engine *uc,
+                                                 uint64_t *rax)
+{
+    uc_x64_boundary_stop_reason reason = UC_X64_BOUNDARY_STOP_NONE;
+    uint64_t address = UINT64_MAX;
+    uc_err err;
+
+    *rax = 0;
+    err = uc_reg_write(uc, UC_X86_REG_RAX, rax);
+    if (err == UC_ERR_OK)
+        err = uc_emu_start(uc, CODE_BASE, CODE_BASE + 4, 0, 0);
+    if (err == UC_ERR_OK) err = uc_reg_read(uc, UC_X86_REG_RAX, rax);
+    if (err == UC_ERR_OK)
+        err = uc_query_x64_boundary_stop(uc, &reason, &address);
+    CHECK(err == UC_ERR_OK, "increment run failed: %s\n", uc_strerror(err));
+    if (reason != UC_X64_BOUNDARY_STOP_NONE)
+        CHECK(address == CODE_BASE,
+              "unexpected stop address %#" PRIx64 "\n", address);
+    return reason;
+}
+
+struct loop_state {
+    uc_engine *uc;
+    volatile uint64_t blocks;
+    volatile int finished;
+    uc_err err;
+};
+
+static void loop_block_hook(uc_engine *uc, uint64_t address, uint32_t size,
+                            void *user_data)
+{
+    struct loop_state *state = user_data;
+
+    (void)uc;
+    (void)address;
+    (void)size;
+    __atomic_add_fetch(&state->blocks, 1, __ATOMIC_RELEASE);
+}
+
+static void *run_loop(void *arg)
+{
+    struct loop_state *state = arg;
+
+    state->err = uc_emu_start(state->uc, CODE_BASE, 0, 0, 0);
+    __atomic_store_n(&state->finished, 1, __ATOMIC_RELEASE);
+    return NULL;
+}
+
+static int wait_for_blocks(struct loop_state *state, uint64_t target)
+{
+    unsigned int i;
+
+    for (i = 0; i < 2000; ++i) {
+        if (__atomic_load_n(&state->blocks, __ATOMIC_ACQUIRE) >= target)
+            return 1;
+        if (__atomic_load_n(&state->finished, __ATOMIC_ACQUIRE)) return 0;
+        usleep(1000);
+    }
+    return 0;
+}
+
+static int run_expect_boundary_stop(struct loop_state *state,
+                                    uc_x64_boundary_stop_reason expected)
+{
+    uc_x64_boundary_stop_reason reason = UC_X64_BOUNDARY_STOP_NONE;
+    uint64_t address = UINT64_MAX;
+    pthread_t thread;
+    unsigned int i;
+    int ret;
+
+    __atomic_store_n(&state->finished, 0, __ATOMIC_RELEASE);
+    ret = pthread_create(&thread, NULL, run_loop, state);
+    CHECK(ret == 0, "boundary-stop runner creation failed: %d\n", ret);
+    if (ret) return 0;
+    for (i = 0; i < 2000; ++i) {
+        if (__atomic_load_n(&state->finished, __ATOMIC_ACQUIRE)) break;
+        usleep(1000);
+    }
+    if (!__atomic_load_n(&state->finished, __ATOMIC_ACQUIRE))
+        uc_emu_stop_at_instruction_boundary(state->uc);
+    pthread_join(thread, NULL);
+    CHECK(i < 2000, "cached boundary TB failed to stop\n");
+    CHECK(state->err == UC_ERR_OK, "boundary runner failed: %s\n",
+          uc_strerror(state->err));
+    if (uc_query_x64_boundary_stop(state->uc, &reason, &address) != UC_ERR_OK)
+        return 0;
+    CHECK(reason == expected && address == CODE_BASE,
+          "boundary stop mismatch: reason %u address %#" PRIx64 "\n",
+          reason, address);
+    return i < 2000 && reason == expected && address == CODE_BASE;
+}
+
+static void test_ec_invalidation_contract(void)
+{
+    static const uint8_t loop_code[] = {
+        0x48, 0xff, 0xc0, /* inc rax */
+        0xeb, 0xfb,       /* jmp CODE_BASE */
+    };
+    volatile uint32_t doorbell = 0;
+    uint64_t *bitmap = calloc(BITMAP_WORDS, sizeof(*bitmap));
+    struct loop_state state = {0};
+    uc_engine *uc;
+    uc_hook hook;
+    pthread_t thread;
+    uint64_t blocks, rax = 0;
+    uc_err err;
+    int ret;
+
+    CHECK(bitmap != NULL, "bitmap allocation failed\n");
+    if (!bitmap) return;
+    uc = create_engine(bitmap, &doorbell);
+    CHECK(uc != NULL, "EC contract engine creation failed\n");
+    if (!uc) {
+        free(bitmap);
+        return;
+    }
+    err = uc_mem_write(uc, CODE_BASE, loop_code, sizeof(loop_code));
+    state.uc = uc;
+    if (err == UC_ERR_OK)
+        err = uc_hook_add(uc, &hook, UC_HOOK_BLOCK, loop_block_hook, &state,
+                          1, 0);
+    if (err == UC_ERR_OK) err = uc_reg_write(uc, UC_X86_REG_RAX, &rax);
+    CHECK(err == UC_ERR_OK, "loop setup failed: %s\n", uc_strerror(err));
+    __atomic_store_n(&state.finished, 0, __ATOMIC_RELEASE);
+    ret = pthread_create(&thread, NULL, run_loop, &state);
+    CHECK(ret == 0, "loop runner creation failed: %d\n", ret);
+    if (ret) {
+        uc_close(uc);
+        free(bitmap);
+        return;
+    }
+    CHECK(wait_for_blocks(&state, 1000), "x64 TB did not warm\n");
+    set_ec_page(bitmap, CODE_BASE, 1);
+    blocks = __atomic_load_n(&state.blocks, __ATOMIC_ACQUIRE);
+    CHECK(wait_for_blocks(&state, blocks + 1000),
+          "bitmap mutation changed a cached x64 TB without invalidation\n");
+    uc_emu_stop_at_instruction_boundary(uc);
+    pthread_join(thread, NULL);
+    CHECK(state.err == UC_ERR_OK, "warmed loop failed: %s\n",
+          uc_strerror(state.err));
+
+    err = uc_ctl_remove_cache(uc, CODE_BASE, CODE_BASE + PAGE_SIZE);
+    CHECK(err == UC_ERR_OK, "0->1 cache invalidation failed: %s\n",
+          uc_strerror(err));
+    run_expect_boundary_stop(&state, UC_X64_BOUNDARY_STOP_EC_CODE);
+
+    set_ec_page(bitmap, CODE_BASE, 0);
+    run_expect_boundary_stop(&state, UC_X64_BOUNDARY_STOP_EC_CODE);
+
+    err = uc_ctl_remove_cache(uc, CODE_BASE, CODE_BASE + PAGE_SIZE);
+    CHECK(err == UC_ERR_OK, "1->0 cache invalidation failed: %s\n",
+          uc_strerror(err));
+    blocks = __atomic_load_n(&state.blocks, __ATOMIC_ACQUIRE);
+    __atomic_store_n(&state.finished, 0, __ATOMIC_RELEASE);
+    ret = pthread_create(&thread, NULL, run_loop, &state);
+    CHECK(ret == 0, "resumed loop runner creation failed: %d\n", ret);
+    if (!ret) {
+        CHECK(wait_for_blocks(&state, blocks + 1000),
+              "invalidated x64 TB did not resume\n");
+        uc_emu_stop_at_instruction_boundary(uc);
+        pthread_join(thread, NULL);
+        CHECK(state.err == UC_ERR_OK, "resumed loop failed: %s\n",
+              uc_strerror(state.err));
+    }
+
+    uc_hook_del(uc, hook);
+    uc_close(uc);
+    free(bitmap);
+}
+
+static void test_doorbell_slot_and_context(void)
+{
+    volatile uint32_t first = 0, second = 0;
+    uint64_t *bitmap = calloc(BITMAP_WORDS, sizeof(*bitmap));
+    uc_engine *uc;
+    uc_context *context = NULL;
+    uc_x64_boundary_stop_reason reason;
+    uint64_t rax;
+    uc_err err;
+
+    CHECK(bitmap != NULL, "doorbell bitmap allocation failed\n");
+    if (!bitmap) return;
+    uc = create_engine(bitmap, &first);
+    CHECK(uc != NULL, "doorbell engine creation failed\n");
+    if (!uc) {
+        free(bitmap);
+        return;
+    }
+
+    reason = run_increment(uc, &rax);
+    CHECK(reason == UC_X64_BOUNDARY_STOP_NONE && rax == 1,
+          "doorbell warmup failed\n");
+    first = 1;
+    reason = run_increment(uc, &rax);
+    CHECK(reason == UC_X64_BOUNDARY_STOP_SUSPEND && rax == 0,
+          "live first doorbell was not observed\n");
+
+    first = 0;
+    err = uc_context_alloc(uc, &context);
+    if (err == UC_ERR_OK) err = uc_context_save(uc, context);
+    CHECK(err == UC_ERR_OK, "context save failed: %s\n", uc_strerror(err));
+    err = uc_update_x64_boundary_suspend_doorbell(uc, &second);
+    CHECK(err == UC_ERR_OK, "doorbell slot update failed: %s\n",
+          uc_strerror(err));
+    if (context && err == UC_ERR_OK) err = uc_context_restore(uc, context);
+    CHECK(err == UC_ERR_OK, "context restore failed: %s\n", uc_strerror(err));
+
+    second = 1;
+    reason = run_increment(uc, &rax);
+    CHECK(reason == UC_X64_BOUNDARY_STOP_SUSPEND && rax == 0,
+          "context restore replaced the host-owned doorbell slot\n");
+    second = 0;
+    reason = run_increment(uc, &rax);
+    CHECK(reason == UC_X64_BOUNDARY_STOP_NONE && rax == 1,
+          "cleared replacement doorbell did not resume cached TB\n");
+
+    if (context) uc_context_free(context);
+    uc_close(uc);
+    free(bitmap);
+}
+
+static void test_cross_page_ec_entry(void)
+{
+    uint8_t code[12];
+    volatile uint32_t doorbell = 0;
+    uint64_t *bitmap = calloc(BITMAP_WORDS, sizeof(*bitmap));
+    uint64_t begin = CODE_BASE + PAGE_SIZE - 8;
+    uint64_t second_page = CODE_BASE + PAGE_SIZE;
+    uint64_t rax = 0, stop_address = UINT64_MAX;
+    uc_x64_boundary_stop_reason reason = UC_X64_BOUNDARY_STOP_NONE;
+    uc_engine *uc;
+    uc_err err;
+
+    CHECK(bitmap != NULL, "cross-page bitmap allocation failed\n");
+    if (!bitmap) return;
+    memset(code, 0x90, sizeof(code));
+    code[8] = 0x48;
+    code[9] = 0xff;
+    code[10] = 0xc0; /* inc rax on the EC page */
+    set_ec_page(bitmap, second_page, 1);
+    uc = create_engine(bitmap, &doorbell);
+    CHECK(uc != NULL, "cross-page engine creation failed\n");
+    if (!uc) {
+        free(bitmap);
+        return;
+    }
+    err = uc_mem_write(uc, begin, code, sizeof(code));
+    if (err == UC_ERR_OK) err = uc_reg_write(uc, UC_X86_REG_RAX, &rax);
+    if (err == UC_ERR_OK)
+        err = uc_emu_start(uc, begin, second_page + 4, 0, 0);
+    if (err == UC_ERR_OK) err = uc_reg_read(uc, UC_X86_REG_RAX, &rax);
+    if (err == UC_ERR_OK)
+        err = uc_query_x64_boundary_stop(uc, &reason, &stop_address);
+    CHECK(err == UC_ERR_OK, "cross-page run failed: %s\n", uc_strerror(err));
+    CHECK(reason == UC_X64_BOUNDARY_STOP_EC_CODE && rax == 0 &&
+              stop_address == second_page,
+          "cross-page EC entry escaped boundary: reason %u rax %#" PRIx64
+          " address %#" PRIx64 "\n", reason, rax, stop_address);
+
+    uc_close(uc);
+    free(bitmap);
+}
+
+int main(void)
+{
+    test_ec_invalidation_contract();
+    test_doorbell_slot_and_context();
+    test_cross_page_ec_entry();
+    if (failures) {
+        fprintf(stderr, "%d x64 boundary guard checks failed\n", failures);
+        return 1;
+    }
+    puts("x86_64 boundary guard checks passed");
+    return 0;
+}
diff --git a/tests/regress/x86_64_cross_page_chain.c b/tests/regress/x86_64_cross_page_chain.c
new file mode 100644
index 0000000000000000000000000000000000000000..84266f06fdd26ec81093776e003c00615758969a
--- /dev/null
+++ b/tests/regress/x86_64_cross_page_chain.c
@@ -0,0 +1,158 @@
+/* Verify that identity-memory cross-page direct chains never survive a code
+ * mutation, execute-permission change, or mapping replacement. */
+
+#include <inttypes.h>
+#include <stdint.h>
+#include <stdio.h>
+#include <stdlib.h>
+#include <string.h>
+
+#include <unicorn/unicorn.h>
+
+#define PAGE_SIZE_BYTES UINT64_C(0x1000)
+#define SOURCE_ADDRESS UINT64_C(0x01000000)
+#define WRITER_ADDRESS UINT64_C(0x01002000)
+#define TARGET_ADDRESS UINT64_C(0x01004000)
+#define FINISH_ADDRESS UINT64_C(0x01007000)
+#define MAPPING_SIZE UINT64_C(0x00008000)
+#define IDENTITY_ADDRESS_BITS 28
+#define IDENTITY_PAGE_SHIFT 12
+#define IDENTITY_PAGE_COUNT \
+    (UINT64_C(1) << (IDENTITY_ADDRESS_BITS - IDENTITY_PAGE_SHIFT))
+
+static int check(uc_err err, const char *operation)
+{
+    if (err == UC_ERR_OK) return 1;
+    fprintf(stderr, "%s failed: %s\n", operation, uc_strerror(err));
+    return 0;
+}
+
+static int put_rel32(uint8_t *code, size_t offset, uint64_t instruction,
+                     uint64_t target)
+{
+    int64_t displacement = (int64_t)target - (int64_t)(instruction + 5);
+    int32_t value = (int32_t)displacement;
+
+    if (displacement != value) return 0;
+    code[offset] = 0xe9;
+    memcpy(code + offset + 1, &value, sizeof(value));
+    return 1;
+}
+
+static void make_target(uint8_t code[10], uint32_t value)
+{
+    code[0] = 0xb8; /* mov value, eax */
+    memcpy(code + 1, &value, sizeof(value));
+    put_rel32(code, 5, TARGET_ADDRESS + 5, FINISH_ADDRESS);
+}
+
+static void make_writer(uint8_t code[21], uint32_t value)
+{
+    uint64_t destination = TARGET_ADDRESS + 1;
+
+    code[0] = 0x48;
+    code[1] = 0xb8; /* movabs target immediate address, rax */
+    memcpy(code + 2, &destination, sizeof(destination));
+    code[10] = 0xc7;
+    code[11] = 0x00; /* mov value, (rax) */
+    memcpy(code + 12, &value, sizeof(value));
+    put_rel32(code, 16, WRITER_ADDRESS + 16, FINISH_ADDRESS);
+}
+
+static int run_value(uc_engine *uc, uint32_t expected)
+{
+    uint32_t eax = 0;
+    uc_err err;
+
+    if (!check(uc_reg_write(uc, UC_X86_REG_EAX, &eax), "clear EAX")) return 0;
+    err = uc_emu_start(uc, SOURCE_ADDRESS, FINISH_ADDRESS, 0, 0);
+    if (!check(err, "execute chain") ||
+        !check(uc_reg_read(uc, UC_X86_REG_EAX, &eax), "read EAX"))
+        return 0;
+    if (eax == expected) return 1;
+    fprintf(stderr, "chain returned %u, expected %u\n", eax, expected);
+    return 0;
+}
+
+static int expect_fetch_error(uc_engine *uc, uc_err expected,
+                              const char *operation)
+{
+    uc_err err = uc_emu_start(uc, SOURCE_ADDRESS, FINISH_ADDRESS, 0, 0);
+
+    if (err == expected) return 1;
+    fprintf(stderr, "%s returned %s, expected %s\n", operation,
+            uc_strerror(err), uc_strerror(expected));
+    return 0;
+}
+
+int main(void)
+{
+    uint8_t *page_flags = calloc(IDENTITY_PAGE_COUNT, 1);
+    uint8_t source[5], target[10], writer[21];
+    uc_engine *uc = NULL;
+    uc_err err;
+    int ok = 0;
+
+    if (!page_flags ||
+        !put_rel32(source, 0, SOURCE_ADDRESS, TARGET_ADDRESS)) {
+        fprintf(stderr, "test setup failed\n");
+        goto done;
+    }
+    make_target(target, 1);
+    make_writer(writer, 2);
+    if (!check(uc_open(UC_ARCH_X86, UC_MODE_64, &uc), "uc_open") ||
+        !check(uc_configure_identity_memory_fastpath(
+                   uc, page_flags, IDENTITY_ADDRESS_BITS),
+               "configure identity memory") ||
+        !check(uc_enable_shared_memory_atomics(uc), "enable shared atomics") ||
+        !check(uc_mem_map(uc, SOURCE_ADDRESS, MAPPING_SIZE, UC_PROT_ALL),
+               "map code") ||
+        !check(uc_mem_write(uc, SOURCE_ADDRESS, source, sizeof(source)),
+               "write source") ||
+        !check(uc_mem_write(uc, WRITER_ADDRESS, writer, sizeof(writer)),
+               "write guest writer") ||
+        !check(uc_mem_write(uc, TARGET_ADDRESS, target, sizeof(target)),
+               "write initial target") ||
+        !run_value(uc, 1) || !run_value(uc, 1))
+        goto done;
+
+    if (!check(uc_emu_start(uc, WRITER_ADDRESS, FINISH_ADDRESS, 0, 0),
+               "execute guest writer") ||
+        !run_value(uc, 2))
+        goto done;
+
+    if (!check(uc_mem_protect(uc, TARGET_ADDRESS, PAGE_SIZE_BYTES,
+                              UC_PROT_READ | UC_PROT_WRITE),
+               "remove execute permission") ||
+        !expect_fetch_error(uc, UC_ERR_FETCH_PROT, "execute protected target") ||
+        !check(uc_mem_protect(uc, TARGET_ADDRESS, PAGE_SIZE_BYTES, UC_PROT_ALL),
+               "restore execute permission") ||
+        !run_value(uc, 2))
+        goto done;
+
+    if (!check(uc_mem_unmap(uc, TARGET_ADDRESS, PAGE_SIZE_BYTES),
+               "unmap target") ||
+        !expect_fetch_error(uc, UC_ERR_FETCH_UNMAPPED, "execute unmapped target") ||
+        !check(uc_mem_map(uc, TARGET_ADDRESS, PAGE_SIZE_BYTES, UC_PROT_ALL),
+               "remap target"))
+        goto done;
+    make_target(target, 3);
+    if (!check(uc_mem_write(uc, TARGET_ADDRESS, target, sizeof(target)),
+               "write remapped target") ||
+        !run_value(uc, 3))
+        goto done;
+
+    ok = 1;
+    puts("cross-page chain invalidation stayed coherent");
+
+done:
+    if (uc) {
+        err = uc_close(uc);
+        if (ok && err != UC_ERR_OK) {
+            fprintf(stderr, "uc_close failed: %s\n", uc_strerror(err));
+            ok = 0;
+        }
+    }
+    free(page_flags);
+    return ok ? 0 : 1;
+}
diff --git a/tests/regress/x86_64_transition_context.c b/tests/regress/x86_64_transition_context.c
new file mode 100644
index 0000000000000000000000000000000000000000..661e2d60a26df68da6ad0f026dbb9731cbec182e
--- /dev/null
+++ b/tests/regress/x86_64_transition_context.c
@@ -0,0 +1,161 @@
+#include <inttypes.h>
+#include <stddef.h>
+#include <stdint.h>
+#include <stdio.h>
+#include <string.h>
+
+#include <unicorn/unicorn.h>
+#include <unicorn/x86.h>
+
+#define CODE_ADDRESS 0x1000000ull
+#define CODE_SIZE    0x1000ull
+
+static int fail(const char *message, uc_err err)
+{
+    fprintf(stderr, "X86_64_TRANSITION_CONTEXT_FAIL: %s (%u)\n", message,
+            (unsigned int)err);
+    return 1;
+}
+
+static int check_register(uc_engine *uc, int reg, uint64_t expected,
+                          const char *name)
+{
+    uint64_t actual = 0;
+    uc_err err = uc_reg_read(uc, reg, &actual);
+
+    if (err != UC_ERR_OK)
+        return fail(name, err);
+    if (actual != expected)
+    {
+        fprintf(stderr,
+                "X86_64_TRANSITION_CONTEXT_FAIL: %s expected=%#" PRIx64
+                " actual=%#" PRIx64 "\n", name, expected, actual);
+        return 1;
+    }
+    return 0;
+}
+
+int main(void)
+{
+    static const int registers[16] = {
+        UC_X86_REG_RAX, UC_X86_REG_RBX, UC_X86_REG_RCX, UC_X86_REG_RDX,
+        UC_X86_REG_RSI, UC_X86_REG_RDI, UC_X86_REG_RBP, UC_X86_REG_RSP,
+        UC_X86_REG_R8, UC_X86_REG_R9, UC_X86_REG_R10, UC_X86_REG_R11,
+        UC_X86_REG_R12, UC_X86_REG_R13, UC_X86_REG_R14, UC_X86_REG_R15,
+    };
+    static const char *const names[16] = {
+        "rax", "rbx", "rcx", "rdx", "rsi", "rdi", "rbp", "rsp",
+        "r8", "r9", "r10", "r11", "r12", "r13", "r14", "r15",
+    };
+    static const uint8_t code[] = {0x48, 0x01, 0xd8, 0x90}; /* add rax,rbx; nop */
+    uc_switchyard_x86_64_transition_context input;
+    uc_switchyard_x86_64_transition_context output;
+    uc_engine *uc = NULL;
+    uc_engine *uc32 = NULL;
+    uint64_t *input_registers = &input.rax;
+    uint64_t gs_base = 0x123456780000ull;
+    uint64_t actual_gs = 0;
+    uint32_t actual_mxcsr = 0;
+    uint64_t actual_xmm[2];
+    uc_err err;
+    unsigned int i;
+
+    if (sizeof(input) != 408 ||
+        offsetof(uc_switchyard_x86_64_transition_context, mxcsr) != 144 ||
+        offsetof(uc_switchyard_x86_64_transition_context, xmm) != 152)
+        return fail("public layout", UC_ERR_ARG);
+
+    memset(&input, 0, sizeof(input));
+    for (i = 0; i < 16; ++i)
+        input_registers[i] = 0x1111000000000000ull + i * 0x0101010101010101ull;
+    input.rip = CODE_ADDRESS;
+    input.eflags = 0x202;
+    input.mxcsr = 0x1f80;
+    input.reserved = 0xa5a5a5a5u;
+    for (i = 0; i < 16; ++i)
+    {
+        input.xmm[i][0] = 0xabcdef0000000000ull + i;
+        input.xmm[i][1] = 0x1234560000000000ull + i;
+    }
+
+    if ((err = uc_open(UC_ARCH_X86, UC_MODE_64, &uc)) != UC_ERR_OK)
+        return fail("uc_open", err);
+    if (uc_switchyard_x86_64_import_transition_context(
+            uc, &input, gs_base,
+            UC_SWITCHYARD_X86_64_TRANSITION_CONTEXT_VERSION,
+            sizeof(input) - 1) != UC_ERR_ARG ||
+        uc_switchyard_x86_64_import_transition_context(
+            uc, &input, gs_base,
+            UC_SWITCHYARD_X86_64_TRANSITION_CONTEXT_VERSION + 1,
+            sizeof(input)) != UC_ERR_ARG ||
+        uc_switchyard_x86_64_import_transition_context(
+            uc, NULL, gs_base,
+            UC_SWITCHYARD_X86_64_TRANSITION_CONTEXT_VERSION,
+            sizeof(input)) != UC_ERR_ARG)
+        return fail("import validation", UC_ERR_ARG);
+
+    if ((err = uc_switchyard_x86_64_import_transition_context(
+             uc, &input, gs_base,
+             UC_SWITCHYARD_X86_64_TRANSITION_CONTEXT_VERSION,
+             sizeof(input))) != UC_ERR_OK)
+        return fail("import", err);
+    for (i = 0; i < 16; ++i)
+        if (check_register(uc, registers[i], input_registers[i], names[i]))
+            return 1;
+    if (check_register(uc, UC_X86_REG_RIP, input.rip, "rip") ||
+        check_register(uc, UC_X86_REG_EFLAGS, input.eflags, "eflags"))
+        return 1;
+    if ((err = uc_reg_read(uc, UC_X86_REG_GS_BASE, &actual_gs)) != UC_ERR_OK ||
+        actual_gs != gs_base)
+        return fail("gs_base", err);
+    if ((err = uc_reg_read(uc, UC_X86_REG_MXCSR, &actual_mxcsr)) != UC_ERR_OK ||
+        actual_mxcsr != input.mxcsr)
+        return fail("mxcsr", err);
+    if ((err = uc_reg_read(uc, UC_X86_REG_XMM15, actual_xmm)) != UC_ERR_OK ||
+        memcmp(actual_xmm, input.xmm[15], sizeof(actual_xmm)))
+        return fail("xmm15", err);
+
+    if ((err = uc_mem_map(uc, CODE_ADDRESS, CODE_SIZE, UC_PROT_ALL)) != UC_ERR_OK ||
+        (err = uc_mem_write(uc, CODE_ADDRESS, code, sizeof(code))) != UC_ERR_OK)
+        return fail("code mapping", err);
+    input.rax = UINT64_MAX;
+    input.rbx = 1;
+    if ((err = uc_switchyard_x86_64_import_transition_context(
+             uc, &input, gs_base,
+             UC_SWITCHYARD_X86_64_TRANSITION_CONTEXT_VERSION,
+             sizeof(input))) != UC_ERR_OK ||
+        (err = uc_emu_start(uc, CODE_ADDRESS, CODE_ADDRESS + 3, 0, 0)) !=
+            UC_ERR_OK)
+        return fail("lazy-flags execution", err);
+
+    memset(&output, 0xcc, sizeof(output));
+    output.reserved = 0x5a5a5a5au;
+    if ((err = uc_switchyard_x86_64_export_transition_context(
+             uc, &output,
+             UC_SWITCHYARD_X86_64_TRANSITION_CONTEXT_VERSION,
+             sizeof(output))) != UC_ERR_OK)
+        return fail("export", err);
+    if (output.rax != 0 || output.rbx != 1 || output.rip != CODE_ADDRESS + 3 ||
+        (output.eflags & 0x8d5) != 0x55 || output.mxcsr != input.mxcsr ||
+        output.reserved != 0x5a5a5a5au ||
+        memcmp(output.xmm, input.xmm, sizeof(output.xmm)))
+        return fail("exported state", UC_ERR_ARG);
+    if (uc_switchyard_x86_64_export_transition_context(
+            uc, &output,
+            UC_SWITCHYARD_X86_64_TRANSITION_CONTEXT_VERSION,
+            sizeof(output) - 1) != UC_ERR_ARG)
+        return fail("export validation", UC_ERR_ARG);
+
+    if ((err = uc_open(UC_ARCH_X86, UC_MODE_32, &uc32)) != UC_ERR_OK)
+        return fail("uc_open 32", err);
+    if (uc_switchyard_x86_64_import_transition_context(
+            uc32, &input, gs_base,
+            UC_SWITCHYARD_X86_64_TRANSITION_CONTEXT_VERSION,
+            sizeof(input)) != UC_ERR_ARG)
+        return fail("mode validation", UC_ERR_ARG);
+
+    uc_close(uc32);
+    uc_close(uc);
+    puts("X86_64_TRANSITION_CONTEXT_PASS");
+    return 0;
+}
diff --git a/tests/regress/x86_pause.c b/tests/regress/x86_pause.c
new file mode 100644
index 0000000000000000000000000000000000000000..fbb56c1acf798e603dd0529f08edd2eb17d7a7ee
--- /dev/null
+++ b/tests/regress/x86_pause.c
@@ -0,0 +1,372 @@
+/* Verify x86 PAUSE remains interruptible without leaving the generated-code
+ * loop or changing architectural state. */
+
+#define _POSIX_C_SOURCE 200809L
+
+#include <pthread.h>
+#include <stdatomic.h>
+#include <stdint.h>
+#include <stdio.h>
+#include <time.h>
+#include <unistd.h>
+
+#include <unicorn/unicorn.h>
+#include <unicorn/x86.h>
+
+#define ADDRESS UINT64_C(0x100000)
+#define DATA_ADDRESS (ADDRESS + UINT64_C(0x1000))
+#define TIMEOUT_SECONDS 5
+#define STOP_REPETITIONS 32
+
+struct stop_state
+{
+    uc_engine *uc;
+    atomic_bool started;
+    atomic_bool finished;
+    uc_err result;
+};
+
+static int setup_engine(uc_engine **uc, const unsigned char *code, size_t size)
+{
+    uc_err err;
+
+    if ((err = uc_open(UC_ARCH_X86, UC_MODE_64, uc)) ||
+        (err = uc_enable_shared_memory_atomics(*uc)) ||
+        (err = uc_mem_map(*uc, ADDRESS, 0x1000, UC_PROT_ALL)) ||
+        (err = uc_mem_write(*uc, ADDRESS, code, size)))
+    {
+        fprintf(stderr, "setup failed: %s\n", uc_strerror(err));
+        if (*uc) uc_close(*uc);
+        *uc = NULL;
+        return 0;
+    }
+    return 1;
+}
+
+static int test_architectural_state(void)
+{
+    static const unsigned char code[] =
+    {
+        0xf3, 0x90,                         /* pause */
+        0x48, 0xb8, 0x78, 0x56, 0x34, 0x12,
+        0xef, 0xcd, 0xab, 0x09,             /* mov $0x09abcdef12345678,%rax */
+        0xf3, 0x90,                         /* pause */
+    };
+    const uint64_t expected = UINT64_C(0x09abcdef12345678);
+    uint64_t rax = 0, rip = 0, eflags = UINT64_C(0x246);
+    uc_engine *uc = NULL;
+    uc_err err;
+
+    if (!setup_engine(&uc, code, sizeof(code))) return 0;
+    if ((err = uc_reg_write(uc, UC_X86_REG_EFLAGS, &eflags)) ||
+        (err = uc_emu_start(uc, ADDRESS, ADDRESS + sizeof(code), 0, 0)) ||
+        (err = uc_reg_read(uc, UC_X86_REG_RAX, &rax)) ||
+        (err = uc_reg_read(uc, UC_X86_REG_RIP, &rip)) ||
+        (err = uc_reg_read(uc, UC_X86_REG_EFLAGS, &eflags)))
+    {
+        fprintf(stderr, "architectural-state run failed: %s\n",
+                uc_strerror(err));
+        uc_close(uc);
+        return 0;
+    }
+    uc_close(uc);
+    if (rax != expected || rip != ADDRESS + sizeof(code) || eflags != 0x246)
+    {
+        fprintf(stderr, "PAUSE changed state: rax=%#llx rip=%#llx flags=%#llx\n",
+                (unsigned long long)rax, (unsigned long long)rip,
+                (unsigned long long)eflags);
+        return 0;
+    }
+    return 1;
+}
+
+static int test_instruction_count(void)
+{
+    static const unsigned char code[] =
+    {
+        0xf3, 0x90,                         /* pause */
+        0x48, 0xff, 0xc0,                   /* inc %rax */
+        0xeb, 0xf9,                         /* jmp ADDRESS */
+    };
+    uint64_t rax = 0;
+    uc_engine *uc = NULL;
+    uc_err err;
+
+    if (!setup_engine(&uc, code, sizeof(code))) return 0;
+    if ((err = uc_emu_start(uc, ADDRESS, UINT64_MAX, 0, 3000)) ||
+        (err = uc_reg_read(uc, UC_X86_REG_RAX, &rax)))
+    {
+        fprintf(stderr, "counted PAUSE loop failed: %s\n", uc_strerror(err));
+        uc_close(uc);
+        return 0;
+    }
+    uc_close(uc);
+    if (rax != 1000)
+    {
+        fprintf(stderr, "counted PAUSE loop produced rax=%llu\n",
+                (unsigned long long)rax);
+        return 0;
+    }
+    return 1;
+}
+
+static int test_prestart_instruction_boundary_stop(void)
+{
+    static const unsigned char code[] =
+    {
+        0xf3, 0x90,                         /* pause */
+        0x48, 0xff, 0xc0,                   /* inc %rax */
+        0xeb, 0xf9,                         /* jmp ADDRESS */
+    };
+    uint64_t rax = 0, rip = 0;
+    uc_engine *uc = NULL;
+    uc_err err;
+
+    if (!setup_engine(&uc, code, sizeof(code))) return 0;
+    if ((err = uc_emu_stop_at_instruction_boundary(uc)) ||
+        (err = uc_emu_start(uc, ADDRESS, UINT64_MAX, 20000, 0)) ||
+        (err = uc_reg_read(uc, UC_X86_REG_RAX, &rax)) ||
+        (err = uc_reg_read(uc, UC_X86_REG_RIP, &rip)))
+    {
+        fprintf(stderr, "prestart boundary stop failed: %s\n",
+                uc_strerror(err));
+        uc_close(uc);
+        return 0;
+    }
+    uc_close(uc);
+    if (rax || rip != ADDRESS)
+    {
+        fprintf(stderr,
+                "prestart boundary stop was lost: rax=%llu rip=%#llx\n",
+                (unsigned long long)rax, (unsigned long long)rip);
+        return 0;
+    }
+    return 1;
+}
+
+static int test_clear_prestart_instruction_boundary_stop(void)
+{
+    static const unsigned char code[] =
+    {
+        0xf3, 0x90,                         /* pause */
+        0x48, 0xff, 0xc0,                   /* inc %rax */
+        0xeb, 0xf9,                         /* jmp ADDRESS */
+    };
+    uint64_t rax = 0;
+    uc_engine *uc = NULL;
+    uc_err err;
+
+    if (!setup_engine(&uc, code, sizeof(code))) return 0;
+    /* Complete one lease first: before the first uc_emu_start(), Unicorn's
+     * emulation_done state intentionally cannot distinguish idle from active. */
+    if ((err = uc_emu_start(uc, ADDRESS, UINT64_MAX, 0, 3)) ||
+        (err = uc_reg_write(uc, UC_X86_REG_RAX, &rax)) ||
+        (err = uc_emu_stop_at_instruction_boundary(uc)) ||
+        (err = uc_clear_instruction_boundary_stop(uc)) ||
+        (err = uc_emu_start(uc, ADDRESS, UINT64_MAX, 0, 3)) ||
+        (err = uc_reg_read(uc, UC_X86_REG_RAX, &rax)))
+    {
+        fprintf(stderr, "prestart boundary-stop clear failed: %s\n",
+                uc_strerror(err));
+        uc_close(uc);
+        return 0;
+    }
+    uc_close(uc);
+    if (rax != 1)
+    {
+        fprintf(stderr, "cleared boundary stop still escaped: rax=%llu\n",
+                (unsigned long long)rax);
+        return 0;
+    }
+    return 1;
+}
+
+static void *run_pause_loop(void *argument)
+{
+    struct stop_state *state = argument;
+
+    atomic_store_explicit(&state->started, true, memory_order_release);
+    state->result = uc_emu_start(state->uc, ADDRESS, UINT64_MAX, 0, 0);
+    atomic_store_explicit(&state->finished, true, memory_order_release);
+    return NULL;
+}
+
+static int wait_for_finished(struct stop_state *state, int seconds)
+{
+    const struct timespec delay = {.tv_nsec = 1000000};
+    struct timespec start, now;
+
+    clock_gettime(CLOCK_MONOTONIC, &start);
+    do
+    {
+        if (atomic_load_explicit(&state->finished, memory_order_acquire))
+            return 1;
+        nanosleep(&delay, NULL);
+        clock_gettime(CLOCK_MONOTONIC, &now);
+    } while (now.tv_sec - start.tv_sec < seconds);
+    return 0;
+}
+
+static int test_instruction_boundary_stop_no_hook(void)
+{
+    static const unsigned char code[] =
+    {
+        0x48, 0xbf, 0x00, 0x10, 0x10, 0x00,
+        0x00, 0x00, 0x00, 0x00,             /* mov $DATA_ADDRESS,%rdi */
+        0x31, 0xc0,                         /* xor %eax,%eax */
+        0x31, 0xd2,                         /* xor %edx,%edx */
+        0x31, 0xdb,                         /* xor %ebx,%ebx */
+        0x31, 0xc9,                         /* xor %ecx,%ecx */
+        0xf0, 0x48, 0x0f, 0xc7, 0x0f,       /* lock cmpxchg16b (%rdi) */
+        0xf3, 0x90,                         /* pause */
+        0xeb, 0xf7,                         /* jmp to cmpxchg16b */
+    };
+    struct timespec delay = {.tv_nsec = 2000000};
+    struct stop_state state = {0};
+    unsigned char data[16] = {0};
+    pthread_t thread;
+    uint64_t rip = 0;
+    uc_err err;
+    int ret;
+
+    if (!setup_engine(&state.uc, code, sizeof(code))) return 0;
+    if ((err = uc_mem_map(state.uc, DATA_ADDRESS, 0x1000,
+                          UC_PROT_READ | UC_PROT_WRITE)) ||
+        (err = uc_mem_write(state.uc, DATA_ADDRESS, data, sizeof(data))))
+    {
+        fprintf(stderr, "boundary-stop data setup failed: %s\n",
+                uc_strerror(err));
+        uc_close(state.uc);
+        return 0;
+    }
+    if ((ret = pthread_create(&thread, NULL, run_pause_loop, &state)))
+    {
+        fprintf(stderr, "boundary-stop runner creation failed: %d\n", ret);
+        uc_close(state.uc);
+        return 0;
+    }
+    while (!atomic_load_explicit(&state.started, memory_order_acquire))
+        ;
+    nanosleep(&delay, NULL);
+    err = uc_clear_instruction_boundary_stop(state.uc);
+    if (err != UC_ERR_RESOURCE)
+    {
+        fprintf(stderr, "live boundary-stop clear returned %s\n",
+                uc_strerror(err));
+        uc_emu_stop(state.uc);
+        pthread_join(thread, NULL);
+        uc_close(state.uc);
+        return 0;
+    }
+    if ((err = uc_emu_stop_at_instruction_boundary(state.uc)))
+    {
+        fprintf(stderr, "instruction-boundary stop request failed: %s\n",
+                uc_strerror(err));
+        uc_emu_stop(state.uc);
+        pthread_join(thread, NULL);
+        uc_close(state.uc);
+        return 0;
+    }
+    if (!wait_for_finished(&state, 2))
+    {
+        fprintf(stderr, "no-hook CMPXCHG16B/PAUSE loop ignored boundary stop\n");
+        uc_emu_stop(state.uc);
+        pthread_join(thread, NULL);
+        uc_close(state.uc);
+        return 0;
+    }
+    pthread_join(thread, NULL);
+    if (state.result ||
+        (err = uc_reg_read(state.uc, UC_X86_REG_RIP, &rip)) ||
+        (err = uc_mem_read(state.uc, DATA_ADDRESS, data, sizeof(data))))
+    {
+        fprintf(stderr, "boundary-stopped loop failed: %s result=%s\n",
+                uc_strerror(err), uc_strerror(state.result));
+        uc_close(state.uc);
+        return 0;
+    }
+    uc_close(state.uc);
+    if (rip != ADDRESS + 18)
+    {
+        fprintf(stderr, "boundary stop returned invalid RIP %#llx\n",
+                (unsigned long long)rip);
+        return 0;
+    }
+    for (size_t i = 0; i < sizeof(data); ++i)
+    {
+        if (data[i])
+        {
+            fprintf(stderr, "CMPXCHG16B loop changed data byte %zu\n", i);
+            return 0;
+        }
+    }
+    return 1;
+}
+
+static int test_cross_thread_stop(void)
+{
+    static const unsigned char code[] =
+    {
+        0xf3, 0x90,                         /* pause */
+        0x48, 0xff, 0xc0,                   /* inc %rax */
+        0xeb, 0xf9,                         /* jmp ADDRESS */
+    };
+    struct timespec delay = {.tv_nsec = 2000000};
+    struct stop_state state = {0};
+    pthread_t thread;
+    uint64_t rax;
+    uc_err err;
+    int i, ret = 0;
+
+    if (!setup_engine(&state.uc, code, sizeof(code))) return 0;
+    for (i = 0; i < STOP_REPETITIONS; ++i)
+    {
+        rax = 0;
+        state.result = UC_ERR_OK;
+        atomic_store_explicit(&state.started, false, memory_order_relaxed);
+        atomic_store_explicit(&state.finished, false, memory_order_relaxed);
+        if ((err = uc_reg_write(state.uc, UC_X86_REG_RAX, &rax)) ||
+            (ret = pthread_create(&thread, NULL, run_pause_loop, &state)))
+        {
+            fprintf(stderr, "stop setup failed: %s pthread=%d\n",
+                    uc_strerror(err), ret);
+            uc_close(state.uc);
+            return 0;
+        }
+        while (!atomic_load_explicit(&state.started, memory_order_acquire))
+            ;
+        nanosleep(&delay, NULL);
+        if ((err = uc_emu_stop(state.uc)))
+        {
+            fprintf(stderr, "cross-thread stop failed: %s\n", uc_strerror(err));
+            uc_close(state.uc);
+            return 0;
+        }
+        pthread_join(thread, NULL);
+        if (state.result ||
+            (err = uc_reg_read(state.uc, UC_X86_REG_RAX, &rax)) || !rax)
+        {
+            fprintf(stderr, "stopped PAUSE loop failed: %s result=%s rax=%llu\n",
+                    uc_strerror(err), uc_strerror(state.result),
+                    (unsigned long long)rax);
+            uc_close(state.uc);
+            return 0;
+        }
+    }
+    uc_close(state.uc);
+    return 1;
+}
+
+int main(void)
+{
+    alarm(TIMEOUT_SECONDS * 3);
+    if (!test_architectural_state() || !test_instruction_count() ||
+        !test_prestart_instruction_boundary_stop() ||
+        !test_clear_prestart_instruction_boundary_stop() ||
+        !test_instruction_boundary_stop_no_hook() ||
+        !test_cross_thread_stop())
+        return 1;
+    alarm(0);
+    puts("x86 PAUSE preserved state, instruction counting, and threaded stop");
+    return 0;
+}
diff --git a/uc.c b/uc.c
index 75b89a0176b4e89fdde43e3d26ce5af9a2b6adef..4d39417b5b892e30fca5b32b9c83c14fa62eafc2 100644
--- a/uc.c
+++ b/uc.c
@@ -29,18 +29,420 @@
 
 #include "qemu/include/tcg/tcg-apple-jit.h"
 #include "qemu/include/qemu/queue.h"
+#include "qemu/include/qemu/processor.h"
 #include "qemu-common.h"
 
 static void clear_deleted_hooks(uc_engine *uc);
 static uc_err uc_snapshot(uc_engine *uc);
 static uc_err uc_restore_latest_snapshot(uc_engine *uc);
 
+bool parallel_cpus;
+static uc_engine *shared_atomic_engines;
+static uc_engine *shared_atomic_owner;
+static int shared_atomic_registry_lock;
+static uint8_t shared_code_next_owner;
+
+#if defined(__APPLE__) && defined(HAVE_PTHREAD_JIT_PROTECT) &&                 \
+    (defined(__arm__) || defined(__aarch64__))
+__thread bool jit_thread_executable_cache;
+__thread bool jit_thread_executable_valid;
+#endif
+
+static void shared_atomic_registry_acquire(void)
+{
+    while (atomic_cmpxchg(&shared_atomic_registry_lock, 0, 1)) cpu_relax();
+}
+
+static void shared_atomic_registry_release(void)
+{
+    atomic_xchg(&shared_atomic_registry_lock, 0);
+}
+
+static void shared_atomic_registry_acquire_running(uc_engine *uc);
+
+static void shared_mapping_registry_enter(uc_engine *uc)
+{
+    if (!atomic_read(&uc->shared_memory_atomics)) return;
+    if (!uc->shared_mapping_registry_depth++)
+        shared_atomic_registry_acquire_running(uc);
+}
+
+static void shared_mapping_registry_leave(uc_engine *uc)
+{
+    if (!atomic_read(&uc->shared_memory_atomics)) return;
+    g_assert(uc->shared_mapping_registry_depth);
+    if (!--uc->shared_mapping_registry_depth)
+        shared_atomic_registry_release();
+}
+
+static void shared_atomic_registry_acquire_running(uc_engine *uc)
+{
+    uc_engine *owner;
+    /* Mapping APIs also use this path while an engine is idle.  Quiescing for
+     * an existing owner must restore the caller's state, not manufacture an
+     * execution participant that no thread can later clear. */
+    bool was_running = atomic_read(&uc->shared_atomic_running);
+
+    for (;;) {
+        while ((owner = atomic_read(&shared_atomic_owner)) && owner != uc) {
+            if (was_running)
+                atomic_xchg(&uc->shared_atomic_running, false);
+            while (atomic_read(&shared_atomic_owner)) cpu_relax();
+            if (was_running)
+                atomic_xchg(&uc->shared_atomic_running, true);
+        }
+        if (atomic_cmpxchg(&shared_atomic_registry_lock, 0, 1)) {
+            cpu_relax();
+            continue;
+        }
+        owner = atomic_read(&shared_atomic_owner);
+        if (!owner || owner == uc) return;
+        shared_atomic_registry_release();
+    }
+}
+
+static void register_shared_executable_range_locked(uc_engine *uc,
+                                                     uint64_t address,
+                                                     uint64_t size,
+                                                     uint32_t perms)
+{
+    uint64_t first, last, limit, page;
+
+    if (!uc->identity_memory_page_flags || !(perms & UC_PROT_EXEC) || !size ||
+        uc->identity_memory_address_bits >= 64 ||
+        uc->identity_memory_address_bits <= UC_SWITCHYARD_IDENTITY_PAGE_SHIFT ||
+        address > UINT64_MAX - (size - 1))
+        return;
+    limit = UINT64_C(1) << uc->identity_memory_address_bits;
+    if (address >= limit || size > limit - address) return;
+    first = address >> UC_SWITCHYARD_IDENTITY_PAGE_SHIFT;
+    last = (address + size - 1) >> UC_SWITCHYARD_IDENTITY_PAGE_SHIFT;
+    for (page = first; page <= last; ++page) {
+        uint8_t old = __atomic_load_n(&uc->identity_memory_page_flags[page],
+                                      __ATOMIC_RELAXED);
+        uint8_t owner = old & UC_SWITCHYARD_IDENTITY_PAGE_OWNER_MASK;
+        uint8_t replacement = old;
+
+        if (!owner)
+            replacement = (old & ~UC_SWITCHYARD_IDENTITY_PAGE_OWNER_MASK) |
+                          uc->shared_code_page_owner;
+        else if (owner != uc->shared_code_page_owner)
+            replacement = (old & ~UC_SWITCHYARD_IDENTITY_PAGE_OWNER_MASK) |
+                          UC_SWITCHYARD_IDENTITY_PAGE_OWNER_SHARED;
+        if (replacement != old)
+            __atomic_store_n(&uc->identity_memory_page_flags[page], replacement,
+                             __ATOMIC_RELAXED);
+    }
+}
+
+static bool shared_code_range_is_private_locked(uc_engine *uc,
+                                                uint64_t address,
+                                                size_t size)
+{
+    uint64_t first, last, limit, page;
+
+    if (!uc->identity_memory_page_flags || !size ||
+        !uc->shared_code_page_owner ||
+        uc->shared_code_page_owner == UC_SWITCHYARD_IDENTITY_PAGE_OWNER_SHARED ||
+        uc->identity_memory_address_bits >= 64 ||
+        uc->identity_memory_address_bits <= UC_SWITCHYARD_IDENTITY_PAGE_SHIFT ||
+        address > UINT64_MAX - (size - 1))
+        return false;
+    limit = UINT64_C(1) << uc->identity_memory_address_bits;
+    if (address >= limit || size > limit - address) return false;
+    first = address >> UC_SWITCHYARD_IDENTITY_PAGE_SHIFT;
+    last = (address + size - 1) >> UC_SWITCHYARD_IDENTITY_PAGE_SHIFT;
+    for (page = first; page <= last; ++page) {
+        uint8_t flags = __atomic_load_n(&uc->identity_memory_page_flags[page],
+                                        __ATOMIC_RELAXED);
+
+        if ((flags & UC_SWITCHYARD_IDENTITY_PAGE_OWNER_MASK) !=
+            uc->shared_code_page_owner)
+            return false;
+    }
+    return true;
+}
+
+static void register_shared_atomic_engine(uc_engine *uc)
+{
+    shared_atomic_registry_acquire();
+    if (!atomic_read(&uc->shared_memory_atomics)) {
+        unsigned int i;
+
+        if (shared_code_next_owner <
+            (UC_SWITCHYARD_IDENTITY_PAGE_OWNER_SHARED >>
+             UC_SWITCHYARD_IDENTITY_PAGE_OWNER_SHIFT) - 1) {
+            ++shared_code_next_owner;
+            uc->shared_code_page_owner =
+                shared_code_next_owner <<
+                UC_SWITCHYARD_IDENTITY_PAGE_OWNER_SHIFT;
+        } else {
+            uc->shared_code_page_owner =
+                UC_SWITCHYARD_IDENTITY_PAGE_OWNER_SHARED;
+        }
+        uc->shared_atomic_next = shared_atomic_engines;
+        shared_atomic_engines = uc;
+        atomic_xchg(&uc->shared_memory_atomics, true);
+        for (i = 0; i < uc->mapped_block_count; ++i) {
+            MemoryRegion *mr = uc->mapped_blocks[i];
+
+            if (mr && mr->ram)
+                register_shared_executable_range_locked(
+                    uc, mr->addr, int128_get64(mr->size), mr->perms);
+        }
+    }
+    shared_atomic_registry_release();
+}
+
+static void unregister_shared_atomic_engine(uc_engine *uc)
+{
+    uc_engine **link;
+
+    if (!atomic_read(&uc->shared_memory_atomics)) return;
+    shared_atomic_registry_acquire();
+    for (link = &shared_atomic_engines; *link; link = &(*link)->shared_atomic_next) {
+        if (*link != uc) continue;
+        *link = uc->shared_atomic_next;
+        uc->shared_atomic_next = NULL;
+        atomic_xchg(&uc->shared_memory_atomics, false);
+        break;
+    }
+    shared_atomic_registry_release();
+}
+
+bool uc_shared_atomic_enter(uc_engine *uc)
+{
+    uc_engine *owner;
+
+    if (!atomic_read(&uc->shared_memory_atomics)) return true;
+    for (;;) {
+        while ((owner = atomic_read(&shared_atomic_owner)) && owner != uc) {
+            if (uc_stop_requested(uc)) return false;
+            cpu_relax();
+        }
+        uc_set_shared_pause_request(uc, false);
+        atomic_xchg(&uc->shared_atomic_running, true);
+        owner = atomic_read(&shared_atomic_owner);
+        if (!owner || owner == uc) return true;
+        atomic_xchg(&uc->shared_atomic_running, false);
+    }
+}
+
+void uc_shared_atomic_leave(uc_engine *uc)
+{
+    if (atomic_read(&uc->shared_memory_atomics))
+        atomic_xchg(&uc->shared_atomic_running, false);
+}
+
+bool uc_shared_atomic_begin_exclusive(uc_engine *uc)
+{
+    uc_engine *engine, *owner;
+    bool pending;
+    /* Code-management APIs can enter exclusion outside uc_emu_start(). */
+    bool was_running = atomic_read(&uc->shared_memory_atomics) &&
+                       atomic_read(&uc->shared_atomic_running);
+
+    if (atomic_read(&shared_atomic_owner) == uc) {
+        g_assert(uc->shared_exclusive_depth);
+        ++uc->shared_exclusive_depth;
+        return true;
+    }
+
+    for (;;) {
+        while ((owner = atomic_read(&shared_atomic_owner)) && owner != uc) {
+            if (was_running)
+                atomic_xchg(&uc->shared_atomic_running, false);
+            while (atomic_read(&shared_atomic_owner)) {
+                if (uc_stop_requested(uc)) {
+                    if (was_running)
+                        atomic_xchg(&uc->shared_atomic_running, true);
+                    return false;
+                }
+                cpu_relax();
+            }
+            if (was_running)
+                atomic_xchg(&uc->shared_atomic_running, true);
+        }
+        if (atomic_cmpxchg(&shared_atomic_registry_lock, 0, 1)) {
+            cpu_relax();
+            continue;
+        }
+        owner = atomic_cmpxchg(&shared_atomic_owner, NULL, uc);
+        if (!owner) break;
+        shared_atomic_registry_release();
+        if (was_running)
+            atomic_xchg(&uc->shared_atomic_running, false);
+        while (atomic_read(&shared_atomic_owner)) {
+            if (uc_stop_requested(uc)) {
+                if (was_running)
+                    atomic_xchg(&uc->shared_atomic_running, true);
+                return false;
+            }
+            cpu_relax();
+        }
+        if (was_running)
+            atomic_xchg(&uc->shared_atomic_running, true);
+    }
+
+    for (engine = shared_atomic_engines; engine;
+         engine = engine->shared_atomic_next) {
+        if (engine != uc && atomic_read(&engine->shared_atomic_running)) {
+            uc_set_shared_pause_request(engine, true);
+            cpu_exit(engine->cpu);
+        }
+    }
+    do {
+        pending = false;
+        for (engine = shared_atomic_engines; engine;
+             engine = engine->shared_atomic_next) {
+            if (engine != uc && atomic_read(&engine->shared_atomic_running)) {
+                pending = true;
+                cpu_relax();
+                break;
+            }
+        }
+    } while (pending);
+    shared_atomic_registry_release();
+    uc->shared_exclusive_depth = 1;
+    return true;
+}
+
+void uc_shared_atomic_end_exclusive(uc_engine *uc)
+{
+    g_assert(atomic_read(&shared_atomic_owner) == uc);
+    g_assert(uc->shared_exclusive_depth);
+    if (--uc->shared_exclusive_depth) return;
+    g_assert(atomic_cmpxchg(&shared_atomic_owner, uc, NULL) == uc);
+}
+
+void uc_shared_atomic_abort_exclusive(uc_engine *uc)
+{
+    bool trace_reentry = uc->shared_memory_atomic_trace_open;
+
+    uc->shared_memory_atomic_trace_open = false;
+    if (uc->shared_code_private_write_active) {
+        uc->shared_code_private_write_active = false;
+        shared_atomic_registry_release();
+    }
+    uc->shared_code_write_active = false;
+    uc->shared_code_translation_active = false;
+    uc->shared_exclusive_depth = 0;
+    atomic_cmpxchg(&shared_atomic_owner, uc, NULL);
+    if (trace_reentry) {
+        JIT_CALLBACK_GUARD(uc->shared_memory_atomic_callback(
+            uc, UC_SHARED_MEMORY_ATOMIC_REENTRY,
+            uc->shared_memory_atomic_user_data));
+    }
+}
+
+static bool shared_executable_mapping(uc_engine *uc, uint64_t address,
+                                      size_t size, bool require_write,
+                                      void **host_address)
+{
+    MemoryRegion *mr;
+    uint64_t offset, region_size;
+
+    if (!size || !(mr = uc->memory_mapping(uc, address)) || !mr->ram ||
+        !(mr->perms & UC_PROT_EXEC) ||
+        (require_write && !(mr->perms & UC_PROT_WRITE)) ||
+        address < mr->addr)
+        return false;
+    offset = address - mr->addr;
+    region_size = int128_get64(mr->size);
+    if (offset > region_size || size > region_size - offset) return false;
+    if (host_address)
+        *host_address = mr->ram_block->host + offset;
+    return true;
+}
+
+bool uc_shared_code_translation_begin(uc_engine *uc, uint64_t address,
+                                      size_t size)
+{
+    bool writable;
+
+    writable = shared_executable_mapping(uc, address, 1, true, NULL);
+    if (!writable && size && address <= UINT64_MAX - (size - 1))
+        writable = shared_executable_mapping(uc, address + size - 1, 1,
+                                             true, NULL);
+    if (!atomic_read(&uc->shared_memory_atomics) ||
+        !writable)
+        return false;
+    g_assert(!uc->shared_code_translation_active);
+    if (!uc_shared_atomic_begin_exclusive(uc)) return false;
+    uc->shared_code_translation_active = true;
+    return true;
+}
+
+void uc_shared_code_translation_end(uc_engine *uc)
+{
+    if (!uc->shared_code_translation_active) return;
+    uc->shared_code_translation_active = false;
+    uc_shared_atomic_end_exclusive(uc);
+}
+
+void uc_shared_code_write_begin(uc_engine *uc, uint64_t address, size_t size,
+                                void *host_address)
+{
+    uc_engine *engine;
+    size_t private_size;
+
+    if (!atomic_read(&uc->shared_memory_atomics) || !host_address || !size)
+        return;
+
+    /* Slow unaligned stores recurse through byte helpers and defer the single
+     * completion callback until the outer store returns.  The first byte owns
+     * the private transaction and has already checked the complete range, so
+     * recursive bytes must not reacquire the non-recursive registry lock. */
+    if (uc->shared_code_private_write_active)
+        return;
+
+    if (!uc->shared_code_write_active) {
+        private_size = uc->size_recur_mem > 0 ?
+            (size_t)uc->size_recur_mem : size;
+        shared_atomic_registry_acquire_running(uc);
+        if (shared_code_range_is_private_locked(uc, address, private_size)) {
+            g_assert(!uc->shared_code_private_write_active);
+            uc->shared_code_private_write_active = true;
+            return;
+        }
+        shared_atomic_registry_release();
+        if (!uc_shared_atomic_begin_exclusive(uc)) return;
+        uc->shared_code_write_active = true;
+    }
+
+    shared_atomic_registry_acquire();
+    for (engine = shared_atomic_engines; engine;
+         engine = engine->shared_atomic_next) {
+        void *other_host = NULL;
+
+        if (engine == uc ||
+            !shared_executable_mapping(engine, address, size, false,
+                                       &other_host) ||
+            other_host != host_address)
+            continue;
+        engine->uc_invalidate_tb_host(engine, other_host, size);
+    }
+    shared_atomic_registry_release();
+}
+
+void uc_shared_code_write_end(uc_engine *uc)
+{
+    if (uc->shared_code_private_write_active) {
+        uc->shared_code_private_write_active = false;
+        shared_atomic_registry_release();
+        return;
+    }
+    if (!uc->shared_code_write_active) return;
+    uc->shared_code_write_active = false;
+    uc_shared_atomic_end_exclusive(uc);
+}
