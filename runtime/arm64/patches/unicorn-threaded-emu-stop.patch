+    context->r9 = env->regs[R_R9];
+    context->r10 = env->regs[R_R10];
+    context->r11 = env->regs[R_R11];
+    context->r12 = env->regs[R_R12];
+    context->r13 = env->regs[R_R13];
+    context->r14 = env->regs[R_R14];
