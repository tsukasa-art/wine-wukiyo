diff --git a/tests/regress/aarch64_rotl_zero.c b/tests/regress/aarch64_rotl_zero.c
new file mode 100644
index 0000000000000000000000000000000000000000..c5883e746a014ba3ca8c7858c4f80708a67e6092
--- /dev/null
+++ b/tests/regress/aarch64_rotl_zero.c
@@ -0,0 +1,118 @@
+#include <inttypes.h>
+#include <stdint.h>
+#include <stdio.h>
+#include <string.h>
+
+#include <unicorn/unicorn.h>
+#include <unicorn/x86.h>
+
+#define CODE_ADDRESS 0x1000000ULL
+#define MAP_SIZE 0x1000ULL
+
+static int run_i32(unsigned int count, uint32_t expected)
+{
+    static const uint8_t code[] =
+    {
+        0xb8, 0x78, 0x56, 0x34, 0x12,       /* mov $0x12345678,%eax */
+        0xb9, 0x00, 0x00, 0x00, 0x00,       /* mov $count,%ecx */
+        0xd3, 0xc0,                         /* rol %cl,%eax */
+    };
+    uint8_t instance[sizeof(code)];
+    uint32_t eax = 0, eflags = 0x202;
+    uc_engine *uc = NULL;
+    uc_err err;
+
+    if (count > UINT8_MAX)
+    {
+        fprintf(stderr, "invalid i32 count %u\n", count);
+        return 1;
+    }
+    memcpy(instance, code, sizeof(instance));
+    instance[6] = (uint8_t)count;
+
+    if ((err = uc_open(UC_ARCH_X86, UC_MODE_32, &uc)) ||
+        (err = uc_mem_map(uc, CODE_ADDRESS, MAP_SIZE, UC_PROT_ALL)) ||
+        (err = uc_mem_write(uc, CODE_ADDRESS, instance, sizeof(instance))) ||
+        (err = uc_reg_write(uc, UC_X86_REG_EFLAGS, &eflags)) ||
+        (err = uc_emu_start(uc, CODE_ADDRESS, CODE_ADDRESS + sizeof(instance),
+                            0, 0)) ||
+        (err = uc_reg_read(uc, UC_X86_REG_EAX, &eax)) ||
+        (err = uc_reg_read(uc, UC_X86_REG_EFLAGS, &eflags)))
+    {
+        fprintf(stderr, "i32 count %u failed: %s\n", count,
+                uc_strerror(err));
+        if (uc) uc_close(uc);
+        return 1;
+    }
+    uc_close(uc);
+
+    if (eax != expected || (count == 0 && eflags != 0x202))
+    {
+        fprintf(stderr, "i32 count %u produced eax %#" PRIx32
+                " eflags %#" PRIx32 " (expected %#" PRIx32 ")\n",
+                count, eax, eflags, expected);
+        return 1;
+    }
+    return 0;
+}
+
+static int run_i64(unsigned int count, uint64_t expected)
+{
+    static const uint8_t code[] =
+    {
+        0x48, 0xb8, 0xef, 0xcd, 0xab, 0x89,
+        0x67, 0x45, 0x23, 0x01,             /* mov $0x0123456789abcdef,%rax */
+        0xb9, 0x00, 0x00, 0x00, 0x00,       /* mov $count,%ecx */
+        0x48, 0xd3, 0xc0,                   /* rol %cl,%rax */
+    };
+    uint8_t instance[sizeof(code)];
+    uint64_t rax = 0;
+    uint32_t eflags = 0x202;
+    uc_engine *uc = NULL;
+    uc_err err;
+
+    if (count > UINT8_MAX)
+    {
+        fprintf(stderr, "invalid i64 count %u\n", count);
+        return 1;
+    }
+    memcpy(instance, code, sizeof(instance));
+    instance[11] = (uint8_t)count;
+
+    if ((err = uc_open(UC_ARCH_X86, UC_MODE_64, &uc)) ||
+        (err = uc_mem_map(uc, CODE_ADDRESS, MAP_SIZE, UC_PROT_ALL)) ||
+        (err = uc_mem_write(uc, CODE_ADDRESS, instance, sizeof(instance))) ||
+        (err = uc_reg_write(uc, UC_X86_REG_EFLAGS, &eflags)) ||
+        (err = uc_emu_start(uc, CODE_ADDRESS, CODE_ADDRESS + sizeof(instance),
+                            0, 0)) ||
+        (err = uc_reg_read(uc, UC_X86_REG_RAX, &rax)) ||
+        (err = uc_reg_read(uc, UC_X86_REG_EFLAGS, &eflags)))
+    {
+        fprintf(stderr, "i64 count %u failed: %s\n", count,
+                uc_strerror(err));
+        if (uc) uc_close(uc);
+        return 1;
+    }
+    uc_close(uc);
+
+    if (rax != expected || (count == 0 && eflags != 0x202))
+    {
+        fprintf(stderr, "i64 count %u produced rax %#" PRIx64
+                " eflags %#" PRIx32 " (expected %#" PRIx64 ")\n",
+                count, rax, eflags, expected);
+        return 1;
+    }
+    return 0;
+}
+
+int main(void)
+{
+    if (run_i32(0, UINT32_C(0x12345678)) ||
+        run_i32(1, UINT32_C(0x2468acf0)) ||
+        run_i64(0, UINT64_C(0x0123456789abcdef)) ||
+        run_i64(1, UINT64_C(0x02468acf13579bde)))
+        return 1;
+
+    puts("AArch64 TCG emitted valid zero-count i32 and i64 rotations");
+    return 0;
+}
diff --git a/tests/regress/apple_jit_state.c b/tests/regress/apple_jit_state.c
new file mode 100644
index 0000000000000000000000000000000000000000..5942412d800689526cdf7dafef711b93c317d687
--- /dev/null
+++ b/tests/regress/apple_jit_state.c
@@ -0,0 +1,78 @@
+/* Verify Apple MAP_JIT guards preserve the calling thread's real permission
+ * mode even when an engine-owned diagnostic cache is stale. */
+
+#define _DARWIN_C_SOURCE
+
+#include <pthread.h>
+#include <stdbool.h>
+#include <stdio.h>
+
+#include "qemu/include/tcg/tcg-apple-jit.h"
+
+struct mock_engine
+{
+    bool current_executable;
+};
+
+#if defined(__APPLE__) && defined(__aarch64__) &&                             \
+    defined(HAVE_PTHREAD_JIT_PROTECT)
+__thread bool jit_thread_executable_cache;
+__thread bool jit_thread_executable_valid;
+#endif
+
+int main(void)
+{
+#if defined(__APPLE__) && defined(__aarch64__) &&                         \
+    defined(HAVE_PTHREAD_JIT_PROTECT)
+    struct mock_engine engine;
+    struct mock_engine *uc = &engine;
+    bool entry, actual;
+    int value = 0;
+
+    if (!pthread_jit_write_protect_supported_np())
+    {
+        puts("Apple JIT state unavailable; skipped");
+        return 0;
+    }
+
+    entry = thread_executable();
+    jit_thread_executable_valid = false;
+
+    jit_write_protect(false);
+    uc->current_executable = true;
+    JIT_CALLBACK_GUARD((void)0);
+    actual = thread_executable();
+    if (actual || uc->current_executable ||
+        !jit_thread_executable_valid || jit_thread_executable_cache)
+    {
+        fprintf(stderr,
+                "guard trusted stale executable cache: actual=%d cached=%d\n",
+                actual, uc->current_executable);
+        jit_write_protect(entry);
+        return 1;
+    }
+
+    jit_write_protect(true);
+    uc->current_executable = false;
+    JIT_CALLBACK_GUARD_VAR(value,
+                           (jit_write_protect(false), 42));
+    actual = thread_executable();
+    if (!actual || !uc->current_executable ||
+        !jit_thread_executable_cache || value != 42)
+    {
+        fprintf(stderr,
+                "value guard trusted stale writable cache: actual=%d "
+                "cached=%d value=%d\n",
+                actual, uc->current_executable, value);
+        jit_write_protect(entry);
+        return 1;
+    }
+
+    jit_write_protect(entry);
+    puts("Apple JIT state guards preserved the caller mode");
+    return 0;
+#else
+    puts("Apple JIT state unavailable; skipped");
+    return 0;
+#endif
+}
diff --git a/tests/regress/atomic_unmapped_hook.c b/tests/regress/atomic_unmapped_hook.c
new file mode 100644
index 0000000000000000000000000000000000000000..50043d4ecdb6a65be48d95f56e20f517b8f07cfe
--- /dev/null
+++ b/tests/regress/atomic_unmapped_hook.c
@@ -0,0 +1,142 @@
+/* Test invalid-memory recovery for an atomic read-modify-write operation. */
+
+#define _POSIX_C_SOURCE 200809L
+
+#include <stdbool.h>
+#include <stdint.h>
+#include <stdio.h>
+#include <stdlib.h>
+#include <string.h>
+#include <unistd.h>
+
+#include <unicorn/unicorn.h>
+#include <unicorn/x86.h>
+
+#define CODE_ADDRESS UINT64_C(0x100000)
+#define DATA_ADDRESS UINT64_C(0x200000)
+#define TARGET_ADDRESS (DATA_ADDRESS + 1)
+#define PAGE_SIZE 0x1000
+#define TIMEOUT_SECONDS 5
+
+struct hook_state
+{
+    uint64_t *data;
+    unsigned int calls;
+    uc_err map_error;
+};
+
+static const unsigned char code[] =
+{
+    0x48, 0xb8, 0x01, 0x00, 0x20, 0x00, 0x00, 0x00, 0x00, 0x00,
+    0xf0, 0x48, 0xff, 0x00, /* lock incq (TARGET_ADDRESS) */
+};
+
+static bool map_atomic_target(uc_engine *uc, uc_mem_type type,
+                              uint64_t address, int size, int64_t value,
+                              void *user_data)
+{
+    struct hook_state *state = user_data;
+
+    (void)value;
+    ++state->calls;
+    if (type != UC_MEM_WRITE_UNMAPPED || address != TARGET_ADDRESS || size != 8) {
+        return false;
+    }
+    state->map_error = uc_mem_map_ptr(uc, DATA_ADDRESS, PAGE_SIZE,
+                                      UC_PROT_READ | UC_PROT_WRITE,
+                                      state->data);
+    return state->map_error == UC_ERR_OK;
+}
+
+static uc_err open_test_engine(uc_engine **uc)
+{
+    uc_err err;
+
+    if ((err = uc_open(UC_ARCH_X86, UC_MODE_64, uc)) ||
+        (err = uc_enable_shared_memory_atomics(*uc)) ||
+        (err = uc_mem_map(*uc, CODE_ADDRESS, PAGE_SIZE, UC_PROT_ALL)) ||
+        (err = uc_mem_write(*uc, CODE_ADDRESS, code, sizeof(code)))) {
+        if (*uc) {
+            uc_close(*uc);
+            *uc = NULL;
+        }
+    }
+    return err;
+}
+
+static int test_recover_unmapped_atomic(uint64_t *data)
+{
+    struct hook_state state = {.data = data};
+    uc_engine *uc = NULL;
+    uc_hook hook;
+    uc_err err;
+    int ret = 1;
+
+    uint64_t value = 0;
+
+    memcpy((unsigned char *)data + 1, &value, sizeof(value));
+    if ((err = open_test_engine(&uc)) ||
+        (err = uc_hook_add(uc, &hook, UC_HOOK_MEM_WRITE_UNMAPPED,
+                           map_atomic_target, &state, TARGET_ADDRESS,
+                           TARGET_ADDRESS + sizeof(*data) - 1)) ||
+        (err = uc_emu_start(uc, CODE_ADDRESS, CODE_ADDRESS + sizeof(code),
+                            0, 0))) {
+        fprintf(stderr, "recovering atomic access failed: %s\n",
+                uc_strerror(err));
+        goto done;
+    }
+    memcpy(&value, (unsigned char *)data + 1, sizeof(value));
+    if (value != 1 || state.calls != 1 || state.map_error != UC_ERR_OK) {
+        fprintf(stderr, "atomic recovery mismatch: value %llu, calls %u, "
+                "map error %s\n", (unsigned long long)value, state.calls,
+                uc_strerror(state.map_error));
+        goto done;
+    }
+    ret = 0;
+
+ done:
+    if (uc) uc_close(uc);
+    return ret;
+}
+
+static int test_reject_unhandled_atomic(void)
+{
+    uc_engine *uc = NULL;
+    uc_err err;
+
+    if ((err = open_test_engine(&uc))) {
+        fprintf(stderr, "unhandled atomic setup failed: %s\n",
+                uc_strerror(err));
+        return 1;
+    }
+    err = uc_emu_start(uc, CODE_ADDRESS, CODE_ADDRESS + sizeof(code), 0, 0);
+    uc_close(uc);
+    if (err != UC_ERR_WRITE_UNMAPPED) {
+        fprintf(stderr, "unhandled atomic returned %s\n", uc_strerror(err));
+        return 1;
+    }
+    return 0;
+}
+
+int main(void)
+{
+    uint64_t *data = NULL;
+    int ret = 1;
+
+    alarm(TIMEOUT_SECONDS);
+    if (posix_memalign((void **)&data, PAGE_SIZE, PAGE_SIZE)) {
+        fprintf(stderr, "data allocation failed\n");
+        return 2;
+    }
+    memset(data, 0, PAGE_SIZE);
+    if (test_recover_unmapped_atomic(data) || test_reject_unhandled_atomic()) {
+        goto done;
+    }
+    puts("atomic invalid-memory hook recovery passed");
+    ret = 0;
+
+ done:
+    free(data);
+    alarm(0);
+    return ret;
+}
diff --git a/tests/regress/identity_atomic_fastpath.c b/tests/regress/identity_atomic_fastpath.c
new file mode 100644
index 0000000000000000000000000000000000000000..b10a94bdb69b79666906f8cf7e87c1282cd08192
--- /dev/null
+++ b/tests/regress/identity_atomic_fastpath.c
@@ -0,0 +1,568 @@
+/* Validate permission-gated identity-memory atomic helpers. */
+
+#define _DARWIN_C_SOURCE
+#define _POSIX_C_SOURCE 200809L
+
+#include <pthread.h>
+#include <stdbool.h>
+#include <stdint.h>
+#include <stdio.h>
+#include <stdlib.h>
+#include <string.h>
+#include <sys/mman.h>
+#include <unistd.h>
+
+#include <unicorn/unicorn.h>
+#include <unicorn/x86.h>
+
+#define CODE_ADDRESS UINT64_C(0x100000)
+#define DATA_HINT UINT64_C(0x400000000)
+#define PAGE_SIZE 0x1000
+#define ZF (1u << 6)
+
+struct fixture
+{
+    uint8_t *data;
+    uint8_t *page_flags;
+    size_t page_flags_size;
+    uint32_t address_bits;
+};
+
+struct invalid_hook_state
+{
+    struct fixture *fixture;
+    unsigned int calls;
+    uc_err map_error;
+    uc_mem_type last_type;
+    uint64_t last_address;
+    int last_size;
+};
+
+struct race_barrier
+{
+    pthread_mutex_t mutex;
+    pthread_cond_t cond;
+    unsigned int starters;
+};
+
+struct race_worker
+{
+    uc_engine *uc;
+    struct race_barrier *barrier;
+    uint64_t replacement;
+    uint64_t observed;
+    uint32_t eflags;
+    uc_err result;
+};
+
+struct atomic_trace_state
+{
+    unsigned int exits;
+    unsigned int reentries;
+    bool open;
+    bool order_error;
+};
+
+static const uint8_t cmpxchg16b_code[] =
+{
+    0xf0, 0x48, 0x0f, 0xc7, 0x0f, /* lock cmpxchg16b (%rdi) */
+};
+
+static uint32_t address_width(uint64_t value)
+{
+    uint32_t width = 0;
+
+    do
+    {
+        ++width;
+        value >>= 1;
+    } while (value);
+    return width;
+}
+
+static int fixture_init(struct fixture *fixture)
+{
+    uint64_t highest;
+
+    memset(fixture, 0, sizeof(*fixture));
+    fixture->data = mmap((void *)(uintptr_t)DATA_HINT, PAGE_SIZE,
+                         PROT_READ | PROT_WRITE, MAP_PRIVATE | MAP_ANON,
+                         -1, 0);
+    if (fixture->data == MAP_FAILED)
+    {
+        fixture->data = NULL;
+        perror("data mmap");
+        return 1;
+    }
+    highest = (uint64_t)(uintptr_t)fixture->data + PAGE_SIZE - 1;
+    fixture->address_bits = address_width(highest);
+    if (fixture->address_bits <= UC_SWITCHYARD_IDENTITY_PAGE_SHIFT ||
+        fixture->address_bits >= 56)
+    {
+        fprintf(stderr, "unexpected data address width: %u\n",
+                fixture->address_bits);
+        return 1;
+    }
+    fixture->page_flags_size =
+        (size_t)1 << (fixture->address_bits -
+                     UC_SWITCHYARD_IDENTITY_PAGE_SHIFT);
+    fixture->page_flags = mmap(NULL, fixture->page_flags_size,
+                               PROT_READ | PROT_WRITE,
+                               MAP_PRIVATE | MAP_ANON, -1, 0);
+    if (fixture->page_flags == MAP_FAILED)
+    {
+        fixture->page_flags = NULL;
+        perror("page-flags mmap");
+        return 1;
+    }
+    return 0;
+}
+
+static void fixture_destroy(struct fixture *fixture)
+{
+    if (fixture->page_flags)
+        munmap(fixture->page_flags, fixture->page_flags_size);
+    if (fixture->data) munmap(fixture->data, PAGE_SIZE);
+}
+
+static size_t page_index(const void *address)
+{
+    return (uintptr_t)address >> UC_SWITCHYARD_IDENTITY_PAGE_SHIFT;
+}
+
+static uc_err open_engine(const struct fixture *fixture, uc_engine **uc)
+{
+    uc_err err;
+
+    *uc = NULL;
+    if ((err = uc_open(UC_ARCH_X86, UC_MODE_64, uc)) ||
+        (err = uc_configure_identity_memory_fastpath(
+             *uc, fixture->page_flags, fixture->address_bits)) ||
+        (err = uc_enable_shared_memory_atomics(*uc)))
+    {
+        if (*uc) uc_close(*uc);
+        *uc = NULL;
+    }
+    return err;
+}
+
+static uc_err install_code(uc_engine *uc, const uint8_t *code,
+                           size_t code_size)
+{
+    uc_err err;
+
+    if ((err = uc_mem_map(uc, CODE_ADDRESS, PAGE_SIZE, UC_PROT_ALL)))
+        return err;
+    return uc_mem_write(uc, CODE_ADDRESS, code, code_size);
+}
+
+static uc_err run_cmpxchg16b(uc_engine *uc, void *target,
+                             uint64_t expected_lo, uint64_t expected_hi,
+                             uint64_t replacement_lo,
+                             uint64_t replacement_hi, uint64_t *observed_lo,
+                             uint64_t *observed_hi, uint32_t *eflags)
+{
+    uint64_t rdi = (uintptr_t)target;
+    uc_err err;
+
+    *observed_lo = expected_lo;
+    *observed_hi = expected_hi;
+    *eflags = 2;
+    if ((err = uc_reg_write(uc, UC_X86_REG_RDI, &rdi)) ||
+        (err = uc_reg_write(uc, UC_X86_REG_RAX, observed_lo)) ||
+        (err = uc_reg_write(uc, UC_X86_REG_RDX, observed_hi)) ||
+        (err = uc_reg_write(uc, UC_X86_REG_RBX, &replacement_lo)) ||
+        (err = uc_reg_write(uc, UC_X86_REG_RCX, &replacement_hi)) ||
+        (err = uc_reg_write(uc, UC_X86_REG_EFLAGS, eflags)) ||
+        (err = uc_emu_start(uc, CODE_ADDRESS,
+                            CODE_ADDRESS + sizeof(cmpxchg16b_code), 0, 0)) ||
+        (err = uc_reg_read(uc, UC_X86_REG_RAX, observed_lo)) ||
+        (err = uc_reg_read(uc, UC_X86_REG_RDX, observed_hi)) ||
+        (err = uc_reg_read(uc, UC_X86_REG_EFLAGS, eflags)))
+        return err;
+    return UC_ERR_OK;
+}
+
+static int test_unmapped_identity_success(struct fixture *fixture)
+{
+    static const uint64_t initial[2] =
+    {
+        UINT64_C(0x1122334455667788), UINT64_C(0x99aabbccddeeff00),
+    };
+    static const uint64_t replacement[2] =
+    {
+        UINT64_C(0x0123456789abcdef), UINT64_C(0xfedcba9876543210),
+    };
+    uint64_t observed_lo, observed_hi;
+    uint32_t eflags;
+    uc_engine *uc = NULL;
+    uc_err err;
+
+    memcpy(fixture->data, initial, sizeof(initial));
+    fixture->page_flags[page_index(fixture->data)] =
+        UC_SWITCHYARD_IDENTITY_PAGE_READ |
+        UC_SWITCHYARD_IDENTITY_PAGE_WRITE;
+    if ((err = open_engine(fixture, &uc)) ||
+        (err = install_code(uc, cmpxchg16b_code,
+                            sizeof(cmpxchg16b_code))) ||
+        (err = run_cmpxchg16b(uc, fixture->data, initial[0], initial[1],
+                              replacement[0], replacement[1], &observed_lo,
+                              &observed_hi, &eflags)))
+    {
+        fprintf(stderr, "unmapped identity CMPXCHG16B failed: %s\n",
+                uc_strerror(err));
+        if (uc) uc_close(uc);
+        return 1;
+    }
+    uc_close(uc);
+    if (!(eflags & ZF) || observed_lo != initial[0] ||
+        observed_hi != initial[1] ||
+        memcmp(fixture->data, replacement, sizeof(replacement)))
+    {
+        fprintf(stderr, "unmapped identity CMPXCHG16B mismatch\n");
+        return 1;
+    }
+    return 0;
+}
+
+static int test_read_only_fallback(struct fixture *fixture)
+{
+    static const uint64_t initial[2] = {1, 2};
+    uint64_t observed_lo, observed_hi;
+    uint32_t eflags;
+    uc_engine *uc = NULL;
+    uc_err err;
+
+    memcpy(fixture->data, initial, sizeof(initial));
+    fixture->page_flags[page_index(fixture->data)] =
+        UC_SWITCHYARD_IDENTITY_PAGE_READ;
+    if ((err = open_engine(fixture, &uc)) ||
+        (err = uc_mem_map_ptr(uc, (uintptr_t)fixture->data, PAGE_SIZE,
+                              UC_PROT_READ, fixture->data)) ||
+        (err = install_code(uc, cmpxchg16b_code,
+                            sizeof(cmpxchg16b_code))))
+    {
+        fprintf(stderr, "read-only setup failed: %s\n", uc_strerror(err));
+        if (uc) uc_close(uc);
+        return 1;
+    }
+    err = run_cmpxchg16b(uc, fixture->data, initial[0], initial[1], 3, 4,
+                         &observed_lo, &observed_hi, &eflags);
+    uc_close(uc);
+    if (err != UC_ERR_WRITE_PROT || memcmp(fixture->data, initial,
+                                            sizeof(initial)))
+    {
+        fprintf(stderr, "read-only atomic escaped protection: %s\n",
+                uc_strerror(err));
+        return 1;
+    }
+    return 0;
+}
+
+static bool map_invalid_atomic(uc_engine *uc, uc_mem_type type,
+                               uint64_t address, int size, int64_t value,
+                               void *user_data)
+{
+    struct invalid_hook_state *state = user_data;
+
+    (void)value;
+    ++state->calls;
+    state->last_type = type;
+    state->last_address = address;
+    state->last_size = size;
+    /* x86's page-walk callback reports the first qword of CMPXCHG16B; once
+     * that hook installs the complete page, the 16-byte atomic helper retries
+     * against the new mapping. */
+    if (type != UC_MEM_WRITE_UNMAPPED ||
+        address != (uintptr_t)state->fixture->data || size != 8)
+        return false;
+    state->map_error = uc_mem_map_ptr(
+        uc, (uintptr_t)state->fixture->data, PAGE_SIZE,
+        UC_PROT_READ | UC_PROT_WRITE, state->fixture->data);
+    return state->map_error == UC_ERR_OK;
+}
+
+static int test_invalid_hook_fallback(struct fixture *fixture)
+{
+    static const uint64_t initial[2] = {5, 6};
+    static const uint64_t replacement[2] = {7, 8};
+    struct invalid_hook_state state = {.fixture = fixture};
+    uint64_t observed_lo, observed_hi;
+    uint32_t eflags;
+    uc_engine *uc = NULL;
+    uc_hook hook;
+    uc_err err;
+
+    memcpy(fixture->data, initial, sizeof(initial));
+    fixture->page_flags[page_index(fixture->data)] = 0;
+    if ((err = open_engine(fixture, &uc)) ||
+        (err = uc_hook_add(uc, &hook, UC_HOOK_MEM_WRITE_UNMAPPED,
+                           map_invalid_atomic, &state,
+                           (uintptr_t)fixture->data,
+                           (uintptr_t)fixture->data + PAGE_SIZE - 1)) ||
+        (err = install_code(uc, cmpxchg16b_code,
+                            sizeof(cmpxchg16b_code))) ||
+        (err = run_cmpxchg16b(uc, fixture->data, initial[0], initial[1],
+                              replacement[0], replacement[1], &observed_lo,
+                              &observed_hi, &eflags)))
+    {
+        fprintf(stderr, "invalid-hook atomic fallback failed: %s; calls %u, "
+                "type %d, address %#llx, size %d, map %s\n",
+                uc_strerror(err), state.calls, state.last_type,
+                (unsigned long long)state.last_address, state.last_size,
+                uc_strerror(state.map_error));
+        if (uc) uc_close(uc);
+        return 1;
+    }
+    uc_close(uc);
+    if (state.calls != 1 || state.map_error != UC_ERR_OK ||
+        !(eflags & ZF) || memcmp(fixture->data, replacement,
+                                 sizeof(replacement)))
+    {
+        fprintf(stderr, "invalid-hook atomic fallback mismatch\n");
+        return 1;
+    }
+    return 0;
+}
+
+static void *run_race_worker(void *opaque)
+{
+    struct race_worker *worker = opaque;
+
+    /* The target is installed in RDI by the coordinator; only synchronize
+     * entry here so both engines execute the same host atomic concurrently. */
+    pthread_mutex_lock(&worker->barrier->mutex);
+    ++worker->barrier->starters;
+    pthread_cond_broadcast(&worker->barrier->cond);
+    while (worker->barrier->starters < 2)
+        pthread_cond_wait(&worker->barrier->cond, &worker->barrier->mutex);
+    pthread_mutex_unlock(&worker->barrier->mutex);
+
+    worker->result = uc_emu_start(worker->uc, CODE_ADDRESS,
+                                  CODE_ADDRESS + 5, 0, 0);
+    if (!worker->result)
+        worker->result = uc_reg_read(worker->uc, UC_X86_REG_RAX,
+                                     &worker->observed);
+    if (!worker->result)
+        worker->result = uc_reg_read(worker->uc, UC_X86_REG_EFLAGS,
+                                     &worker->eflags);
+    return NULL;
+}
+
+static int setup_race_worker(struct fixture *fixture,
+                             struct race_worker *worker,
+                             struct race_barrier *barrier,
+                             uint64_t replacement)
+{
+    static const uint8_t code[] =
+        {0xf0, 0x48, 0x0f, 0xb1, 0x17}; /* lock cmpxchgq %rdx,(%rdi) */
+    uint64_t target = (uintptr_t)fixture->data;
+    uint64_t expected = 0;
+    uint32_t eflags = 2;
+    uc_err err;
+
+    memset(worker, 0, sizeof(*worker));
+    worker->barrier = barrier;
+    worker->replacement = replacement;
+    if ((err = open_engine(fixture, &worker->uc)) ||
+        (err = install_code(worker->uc, code, sizeof(code))) ||
+        (err = uc_reg_write(worker->uc, UC_X86_REG_RDI, &target)) ||
+        (err = uc_reg_write(worker->uc, UC_X86_REG_RAX, &expected)) ||
+        (err = uc_reg_write(worker->uc, UC_X86_REG_RDX, &replacement)) ||
+        (err = uc_reg_write(worker->uc, UC_X86_REG_EFLAGS, &eflags)))
+    {
+        fprintf(stderr, "identity atomic race setup failed: %s\n",
+                uc_strerror(err));
+        return 1;
+    }
+    return 0;
+}
+
+static int test_cross_engine_atomicity(struct fixture *fixture)
+{
+    struct race_barrier barrier;
+    unsigned int iteration;
+    int error;
+
+    memset(&barrier, 0, sizeof(barrier));
+    if ((error = pthread_mutex_init(&barrier.mutex, NULL)))
+    {
+        fprintf(stderr, "identity atomic race barrier failed: %d\n", error);
+        return 1;
+    }
+    if ((error = pthread_cond_init(&barrier.cond, NULL)))
+    {
+        fprintf(stderr, "identity atomic race barrier failed: %d\n", error);
+        pthread_mutex_destroy(&barrier.mutex);
+        return 1;
+    }
+    fixture->page_flags[page_index(fixture->data)] =
+        UC_SWITCHYARD_IDENTITY_PAGE_READ |
+        UC_SWITCHYARD_IDENTITY_PAGE_WRITE;
+    for (iteration = 0; iteration < 100; ++iteration)
+    {
+        struct race_worker workers[2];
+        pthread_t threads[2];
+        uint64_t *shared = (uint64_t *)fixture->data;
+        unsigned int successes;
+
+        *shared = 0;
+        barrier.starters = 0;
+        if (setup_race_worker(fixture, &workers[0], &barrier, 1) ||
+            setup_race_worker(fixture, &workers[1], &barrier, 2))
+        {
+            if (workers[0].uc) uc_close(workers[0].uc);
+            if (workers[1].uc) uc_close(workers[1].uc);
+            pthread_cond_destroy(&barrier.cond);
+            pthread_mutex_destroy(&barrier.mutex);
+            return 1;
+        }
+        if ((error = pthread_create(&threads[0], NULL, run_race_worker,
+                                    &workers[0])))
+        {
+            fprintf(stderr, "identity atomic race launch failed: %d\n",
+                    error);
+            uc_close(workers[0].uc);
+            uc_close(workers[1].uc);
+            pthread_cond_destroy(&barrier.cond);
+            pthread_mutex_destroy(&barrier.mutex);
+            return 1;
+        }
+        if ((error = pthread_create(&threads[1], NULL, run_race_worker,
+                                    &workers[1])))
+        {
+            pthread_mutex_lock(&barrier.mutex);
+            barrier.starters = 2;
+            pthread_cond_broadcast(&barrier.cond);
+            pthread_mutex_unlock(&barrier.mutex);
+            pthread_join(threads[0], NULL);
+            fprintf(stderr, "identity atomic race launch failed: %d\n",
+                    error);
+            uc_close(workers[0].uc);
+            uc_close(workers[1].uc);
+            pthread_cond_destroy(&barrier.cond);
+            pthread_mutex_destroy(&barrier.mutex);
+            return 1;
+        }
+        pthread_join(threads[0], NULL);
+        pthread_join(threads[1], NULL);
+        successes = !!(workers[0].eflags & ZF) +
+                    !!(workers[1].eflags & ZF);
+        if (workers[0].result || workers[1].result || successes != 1 ||
+            (*shared != 1 && *shared != 2) ||
+            ((workers[0].eflags & ZF) && workers[0].observed != 0) ||
+            ((workers[1].eflags & ZF) && workers[1].observed != 0) ||
+            (!(workers[0].eflags & ZF) &&
+             workers[0].observed != *shared) ||
+            (!(workers[1].eflags & ZF) &&
+             workers[1].observed != *shared))
+        {
+            fprintf(stderr, "identity atomic race mismatch at %u\n",
+                    iteration);
+            uc_close(workers[0].uc);
+            uc_close(workers[1].uc);
+            pthread_cond_destroy(&barrier.cond);
+            pthread_mutex_destroy(&barrier.mutex);
+            return 1;
+        }
+        uc_close(workers[0].uc);
+        uc_close(workers[1].uc);
+    }
+    pthread_cond_destroy(&barrier.cond);
+    pthread_mutex_destroy(&barrier.mutex);
+    return 0;
+}
+
+static void atomic_trace(uc_engine *uc, uc_shared_memory_atomic_phase phase,
+                         void *user_data)
+{
+    struct atomic_trace_state *state = user_data;
+
+    (void)uc;
+    if (phase == UC_SHARED_MEMORY_ATOMIC_EXIT)
+    {
+        if (state->open) state->order_error = true;
+        state->open = true;
+        ++state->exits;
+    }
+    else if (phase == UC_SHARED_MEMORY_ATOMIC_REENTRY)
+    {
+        if (!state->open) state->order_error = true;
+        state->open = false;
+        ++state->reentries;
+    }
+    else state->order_error = true;
+}
+
+static int test_unaligned_serial_fallback(struct fixture *fixture)
+{
+    static const uint8_t code[] =
+        {0x66, 0x87, 0x07}; /* xchgw %ax,(%rdi) */
+    struct atomic_trace_state trace = {0};
+    uint8_t *target = fixture->data + 1;
+    uint64_t rdi = (uintptr_t)target;
+    uint64_t rax = UINT64_C(0x2222);
+    uint16_t initial = UINT16_C(0x1111);
+    uint16_t observed;
+    uc_engine *uc = NULL;
+    uc_err err;
+
+    memcpy(target, &initial, sizeof(initial));
+    fixture->page_flags[page_index(target)] =
+        UC_SWITCHYARD_IDENTITY_PAGE_READ |
+        UC_SWITCHYARD_IDENTITY_PAGE_WRITE;
+    if ((err = uc_open(UC_ARCH_X86, UC_MODE_64, &uc)) ||
+        (err = uc_configure_identity_memory_fastpath(
+             uc, fixture->page_flags, fixture->address_bits)) ||
+        (err = uc_set_shared_memory_atomic_callback(uc, atomic_trace,
+                                                    &trace)) ||
+        (err = uc_enable_shared_memory_atomics(uc)) ||
+        (err = uc_mem_map_ptr(uc, (uintptr_t)fixture->data, PAGE_SIZE,
+                              UC_PROT_READ | UC_PROT_WRITE, fixture->data)) ||
+        (err = install_code(uc, code, sizeof(code))) ||
+        (err = uc_reg_write(uc, UC_X86_REG_RDI, &rdi)) ||
+        (err = uc_reg_write(uc, UC_X86_REG_RAX, &rax)) ||
+        (err = uc_emu_start(uc, CODE_ADDRESS,
+                            CODE_ADDRESS + sizeof(code), 0, 0)) ||
+        (err = uc_reg_read(uc, UC_X86_REG_RAX, &rax)))
+    {
+        fprintf(stderr, "unaligned identity atomic failed: %s\n",
+                uc_strerror(err));
+        if (uc) uc_close(uc);
+        return 1;
+    }
+    memcpy(&observed, target, sizeof(observed));
+    uc_close(uc);
+    if (observed != UINT16_C(0x2222) || (uint16_t)rax != initial ||
+        trace.exits != 1 || trace.reentries != 1 || trace.open ||
+        trace.order_error)
+    {
+        fprintf(stderr, "unaligned identity atomic bypassed serialization: "
+                "value %#x, rax %#x, exit %u, reentry %u\n", observed,
+                (unsigned int)(uint16_t)rax, trace.exits, trace.reentries);
+        return 1;
+    }
+    return 0;
+}
+
+int main(void)
+{
+    struct fixture fixture;
+    int ret = 1;
+
+    alarm(10);
+    if (fixture_init(&fixture)) goto done;
+    if (test_unmapped_identity_success(&fixture) ||
+        test_read_only_fallback(&fixture) ||
+        test_invalid_hook_fallback(&fixture) ||
+        test_cross_engine_atomicity(&fixture) ||
+        test_unaligned_serial_fallback(&fixture))
+        goto done;
+    puts("identity-memory atomic fast path passed");
+    ret = 0;
+
+done:
+    fixture_destroy(&fixture);
+    alarm(0);
+    return ret;
+}
diff --git a/tests/regress/identity_memory_fastpath.c b/tests/regress/identity_memory_fastpath.c
new file mode 100644
index 0000000000000000000000000000000000000000..a00bd70883060cba51320c55417a498710ff730f
--- /dev/null
+++ b/tests/regress/identity_memory_fastpath.c
@@ -0,0 +1,532 @@
+/* Validate Switchyard's permission-gated AArch64 identity-memory fast path. */
+
+#define _DARWIN_C_SOURCE
+#define _POSIX_C_SOURCE 200809L
+
+#include <pthread.h>
+#include <sched.h>
+#include <stdatomic.h>
+#include <stdbool.h>
+#include <stdint.h>
+#include <stdio.h>
+#include <stdlib.h>
+#include <string.h>
+#include <sys/mman.h>
+#include <time.h>
+#include <unistd.h>
+
+#include <unicorn/unicorn.h>
+#include <unicorn/x86.h>
+
+#define CODE_ADDRESS UINT64_C(0x100000)
+#define DATA_HINT UINT64_C(0x400000000)
+#define PAGE_SIZE 0x1000
+#define DATA_PAGE_COUNT 4
+#define TIMEOUT_SECONDS 10
+
+struct fixture
+{
+    uint8_t *data;
+    uint8_t *page_flags;
+    size_t page_flags_size;
+    uint32_t address_bits;
+};
+
+struct invalid_hook_state
+{
+    uint8_t *host_page;
+    uint64_t guest_page;
+    unsigned int calls;
+    uc_err map_error;
+};
+
+struct stop_state
+{
+    uc_engine *uc;
+    atomic_uint entered;
+    atomic_uint finished;
+    uc_err result;
+};
+
+static uint32_t address_width(uint64_t value)
+{
+    uint32_t width = 0;
+
+    do
+    {
+        ++width;
+        value >>= 1;
+    } while (value);
+    return width;
+}
+
+static int fixture_init(struct fixture *fixture)
+{
+    const size_t data_size = DATA_PAGE_COUNT * PAGE_SIZE;
+    uint64_t highest;
+
+    memset(fixture, 0, sizeof(*fixture));
+    fixture->data = mmap((void *)(uintptr_t)DATA_HINT, data_size,
+                         PROT_READ | PROT_WRITE, MAP_PRIVATE | MAP_ANON,
+                         -1, 0);
+    if (fixture->data == MAP_FAILED)
+    {
+        fixture->data = NULL;
+        perror("data mmap");
+        return 1;
+    }
+
+    highest = (uint64_t)(uintptr_t)fixture->data + data_size - 1;
+    fixture->address_bits = address_width(highest);
+    if (fixture->address_bits <= UC_SWITCHYARD_IDENTITY_PAGE_SHIFT ||
+        fixture->address_bits >= 56)
+    {
+        fprintf(stderr, "unexpected data address width: %u\n",
+                fixture->address_bits);
+        return 1;
+    }
+    fixture->page_flags_size =
+        (size_t)1 << (fixture->address_bits -
+                     UC_SWITCHYARD_IDENTITY_PAGE_SHIFT);
+    fixture->page_flags = mmap(NULL, fixture->page_flags_size,
+                               PROT_READ | PROT_WRITE,
+                               MAP_PRIVATE | MAP_ANON, -1, 0);
+    if (fixture->page_flags == MAP_FAILED)
+    {
+        fixture->page_flags = NULL;
+        perror("page-flags mmap");
+        return 1;
+    }
+    return 0;
+}
+
+static void fixture_destroy(struct fixture *fixture)
+{
+    if (fixture->page_flags)
+        munmap(fixture->page_flags, fixture->page_flags_size);
+    if (fixture->data)
+        munmap(fixture->data, DATA_PAGE_COUNT * PAGE_SIZE);
+}
+
+static size_t page_index(const void *address)
+{
+    return (uintptr_t)address >> UC_SWITCHYARD_IDENTITY_PAGE_SHIFT;
+}
+
+static uc_err open_fast_engine(const struct fixture *fixture, uc_engine **uc)
+{
+    uc_err err = UC_ERR_OK;
+
+    *uc = NULL;
+    if ((err = uc_open(UC_ARCH_X86, UC_MODE_64, uc)))
+        return err;
+    err = uc_configure_identity_memory_fastpath(*uc, fixture->page_flags,
+                                                 fixture->address_bits);
+    if (err)
+    {
+        uc_close(*uc);
+        *uc = NULL;
+    }
+    return err;
+}
+
+static uc_err install_code(uc_engine *uc, const uint8_t *code, size_t size)
+{
+    uc_err err;
+
+    if ((err = uc_mem_map(uc, CODE_ADDRESS, PAGE_SIZE, UC_PROT_ALL)))
+        return err;
+    return uc_mem_write(uc, CODE_ADDRESS, code, size);
+}
+
+static void emit_movabs(uint8_t *code, unsigned int register_opcode,
+                        uint64_t value)
+{
+    code[0] = 0x48;
+    code[1] = register_opcode;
+    memcpy(code + 2, &value, sizeof(value));
+}
+
+static int test_api_contract(struct fixture *fixture)
+{
+    uc_engine *uc = NULL;
+    uc_hook hook;
+    uc_err err = UC_ERR_OK;
+    uint8_t dummy_flags = 0;
+
+    if (uc_configure_identity_memory_fastpath(NULL, &dummy_flags, 32) !=
+            UC_ERR_ARG ||
+        (err = uc_open(UC_ARCH_X86, UC_MODE_64, &uc)) ||
+        uc_configure_identity_memory_fastpath(uc, NULL, 32) != UC_ERR_ARG ||
+        uc_configure_identity_memory_fastpath(uc, &dummy_flags,
+            UC_SWITCHYARD_IDENTITY_PAGE_SHIFT) != UC_ERR_ARG ||
+        uc_configure_identity_memory_fastpath(uc, &dummy_flags, 64) !=
+            UC_ERR_ARG ||
+        (err = uc_configure_identity_memory_fastpath(
+             uc, fixture->page_flags, fixture->address_bits)) ||
+        uc_configure_identity_memory_fastpath(
+            uc, fixture->page_flags, fixture->address_bits) !=
+            UC_ERR_RESOURCE)
+    {
+        fprintf(stderr, "identity API validation failed: %s\n",
+                uc_strerror(err));
+        if (uc) uc_close(uc);
+        return 1;
+    }
+
+    err = uc_hook_add(uc, &hook, UC_HOOK_MEM_READ, NULL, NULL, 1, 0);
+    uc_close(uc);
+    if (err != UC_ERR_RESOURCE)
+    {
+        fprintf(stderr, "valid-memory hook was accepted: %s\n",
+                uc_strerror(err));
+        return 1;
+    }
+
+    if ((err = uc_open(UC_ARCH_X86, UC_MODE_64, &uc)) ||
+        (err = uc_mem_map(uc, CODE_ADDRESS, PAGE_SIZE, UC_PROT_ALL)))
+    {
+        fprintf(stderr, "late-config setup failed: %s\n", uc_strerror(err));
+        if (uc) uc_close(uc);
+        return 1;
+    }
+    err = uc_configure_identity_memory_fastpath(
+        uc, fixture->page_flags, fixture->address_bits);
+    uc_close(uc);
+    if (err != UC_ERR_RESOURCE)
+    {
+        fprintf(stderr, "late identity configuration was accepted: %s\n",
+                uc_strerror(err));
+        return 1;
+    }
+    return 0;
+}
+
+static int test_identity_and_fallback(struct fixture *fixture)
+{
+    uint8_t code[17] = {0};
+    uint64_t initial = UINT64_C(0x1122334455667788);
+    uint64_t observed;
+    uc_engine *uc = NULL;
+    uc_err err;
+    unsigned int page;
+
+    for (page = 0; page < 2; ++page)
+    {
+        uint8_t *target = fixture->data + page * PAGE_SIZE;
+
+        memcpy(target, &initial, sizeof(initial));
+        fixture->page_flags[page_index(target)] = page ? 0 :
+            UC_SWITCHYARD_IDENTITY_PAGE_READ |
+            UC_SWITCHYARD_IDENTITY_PAGE_WRITE;
+        emit_movabs(code, 0xb8, (uintptr_t)target); /* movabs rax,target */
+        code[10] = 0x48;
+        code[11] = 0x8b;
+        code[12] = 0x18; /* mov rbx,(rax) */
+        code[13] = 0x48;
+        code[14] = 0x83;
+        code[15] = 0x00;
+        code[16] = 0x01; /* addq $1,(rax) */
+
+        if ((err = open_fast_engine(fixture, &uc)) ||
+            (err = uc_mem_map_ptr(uc, (uintptr_t)target, PAGE_SIZE,
+                                  UC_PROT_READ | UC_PROT_WRITE, target)) ||
+            (err = install_code(uc, code, sizeof(code))) ||
+            (err = uc_emu_start(uc, CODE_ADDRESS,
+                                CODE_ADDRESS + sizeof(code), 0, 0)) ||
+            (err = uc_reg_read(uc, UC_X86_REG_RBX, &observed)))
+        {
+            fprintf(stderr, "%s memory execution failed: %s\n",
+                    page ? "fallback" : "identity", uc_strerror(err));
+            if (uc) uc_close(uc);
+            return 1;
+        }
+        uc_close(uc);
+        uc = NULL;
+        if (observed != initial)
+        {
+            fprintf(stderr, "%s read mismatch\n",
+                    page ? "fallback" : "identity");
+            return 1;
+        }
+        memcpy(&observed, target, sizeof(observed));
+        if (observed != initial + 1)
+        {
+            fprintf(stderr, "%s write mismatch\n",
+                    page ? "fallback" : "identity");
+            return 1;
+        }
+    }
+    return 0;
+}
+
+static int test_read_only_write(struct fixture *fixture)
+{
+    uint8_t code[13] = {0};
+    uint8_t *target = fixture->data + 2 * PAGE_SIZE;
+    uc_engine *uc = NULL;
+    uc_err err;
+
+    *target = 0x11;
+    fixture->page_flags[page_index(target)] =
+        UC_SWITCHYARD_IDENTITY_PAGE_READ;
+    emit_movabs(code, 0xb8, (uintptr_t)target);
+    code[10] = 0xc6;
+    code[11] = 0x00;
+    code[12] = 0x5a; /* movb $0x5a,(rax) */
+
+    if ((err = open_fast_engine(fixture, &uc)) ||
+        (err = uc_mem_map_ptr(uc, (uintptr_t)target, PAGE_SIZE,
+                              UC_PROT_READ, target)) ||
+        (err = install_code(uc, code, sizeof(code))))
+    {
+        fprintf(stderr, "read-only setup failed: %s\n", uc_strerror(err));
+        if (uc) uc_close(uc);
+        return 1;
+    }
+    err = uc_emu_start(uc, CODE_ADDRESS, CODE_ADDRESS + sizeof(code), 0, 0);
+    uc_close(uc);
+    if (err != UC_ERR_WRITE_PROT || *target != 0x11)
+    {
+        fprintf(stderr, "read-only write escaped protection: %s, value %#x\n",
+                uc_strerror(err), *target);
+        return 1;
+    }
+    return 0;
+}
+
+static int test_cross_page_write(struct fixture *fixture)
+{
+    uint8_t code[23] = {0};
+    uint8_t *first = fixture->data;
+    uint8_t *second = first + PAGE_SIZE;
+    uint8_t *target = second - 4;
+    const uint64_t store = UINT64_C(0xa1a2a3a4a5a6a7a8);
+    uc_engine *uc = NULL;
+    uc_err err;
+
+    memset(target, 0x33, sizeof(store));
+    fixture->page_flags[page_index(first)] =
+        UC_SWITCHYARD_IDENTITY_PAGE_READ |
+        UC_SWITCHYARD_IDENTITY_PAGE_WRITE;
+    fixture->page_flags[page_index(second)] =
+        UC_SWITCHYARD_IDENTITY_PAGE_READ |
+        UC_SWITCHYARD_IDENTITY_PAGE_WRITE;
+    emit_movabs(code, 0xb8, (uintptr_t)target);
+    emit_movabs(code + 10, 0xbb, store);
+    code[20] = 0x48;
+    code[21] = 0x89;
+    code[22] = 0x18; /* movq rbx,(rax) */
+
+    if ((err = open_fast_engine(fixture, &uc)) ||
+        (err = uc_mem_map_ptr(uc, (uintptr_t)first, PAGE_SIZE,
+                              UC_PROT_READ | UC_PROT_WRITE, first)) ||
+        (err = uc_mem_map_ptr(uc, (uintptr_t)second, PAGE_SIZE,
+                              UC_PROT_READ, second)) ||
+        (err = install_code(uc, code, sizeof(code))))
+    {
+        fprintf(stderr, "cross-page setup failed: %s\n", uc_strerror(err));
+        if (uc) uc_close(uc);
+        return 1;
+    }
+    err = uc_emu_start(uc, CODE_ADDRESS, CODE_ADDRESS + sizeof(code), 0, 0);
+    uc_close(uc);
+    if (err != UC_ERR_WRITE_PROT || memcmp(second, "3333", 4))
+    {
+        fprintf(stderr, "cross-page write escaped fallback: %s\n",
+                uc_strerror(err));
+        return 1;
+    }
+    return 0;
+}
+
+static int test_out_of_range(struct fixture *fixture)
+{
+    uint8_t code[13] = {0};
+    const uint64_t target = UINT64_C(1) << fixture->address_bits;
+    uc_engine *uc = NULL;
+    uc_err err;
+
+    emit_movabs(code, 0xb8, target);
+    code[10] = 0x48;
+    code[11] = 0x8b;
+    code[12] = 0x18; /* mov rbx,(rax) */
+    if ((err = open_fast_engine(fixture, &uc)) ||
+        (err = install_code(uc, code, sizeof(code))))
+    {
+        fprintf(stderr, "out-of-range setup failed: %s\n", uc_strerror(err));
+        if (uc) uc_close(uc);
+        return 1;
+    }
+    err = uc_emu_start(uc, CODE_ADDRESS, CODE_ADDRESS + sizeof(code), 0, 0);
+    uc_close(uc);
+    if (err != UC_ERR_READ_UNMAPPED)
+    {
+        fprintf(stderr, "out-of-range access returned %s\n", uc_strerror(err));
+        return 1;
+    }
+    return 0;
+}
+
+static bool map_invalid_read(uc_engine *uc, uc_mem_type type,
+                             uint64_t address, int size, int64_t value,
+                             void *user_data)
+{
+    struct invalid_hook_state *state = user_data;
+
+    (void)value;
+    ++state->calls;
+    if (type != UC_MEM_READ_UNMAPPED || address != state->guest_page ||
+        size != 8)
+        return false;
+    state->map_error = uc_mem_map_ptr(uc, state->guest_page, PAGE_SIZE,
+                                      UC_PROT_READ | UC_PROT_WRITE,
+                                      state->host_page);
+    return state->map_error == UC_ERR_OK;
+}
+
+static int test_invalid_hook_fallback(struct fixture *fixture)
+{
+    uint8_t code[13] = {0};
+    uint8_t *target = fixture->data + 3 * PAGE_SIZE;
+    const uint64_t expected = UINT64_C(0x8877665544332211);
+    struct invalid_hook_state state =
+    {
+        .host_page = target,
+        .guest_page = (uintptr_t)target,
+    };
+    uint64_t observed = 0;
+    uc_engine *uc = NULL;
+    uc_hook hook;
+    uc_err err;
+
+    memcpy(target, &expected, sizeof(expected));
+    fixture->page_flags[page_index(target)] = 0;
+    emit_movabs(code, 0xb8, (uintptr_t)target);
+    code[10] = 0x48;
+    code[11] = 0x8b;
+    code[12] = 0x18; /* mov rbx,(rax) */
+    if ((err = open_fast_engine(fixture, &uc)) ||
+        (err = uc_hook_add(uc, &hook, UC_HOOK_MEM_READ_UNMAPPED,
+                           map_invalid_read, &state, (uintptr_t)target,
+                           (uintptr_t)target + PAGE_SIZE - 1)) ||
+        (err = install_code(uc, code, sizeof(code))) ||
+        (err = uc_emu_start(uc, CODE_ADDRESS,
+                            CODE_ADDRESS + sizeof(code), 0, 0)) ||
+        (err = uc_reg_read(uc, UC_X86_REG_RBX, &observed)))
+    {
+        fprintf(stderr, "invalid-hook fallback failed: %s\n",
+                uc_strerror(err));
+        if (uc) uc_close(uc);
+        return 1;
+    }
+    uc_close(uc);
+    if (state.calls != 1 || state.map_error != UC_ERR_OK ||
+        observed != expected)
+    {
+        fprintf(stderr, "invalid-hook mismatch: calls %u, map %s\n",
+                state.calls, uc_strerror(state.map_error));
+        return 1;
+    }
+    return 0;
+}
+
+static void *run_until_stopped(void *arg)
+{
+    struct stop_state *state = arg;
+
+    atomic_store_explicit(&state->entered, 1, memory_order_release);
+    state->result = uc_emu_start(state->uc, CODE_ADDRESS, UINT64_MAX, 0, 0);
+    atomic_store_explicit(&state->finished, 1, memory_order_release);
+    return NULL;
+}
+
+static int test_cross_thread_stop(struct fixture *fixture)
+{
+    uint8_t code[15] = {0};
+    uint8_t *target = fixture->data;
+    struct stop_state state = {0};
+    const struct timespec delay = {.tv_nsec = 1000000};
+    pthread_t thread;
+    uc_err err;
+    unsigned int i;
+    int pthread_error;
+
+    fixture->page_flags[page_index(target)] =
+        UC_SWITCHYARD_IDENTITY_PAGE_READ |
+        UC_SWITCHYARD_IDENTITY_PAGE_WRITE;
+    emit_movabs(code, 0xb8, (uintptr_t)target);
+    code[10] = 0x48;
+    code[11] = 0xff;
+    code[12] = 0x00; /* incq (rax) */
+    code[13] = 0xeb;
+    code[14] = 0xfb; /* jmp to incq */
+
+    if ((err = open_fast_engine(fixture, &state.uc)) ||
+        (err = uc_mem_map_ptr(state.uc, (uintptr_t)target, PAGE_SIZE,
+                              UC_PROT_READ | UC_PROT_WRITE, target)) ||
+        (err = install_code(state.uc, code, sizeof(code))))
+    {
+        fprintf(stderr, "stop setup failed: %s\n", uc_strerror(err));
+        if (state.uc) uc_close(state.uc);
+        return 1;
+    }
+
+    for (i = 0; i < 25; ++i)
+    {
+        atomic_store_explicit(&state.entered, 0, memory_order_relaxed);
+        atomic_store_explicit(&state.finished, 0, memory_order_relaxed);
+        if ((pthread_error = pthread_create(&thread, NULL, run_until_stopped,
+                                            &state)))
+        {
+            fprintf(stderr, "pthread_create failed: %d\n", pthread_error);
+            uc_close(state.uc);
+            return 1;
+        }
+        while (!atomic_load_explicit(&state.entered, memory_order_acquire))
+            sched_yield();
+        nanosleep(&delay, NULL);
+        if ((err = uc_emu_stop(state.uc)))
+        {
+            fprintf(stderr, "cross-thread stop failed: %s\n",
+                    uc_strerror(err));
+            return 1;
+        }
+        pthread_join(thread, NULL);
+        if (!atomic_load_explicit(&state.finished, memory_order_acquire) ||
+            state.result != UC_ERR_OK)
+        {
+            fprintf(stderr, "emulation stop mismatch: %s\n",
+                    uc_strerror(state.result));
+            uc_close(state.uc);
+            return 1;
+        }
+    }
+    uc_close(state.uc);
+    return 0;
+}
+
+int main(void)
+{
+    struct fixture fixture;
+    int ret = 1;
+
+    alarm(TIMEOUT_SECONDS);
+    if (fixture_init(&fixture))
+        goto done;
+    if (test_api_contract(&fixture) ||
+        test_identity_and_fallback(&fixture) ||
+        test_read_only_write(&fixture) ||
+        test_cross_page_write(&fixture) ||
+        test_out_of_range(&fixture) ||
+        test_invalid_hook_fallback(&fixture) ||
+        test_cross_thread_stop(&fixture))
+        goto done;
+    puts("identity-memory fast path passed");
+    ret = 0;
+
+ done:
+    fixture_destroy(&fixture);
+    alarm(0);
+    return ret;
+}
diff --git a/tests/regress/shared_atomic_idle_mapping.c b/tests/regress/shared_atomic_idle_mapping.c
new file mode 100644
index 0000000000000000000000000000000000000000..eda783680e9a402d1fe598f20c8b52189a52c927
--- /dev/null
+++ b/tests/regress/shared_atomic_idle_mapping.c
@@ -0,0 +1,202 @@
+/* Verify an idle engine stays idle after mapping waits for an exclusive owner. */
+
+#define _POSIX_C_SOURCE 200809L
+
+#include <pthread.h>
+#include <signal.h>
+#include <stdatomic.h>
+#include <stdint.h>
+#include <stdio.h>
+#include <string.h>
+#include <time.h>
+
+#include <unicorn/unicorn.h>
+#include <unicorn/x86.h>
+
+#define CODE_ADDRESS 0x10000u
+#define DATA_ADDRESS 0x20000u
+#define IDLE_MAP_ADDRESS 0x30000u
+#define PAGE_SIZE 0x1000u
+
+struct owner_gate
+{
+    pthread_mutex_t mutex;
+    pthread_cond_t cond;
+    unsigned int exits;
+    unsigned int reentries;
+    int owner_held;
+    int release_owner;
+};
+
+struct emulation_worker
+{
+    uc_engine *uc;
+    uc_err result;
+};
+
+struct mapping_worker
+{
+    uc_engine *uc;
+    uc_err result;
+    atomic_int started;
+    atomic_int done;
+};
+
+static void atomic_phase(uc_engine *uc, uc_shared_memory_atomic_phase phase,
+                         void *opaque)
+{
+    struct owner_gate *gate = opaque;
+
+    (void)uc;
+    pthread_mutex_lock(&gate->mutex);
+    if (phase == UC_SHARED_MEMORY_ATOMIC_EXIT)
+    {
+        ++gate->exits;
+        if (gate->exits == 1)
+        {
+            gate->owner_held = 1;
+            pthread_cond_broadcast(&gate->cond);
+            while (!gate->release_owner)
+                pthread_cond_wait(&gate->cond, &gate->mutex);
+        }
+    }
+    else if (phase == UC_SHARED_MEMORY_ATOMIC_REENTRY)
+        ++gate->reentries;
+    pthread_mutex_unlock(&gate->mutex);
+}
+
+static void *run_emulation(void *opaque)
+{
+    struct emulation_worker *worker = opaque;
+
+    worker->result = uc_emu_start(worker->uc, CODE_ADDRESS,
+                                  CODE_ADDRESS + 13, 0, 0);
+    return NULL;
+}
+
+static void *run_mapping(void *opaque)
+{
+    struct mapping_worker *worker = opaque;
+
+    atomic_store_explicit(&worker->started, 1, memory_order_release);
+    worker->result = uc_mem_map(worker->uc, IDLE_MAP_ADDRESS, PAGE_SIZE,
+                                UC_PROT_ALL);
+    atomic_store_explicit(&worker->done, 1, memory_order_release);
+    return NULL;
+}
+
+int main(void)
+{
+    static const unsigned char code[] =
+    {
+        0xbf, 0x01, 0x00, 0x02, 0x00, /* mov $DATA_ADDRESS+1,%edi */
+        0xb8, 0x34, 0x12, 0x00, 0x00, /* mov $0x1234,%eax */
+        0x66, 0x87, 0x07,             /* xchg %ax,(%rdi) */
+    };
+    struct owner_gate gate = {0};
+    struct emulation_worker owner_worker = {0};
+    struct mapping_worker mapping = {0};
+    struct timespec settle = {0, 20 * 1000 * 1000};
+    uc_engine *owner = NULL, *idle = NULL;
+    pthread_t owner_thread, mapping_thread;
+    uc_err err;
+    int ret = 1;
+
+    alarm(10);
+    if (pthread_mutex_init(&gate.mutex, NULL) ||
+        pthread_cond_init(&gate.cond, NULL))
+    {
+        fputs("gate initialization failed\n", stderr);
+        return 2;
+    }
+    if ((err = uc_open(UC_ARCH_X86, UC_MODE_64, &owner)) ||
+        (err = uc_open(UC_ARCH_X86, UC_MODE_64, &idle)) ||
+        (err = uc_set_shared_memory_atomic_callback(owner, atomic_phase,
+                                                     &gate)) ||
+        (err = uc_enable_shared_memory_atomics(owner)) ||
+        (err = uc_enable_shared_memory_atomics(idle)) ||
+        (err = uc_mem_map(owner, CODE_ADDRESS, PAGE_SIZE, UC_PROT_ALL)) ||
+        (err = uc_mem_map(owner, DATA_ADDRESS, PAGE_SIZE, UC_PROT_ALL)) ||
+        (err = uc_mem_write(owner, CODE_ADDRESS, code, sizeof(code))))
+    {
+        fprintf(stderr, "setup failed: %s\n", uc_strerror(err));
+        goto done;
+    }
+
+    owner_worker.uc = owner;
+    mapping.uc = idle;
+    if (pthread_create(&owner_thread, NULL, run_emulation, &owner_worker))
+    {
+        fputs("owner thread creation failed\n", stderr);
+        goto done;
+    }
+    pthread_mutex_lock(&gate.mutex);
+    while (!gate.owner_held)
+        pthread_cond_wait(&gate.cond, &gate.mutex);
+    pthread_mutex_unlock(&gate.mutex);
+
+    if (pthread_create(&mapping_thread, NULL, run_mapping, &mapping))
+    {
+        fputs("mapping thread creation failed\n", stderr);
+        pthread_mutex_lock(&gate.mutex);
+        gate.release_owner = 1;
+        pthread_cond_broadcast(&gate.cond);
+        pthread_mutex_unlock(&gate.mutex);
+        pthread_join(owner_thread, NULL);
+        goto done;
+    }
+    while (!atomic_load_explicit(&mapping.started, memory_order_acquire))
+        ;
+    nanosleep(&settle, NULL);
+    if (atomic_load_explicit(&mapping.done, memory_order_acquire))
+    {
+        fputs("idle mapping escaped an active exclusive owner\n", stderr);
+        pthread_join(mapping_thread, NULL);
+        pthread_mutex_lock(&gate.mutex);
+        gate.release_owner = 1;
+        pthread_cond_broadcast(&gate.cond);
+        pthread_mutex_unlock(&gate.mutex);
+        pthread_join(owner_thread, NULL);
+        goto done;
+    }
+
+    pthread_mutex_lock(&gate.mutex);
+    gate.release_owner = 1;
+    pthread_cond_broadcast(&gate.cond);
+    pthread_mutex_unlock(&gate.mutex);
+    pthread_join(owner_thread, NULL);
+    pthread_join(mapping_thread, NULL);
+    if (owner_worker.result || mapping.result)
+    {
+        fprintf(stderr, "first phase failed: emulation %s, mapping %s\n",
+                uc_strerror(owner_worker.result), uc_strerror(mapping.result));
+        goto done;
+    }
+
+    /* Before the fix, the idle mapper is incorrectly restored as running.
+     * This second exclusive transaction then waits forever for an engine that
+     * has no emulation thread; alarm() makes that failure bounded. */
+    if ((err = uc_emu_start(owner, CODE_ADDRESS, CODE_ADDRESS + sizeof(code),
+                            0, 0)))
+    {
+        fprintf(stderr, "second exclusive transaction failed: %s\n",
+                uc_strerror(err));
+        goto done;
+    }
+    if (gate.exits != 2 || gate.reentries != 2)
+    {
+        fprintf(stderr, "atomic phase mismatch: exits %u, reentries %u\n",
+                gate.exits, gate.reentries);
+        goto done;
+    }
+    puts("idle mapping preserved the engine running state");
+    ret = 0;
+
+done:
+    if (idle) uc_close(idle);
+    if (owner) uc_close(owner);
+    pthread_cond_destroy(&gate.cond);
+    pthread_mutex_destroy(&gate.mutex);
+    alarm(0);
+    return ret;
+}
diff --git a/tests/regress/shared_code_coherence.c b/tests/regress/shared_code_coherence.c
new file mode 100644
index 0000000000000000000000000000000000000000..42b5d27a4b79ff0e0856010b604ac87c550ad553
--- /dev/null
+++ b/tests/regress/shared_code_coherence.c
@@ -0,0 +1,163 @@
+/* Verify that independent engines sharing executable host backing observe
+ * guest writes after the writer has completed. */
+
+#include <stdint.h>
+#include <stdio.h>
+#include <stdlib.h>
+#include <string.h>
+
+#include <unicorn/unicorn.h>
+#include <unicorn/x86.h>
+
+#ifndef UC_SWITCHYARD_SHARED_MEMORY_ATOMICS
+#error UC_SWITCHYARD_SHARED_MEMORY_ATOMICS is required
+#endif
+
+#define CODE_ADDRESS   0x10000u
+#define STOP_ADDRESS   (CODE_ADDRESS + 0x100u)
+#define WRITER_ADDRESS 0x20000u
+#define PAGE_SIZE      0x1000u
+#define ADDRESS_BITS   32u
+
+static uint8_t identity_page_flags[1u <<
+    (ADDRESS_BITS - UC_SWITCHYARD_IDENTITY_PAGE_SHIFT)];
+
+static int fail(uc_err err, const char *operation)
+{
+    fprintf(stderr, "%s failed: %s\n", operation, uc_strerror(err));
+    return 1;
+}
+
+static void stop_block(uc_engine *uc, uint64_t address, uint32_t size,
+                       void *opaque)
+{
+    (void)address;
+    (void)size;
+    (void)opaque;
+    uc_emu_stop(uc);
+}
+
+static int read_eax(uc_engine *uc, uint32_t *eax)
+{
+    uc_err err;
+
+    *eax = 0;
+    if ((err = uc_reg_write(uc, UC_X86_REG_EAX, eax)))
+        return fail(err, "clear eax");
+    if ((err = uc_emu_start(uc, CODE_ADDRESS, UINT64_MAX, 0, 0)))
+        return fail(err, "execute shared code");
+    if ((err = uc_reg_read(uc, UC_X86_REG_EAX, eax)))
+        return fail(err, "read eax");
+    return 0;
+}
+
+int main(void)
+{
+    static const uint8_t initial_code[] =
+    {
+        0xb8, 0x01, 0x00, 0x00, 0x00, /* mov $1,%eax */
+        0xe9, 0xf6, 0x00, 0x00, 0x00, /* jmp STOP_ADDRESS */
+    };
+    static const uint8_t writer_code[] =
+    {
+        0xfe, 0x04, 0x25, 0x01, 0x00, 0x01, 0x00,
+        /* incb CODE_ADDRESS+1 */
+    };
+    uc_engine *reader = NULL, *writer = NULL;
+    uc_hook stop_hook;
+    uint8_t *shared = NULL;
+    uint32_t eax;
+    uc_err err;
+    int ret = 1;
+
+    if (posix_memalign((void **)&shared, PAGE_SIZE, PAGE_SIZE))
+    {
+        fputs("cannot allocate shared page\n", stderr);
+        return 1;
+    }
+    memset(shared, 0, PAGE_SIZE);
+    memcpy(shared, initial_code, sizeof(initial_code));
+
+    if ((err = uc_open(UC_ARCH_X86, UC_MODE_64, &reader)) ||
+        (err = uc_open(UC_ARCH_X86, UC_MODE_64, &writer)) ||
+        (err = uc_configure_identity_memory_fastpath(
+             reader, identity_page_flags, ADDRESS_BITS)) ||
+        (err = uc_configure_identity_memory_fastpath(
+             writer, identity_page_flags, ADDRESS_BITS)) ||
+        (err = uc_enable_shared_memory_atomics(reader)) ||
+        (err = uc_enable_shared_memory_atomics(writer)) ||
+        (err = uc_mem_map_ptr(reader, CODE_ADDRESS, PAGE_SIZE,
+                              UC_PROT_ALL, shared)) ||
+        (err = uc_mem_map_ptr(writer, CODE_ADDRESS, PAGE_SIZE,
+                              UC_PROT_ALL, shared)) ||
+        (err = uc_hook_add(reader, &stop_hook, UC_HOOK_BLOCK, stop_block,
+                           NULL, STOP_ADDRESS, STOP_ADDRESS)) ||
+        (err = uc_mem_map(writer, WRITER_ADDRESS, PAGE_SIZE,
+                          UC_PROT_ALL)) ||
+        (err = uc_mem_write(writer, WRITER_ADDRESS, writer_code,
+                            sizeof(writer_code))))
+    {
+        fail(err, "setup");
+        goto done;
+    }
+
+    if (read_eax(reader, &eax)) goto done;
+    if (eax != 1)
+    {
+        fprintf(stderr, "initial translated result is %u, expected 1\n", eax);
+        goto done;
+    }
+
+    if ((err = uc_emu_start(writer, WRITER_ADDRESS,
+                            WRITER_ADDRESS + sizeof(writer_code), 0, 0)))
+    {
+        fail(err, "execute guest writer");
+        goto done;
+    }
+    if (shared[1] != 2)
+    {
+        fprintf(stderr, "guest writer stored %#x, expected 2\n", shared[1]);
+        goto done;
+    }
+
+    if (read_eax(reader, &eax)) goto done;
+    if (eax != 2)
+    {
+        fprintf(stderr, "stale translated result is %u, expected 2\n", eax);
+        goto done;
+    }
+
+    /* The first write made the writer's target-page TLB entry dirty.  The
+     * reader then translated the modified page.  A second writer store must
+     * still take the coherence path; otherwise its dirty TLB fast path leaves
+     * the reader's newly cached TB stale. */
+    if ((err = uc_emu_start(writer, WRITER_ADDRESS,
+                            WRITER_ADDRESS + sizeof(writer_code), 0, 0)))
+    {
+        fail(err, "execute repeated guest writer");
+        goto done;
+    }
+    if (shared[1] != 3)
+    {
+        fprintf(stderr, "repeated guest writer stored %#x, expected 3\n",
+                shared[1]);
+        goto done;
+    }
+
+    if (read_eax(reader, &eax)) goto done;
+    if (eax != 3)
+    {
+        fprintf(stderr, "stale post-dirty translated result is %u, expected 3\n",
+                eax);
+        goto done;
+    }
+
+    puts("shared executable backing stayed coherent");
+    ret = 0;
+
+done:
+    if (writer) uc_close(writer);
+    if (reader) uc_close(reader);
+    free(shared);
+    return ret;
+}
diff --git a/tests/regress/shared_code_jit_state.c b/tests/regress/shared_code_jit_state.c
new file mode 100644
index 0000000000000000000000000000000000000000..a546a067d5fbb8d58266fe33eafdbc63cd5bd3f8
--- /dev/null
+++ b/tests/regress/shared_code_jit_state.c
@@ -0,0 +1,130 @@
+/* Verify foreign-engine TB invalidation preserves the calling thread's
+ * Apple MAP_JIT mode while resetting a direct jump in the target engine. */
+
+#define _POSIX_C_SOURCE 200809L
+
+#include <pthread.h>
+#include <signal.h>
+#include <stdatomic.h>
+#include <stdint.h>
+#include <stdio.h>
+#include <stdlib.h>
+#include <string.h>
+#include <time.h>
+
+#include <unicorn/unicorn.h>
+
+#define CODE_ADDRESS   0x10000u
+#define WRITER_ADDRESS 0x20000u
+#define PAGE_SIZE      0x1000u
+#define WRITES         10000u
+#define ADDRESS_BITS   32u
+
+static uint8_t identity_page_flags[1u <<
+    (ADDRESS_BITS - UC_SWITCHYARD_IDENTITY_PAGE_SHIFT)];
+
+struct reader_state
+{
+    uc_engine *uc;
+    atomic_bool started;
+    uc_err result;
+};
+
+static void *run_reader(void *opaque)
+{
+    struct reader_state *state = opaque;
+
+    atomic_store_explicit(&state->started, true, memory_order_release);
+    state->result = uc_emu_start(state->uc, CODE_ADDRESS, UINT64_MAX, 0, 0);
+    return NULL;
+}
+
+int main(void)
+{
+    static const uint8_t writer_code[] =
+    {
+        0xfe, 0x04, 0x25, 0x01, 0x00, 0x01, 0x00, /* incb 0x10001 */
+    };
+    struct reader_state reader = {0};
+    struct timespec delay = {0, 10000000};
+    uc_engine *writer = NULL;
+    uint8_t *shared = NULL;
+    pthread_t thread;
+    uc_err err = UC_ERR_OK;
+    unsigned int i;
+    int ret = 1;
+
+    alarm(30);
+    if (posix_memalign((void **)&shared, PAGE_SIZE, PAGE_SIZE))
+    {
+        fputs("shared allocation failed\n", stderr);
+        return 2;
+    }
+    memset(shared, 0x90, PAGE_SIZE);
+    shared[0x00] = 0xb8; /* mov imm32,%eax */
+    shared[0x01] = 1;
+    shared[0x05] = 0xeb; /* jmp 0x10020 */
+    shared[0x06] = 0x19;
+    shared[0x20] = 0xeb; /* jmp 0x10000 */
+    shared[0x21] = 0xde;
+
+    if ((err = uc_open(UC_ARCH_X86, UC_MODE_64, &reader.uc)) ||
+        (err = uc_open(UC_ARCH_X86, UC_MODE_64, &writer)) ||
+        (err = uc_configure_identity_memory_fastpath(
+             reader.uc, identity_page_flags, ADDRESS_BITS)) ||
+        (err = uc_configure_identity_memory_fastpath(
+             writer, identity_page_flags, ADDRESS_BITS)) ||
+        (err = uc_enable_shared_memory_atomics(reader.uc)) ||
+        (err = uc_enable_shared_memory_atomics(writer)) ||
+        (err = uc_mem_map_ptr(reader.uc, CODE_ADDRESS, PAGE_SIZE,
+                              UC_PROT_ALL, shared)) ||
+        (err = uc_mem_map_ptr(writer, CODE_ADDRESS, PAGE_SIZE,
+                              UC_PROT_ALL, shared)) ||
+        (err = uc_mem_map(writer, WRITER_ADDRESS, PAGE_SIZE, UC_PROT_ALL)) ||
+        (err = uc_mem_write(writer, WRITER_ADDRESS, writer_code,
+                            sizeof(writer_code))) ||
+        (err = uc_emu_start(reader.uc, CODE_ADDRESS, UINT64_MAX, 0, 100)))
+    {
+        fprintf(stderr, "setup failed: %s\n", uc_strerror(err));
+        goto done;
+    }
+
+    if (pthread_create(&thread, NULL, run_reader, &reader))
+    {
+        fputs("reader thread creation failed\n", stderr);
+        goto done;
+    }
+    while (!atomic_load_explicit(&reader.started, memory_order_acquire)) {}
+    nanosleep(&delay, NULL);
+
+    for (i = 0; i < WRITES; ++i)
+    {
+        err = uc_emu_start(writer, WRITER_ADDRESS,
+                           WRITER_ADDRESS + sizeof(writer_code), 0, 0);
+        if (err != UC_ERR_OK)
+        {
+            fprintf(stderr, "writer failed at %u: %d (%s)\n", i, (int)err,
+                    uc_strerror(err));
+            break;
+        }
+    }
+
+    uc_emu_stop(reader.uc);
+    pthread_join(thread, NULL);
+    if (err != UC_ERR_OK || reader.result != UC_ERR_OK)
+    {
+        fprintf(stderr, "reader result: %d (%s)\n", (int)reader.result,
+                uc_strerror(reader.result));
+        goto done;
+    }
+
+    printf("shared-code JIT state passed %u writes\n", i);
+    ret = 0;
+
+done:
+    if (writer) uc_close(writer);
+    if (reader.uc) uc_close(reader.uc);
+    free(shared);
+    alarm(0);
+    return ret;
+}
diff --git a/tests/regress/shared_code_private_write.c b/tests/regress/shared_code_private_write.c
new file mode 100644
index 0000000000000000000000000000000000000000..710f10d983e3aa0889e5993cc5f49e6e0c5dddce
--- /dev/null
+++ b/tests/regress/shared_code_private_write.c
@@ -0,0 +1,150 @@
+/* Verify that a locally executable page avoids cross-engine exclusion only
+ * until a second participating engine maps the same guest page. */
+
+#include <stdint.h>
+#include <stdio.h>
+#include <stdlib.h>
+#include <string.h>
+
+#include <unicorn/unicorn.h>
+#include <unicorn/x86.h>
+
+#define CODE_ADDRESS   0x10000u
+#define DATA_ADDRESS   (CODE_ADDRESS + 0x800u)
+#define WRITER_ADDRESS 0x20000u
+#define PAGE_SIZE      0x1000u
+#define ADDRESS_BITS   32u
+
+static uint8_t identity_page_flags[1u <<
+    (ADDRESS_BITS - UC_SWITCHYARD_IDENTITY_PAGE_SHIFT)];
+
+static int fail(uc_err err, const char *operation)
+{
+    fprintf(stderr, "%s failed: %s\n", operation, uc_strerror(err));
+    return 1;
+}
+
+static int read_eax(uc_engine *uc, uint32_t *value)
+{
+    uc_err err;
+
+    if ((err = uc_reg_read(uc, UC_X86_REG_EAX, value)))
+        return fail(err, "read eax");
+    return 0;
+}
+
+int main(void)
+{
+    static const uint8_t target_code[] =
+    {
+        0xb8, 0x01, 0x00, 0x00, 0x00, /* mov $1,%eax */
+    };
+    static const uint8_t writer_code[] =
+    {
+        0xfe, 0x04, 0x25, 0x01, 0x00, 0x01, 0x00,
+        /* incb CODE_ADDRESS+1, changing the target's immediate */
+        0x48, 0xb8, 0x01, 0x08, 0x01, 0x00, 0x00, 0x00, 0x00, 0x00,
+        /* movabs $(DATA_ADDRESS + 1),%rax */
+        0x48, 0xba, 0x88, 0x77, 0x66, 0x55, 0x44, 0x33, 0x22, 0x11,
+        /* movabs $0x1122334455667788,%rdx */
+        0x48, 0x89, 0x10, /* mov %rdx,(%rax), deliberately unaligned */
+    };
+    uc_engine *writer = NULL, *reader = NULL;
+    uint8_t *shared = NULL;
+    uint64_t unaligned_value;
+    uint32_t eax = 0;
+    uint8_t owner;
+    uc_err err;
+    int ret = 1;
+
+    if (posix_memalign((void **)&shared, PAGE_SIZE, PAGE_SIZE))
+    {
+        fputs("cannot allocate shared page\n", stderr);
+        return 1;
+    }
+    memset(shared, 0, PAGE_SIZE);
+    memcpy(shared, target_code, sizeof(target_code));
+
+    if ((err = uc_open(UC_ARCH_X86, UC_MODE_64, &writer)) ||
+        (err = uc_configure_identity_memory_fastpath(
+             writer, identity_page_flags, ADDRESS_BITS)) ||
+        (err = uc_enable_shared_memory_atomics(writer)) ||
+        (err = uc_mem_map_ptr(writer, CODE_ADDRESS, PAGE_SIZE,
+                              UC_PROT_ALL, shared)) ||
+        (err = uc_mem_map(writer, WRITER_ADDRESS, PAGE_SIZE,
+                          UC_PROT_READ | UC_PROT_WRITE)) ||
+        (err = uc_mem_write(writer, WRITER_ADDRESS, writer_code,
+                            sizeof(writer_code))) ||
+        (err = uc_mem_protect(writer, WRITER_ADDRESS, PAGE_SIZE,
+                              UC_PROT_READ | UC_PROT_EXEC)) ||
+        (err = uc_emu_start(writer, WRITER_ADDRESS,
+                            WRITER_ADDRESS + sizeof(writer_code), 0, 0)))
+    {
+        fail(err, "private writer setup or execution");
+        goto done;
+    }
+    memcpy(&unaligned_value, shared + 0x801, sizeof(unaligned_value));
+    owner = identity_page_flags[CODE_ADDRESS >>
+        UC_SWITCHYARD_IDENTITY_PAGE_SHIFT] &
+        UC_SWITCHYARD_IDENTITY_PAGE_OWNER_MASK;
+    if (shared[1] != 2 || unaligned_value != UINT64_C(0x1122334455667788) ||
+        !owner ||
+        owner == UC_SWITCHYARD_IDENTITY_PAGE_OWNER_SHARED)
+    {
+        fprintf(stderr,
+                "private write mismatch: immediate=%u owner=%#x "
+                "unaligned=%#llx\n", shared[1], owner,
+                (unsigned long long)unaligned_value);
+        goto done;
+    }
+
+    if ((err = uc_open(UC_ARCH_X86, UC_MODE_64, &reader)) ||
+        (err = uc_configure_identity_memory_fastpath(
+             reader, identity_page_flags, ADDRESS_BITS)) ||
+        (err = uc_enable_shared_memory_atomics(reader)) ||
+        (err = uc_mem_map_ptr(reader, CODE_ADDRESS, PAGE_SIZE,
+                              UC_PROT_ALL, shared)) ||
+        (err = uc_emu_start(reader, CODE_ADDRESS,
+                            CODE_ADDRESS + sizeof(target_code), 0, 0)))
+    {
+        fail(err, "shared mapping or first execution");
+        goto done;
+    }
+    if (read_eax(reader, &eax) || eax != 2)
+    {
+        fprintf(stderr, "first shared execution returned eax=%u\n", eax);
+        goto done;
+    }
+    if ((err = uc_emu_start(writer, WRITER_ADDRESS,
+                            WRITER_ADDRESS + sizeof(writer_code), 0, 0)) ||
+        (err = uc_emu_start(reader, CODE_ADDRESS,
+                            CODE_ADDRESS + sizeof(target_code), 0, 0)))
+    {
+        fail(err, "shared mapping or execution");
+        goto done;
+    }
+    if (read_eax(reader, &eax)) goto done;
+    memcpy(&unaligned_value, shared + 0x801, sizeof(unaligned_value));
+    owner = identity_page_flags[CODE_ADDRESS >>
+        UC_SWITCHYARD_IDENTITY_PAGE_SHIFT] &
+        UC_SWITCHYARD_IDENTITY_PAGE_OWNER_MASK;
+    if (shared[1] != 3 || eax != 3 ||
+        unaligned_value != UINT64_C(0x1122334455667788) ||
+        owner != UC_SWITCHYARD_IDENTITY_PAGE_OWNER_SHARED)
+    {
+        fprintf(stderr,
+                "shared fallback mismatch: immediate=%u eax=%u owner=%#x "
+                "unaligned=%#llx\n", shared[1], eax, owner,
+                (unsigned long long)unaligned_value);
+        goto done;
+    }
+
+    puts("private executable write selected exact shared fallback");
+    ret = 0;
+
+done:
+    if (reader) uc_close(reader);
+    if (writer) uc_close(writer);
+    free(shared);
+    return ret;
+}
