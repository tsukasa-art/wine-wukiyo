+/* Emit a fail-closed eligibility check for one ordinary data access.  The
+ * caller publishes one byte per 4 KiB guest page.  A high or cross-page
+ * address, a missing permission, or a table miss branches to the unchanged
+ * software-MMU path.  X0 is scratch; the guest address register is preserved. */
+static unsigned int tcg_out_identity_fastpath_guard(
+    TCGContext *s, TCGReg addr_reg, MemOp memop, bool is_read,
+    tcg_insn_unit **branches, bool *test_branches)
+{
+    const unsigned int size_bits = memop & MO_SIZE;
+    const unsigned int size = 1u << size_bits;
+    const unsigned int permission = is_read ?
+        UC_SWITCHYARD_IDENTITY_PAGE_READ :
+        UC_SWITCHYARD_IDENTITY_PAGE_WRITE;
+    unsigned int count = 0;
+
+    tcg_debug_assert(s->uc->identity_memory_page_flags != NULL);
+    tcg_debug_assert(s->uc->identity_memory_address_bits >
+                     UC_SWITCHYARD_IDENTITY_PAGE_SHIFT);
+    tcg_debug_assert(TARGET_PAGE_BITS ==
+                     UC_SWITCHYARD_IDENTITY_PAGE_SHIFT);
+
+    /* The table covers [0, 2^address_bits). */
+    tcg_out_shr(s, TCG_TYPE_I64, TCG_REG_X0, addr_reg,
+                s->uc->identity_memory_address_bits);
+    branches[count++] = s->code_ptr;
+    test_branches[count - 1] = false;
+    tcg_out_insn(s, 3201, CBNZ, TCG_TYPE_I64, TCG_REG_X0, 0);
+
+    if (size > 1) {
+        /* These generated qemu accesses are at most one page wide.  Crossing
+         * the 4 KiB permission boundary toggles bit 12 of addr^(addr+size-1). */
+        tcg_out_insn(s, 3401, ADDI, TCG_TYPE_I64, TCG_REG_X0,
+                     addr_reg, size - 1);
+        tcg_out_insn(s, 3510, EOR, TCG_TYPE_I64, TCG_REG_X0,
+                     TCG_REG_X0, addr_reg);
+        branches[count++] = s->code_ptr;
+        test_branches[count - 1] = true;
+        tcg_out_insn(s, 3203, TBNZ, TCG_REG_X0,
+                     UC_SWITCHYARD_IDENTITY_PAGE_SHIFT, 0);
+    }
+
+    tcg_out_shr(s, TCG_TYPE_I64, TCG_REG_X0, addr_reg,
+                UC_SWITCHYARD_IDENTITY_PAGE_SHIFT);
+    tcg_out_ldst_r(s, I3312_LDRB, TCG_REG_X0,
+                   TCG_REG_IDENTITY_FASTMAP, TCG_TYPE_I64, TCG_REG_X0);
+    branches[count++] = s->code_ptr;
+    test_branches[count - 1] = true;
+    tcg_out_insn(s, 3203, TBZ, TCG_REG_X0,
+                 permission == UC_SWITCHYARD_IDENTITY_PAGE_READ ? 0 : 1, 0);
+    return count;
+}
